     to 100% only once we actually know the result. */
  const TP_CHECKPOINTS = [
    { pct: 0,   label: 'Searching',           tick: 'tpT0' },
    { pct: 25,  label: 'Locating record',     tick: 'tpT1' },
    { pct: 55,  label: 'Verifying shipment',  tick: 'tpT2' },
    { pct: 80,  label: 'Preparing results',   tick: 'tpT3' },
    { pct: 100, label: 'Shipment located',    tick: 'tpT4' },
  ];

  function openTrackPreloader(trackingId) {
    const el = document.getElementById('trackPreloader');
    el.classList.remove('tp-fade-out');
    el.classList.add('open');
    document.getElementById('tpId').textContent = trackingId.toUpperCase();
    document.getElementById('tpWaybill').textContent = trackingId.toUpperCase();
    document.body.style.overflow = 'hidden';
    setTrackPreloaderProgress(0);
  }

  function closeTrackPreloader() {
    const el = document.getElementById('trackPreloader');
    el.classList.add('tp-fade-out');
    setTimeout(() => {
      el.classList.remove('open', 'tp-fade-out');
      document.body.style.overflow = '';
    }, 500);
  }

  // Safety net: if the browser restores this page from back/forward cache
  // (e.g. the customer taps the device back button from the results page),
  // make sure the homepage never reappears with the preloader stuck open.
  window.addEventListener('pageshow', function (e) {
    if (e.persisted) {
      const el = document.getElementById('trackPreloader');
      el.classList.remove('open', 'tp-fade-out');
      document.body.style.overflow = '';
    }
  });

  function setTrackPreloaderProgress(pct) {
    pct = Math.max(0, Math.min(100, pct));
    const counter = document.getElementById('tpCounter');
    counter.childNodes[0].nodeValue = Math.floor(pct);
    document.getElementById('tpBarFill').style.inset = '0 ' + (100 - pct) + '% 0 0';
    const van = document.getElementById('tpVan');
    if (van) van.style.offsetDistance = pct + '%';
    const routePath = document.getElementById('tpRoutePath');
    if (routePath) routePath.style.strokeDashoffset = String(620 - (620 * pct / 100));
    let current = TP_CHECKPOINTS[0];
    TP_CHECKPOINTS.forEach(c => { if (pct >= c.pct) current = c; });
    const statusEl = document.getElementById('tpStatus');
    statusEl.childNodes[0].nodeValue = current.label;
    TP_CHECKPOINTS.forEach(c => {
      document.getElementById(c.tick).classList.toggle('hit', pct >= c.pct);
    });
  }

  // Animates the visible progress from wherever it is now up to `cap`
  // over `duration` ms, and resolves once that ramp finishes.
  function animatePreloaderTo(cap, duration) {
    return new Promise(resolve => {
      const counter = document.getElementById('tpCounter');
      const startPct = parseFloat(counter.childNodes[0].nodeValue) || 0;
      const start = performance.now();
      function frame(now) {
        const elapsed = now - start;
        const t = Math.min(1, elapsed / duration);
        setTrackPreloaderProgress(startPct + (cap - startPct) * t);
        if (t < 1) requestAnimationFrame(frame);
        else resolve();
      }
      requestAnimationFrame(frame);
    });
  }

  /* Generalized so the three tracker widgets on the page (hero card,
     waybill card, ledger card) can all drive the same live JSONBin
     lookup. On a match, the preloader plays out and the customer is
     handed off to the dedicated results page (tracking.html),
     which is the only place the shipment details are shown. */
  async function trackShipmentFrom(inputId, errorId, btnId, btnLblId) {
    const idRaw   = document.getElementById(inputId).value.trim();
    const err     = document.getElementById(errorId);
    const btn     = document.getElementById(btnId);
    const btnLbl  = document.getElementById(btnLblId);

    if (idRaw.length < 4) {
      err.textContent = 'Enter a valid tracking number to continue.';
      err.style.display = 'flex';
      return;
    }

    const defaultLabel = btnLbl.dataset.defaultLabel || (btnLbl.dataset.defaultLabel = btnLbl.textContent);
    btn.disabled = true;
    btnLbl.textContent = 'Searching…';
    err.style.display = 'none';
    openTrackPreloader(idRaw);

    try {
      // Total preload experience is timed to ~10 seconds: 9.2s ramp +
      // 0.5s finishing animation + 0.3s hold before handing off.
      const rampPromise = animatePreloaderTo(92, 9200);
      const shipments = await fetchShipments();
      const matchKey = Object.keys(shipments).find(k => k.toLowerCase() === idRaw.toLowerCase());
      const s = matchKey ? shipments[matchKey] : null;
      await rampPromise; // let the full 10-second ramp finish so the handoff never feels abrupt

      if (!s) {
        closeTrackPreloader();
        err.textContent = 'No shipment found for that tracking number. Please check and try again.';
        err.style.display = 'flex';
        return;
      }

      await animatePreloaderTo(100, 500);
      // Hand the already-fetched shipment off via sessionStorage so the
      // results page can render instantly without a second network round-trip.
      sessionStorage.setItem('veloz_tracked_shipment', JSON.stringify(s));
      setTimeout(() => {
        openTrackingPage(s.id, s);
      }, 300);
    } catch (e) {
      closeTrackPreloader();
      if (e && e.kind === 'auth') {
        // This is a config problem (bad/expired access key), not a "no such shipment" problem —
        // surface it distinctly so it doesn't get mistaken for a real "not found".
        err.textContent = 'Tracking service is temporarily unavailable (connection not authorized). Please contact support.';
        console.error('[Tracking] Access key rejected by JSONBin — verify JSONBIN_ACCESS_KEY on the front end still matches an active Access Key scoped to bin ' + JSONBIN_BIN_ID + '.');
      } else {
        err.textContent = 'Could not reach the tracking service right now. Please try again shortly.';
      }
      err.style.display = 'flex';
    } finally {
      btn.disabled = false;
      btnLbl.textContent = defaultLabel;
    }
  }

  // Back-compat: the original hero tracker was wired to trackShipment()
  // directly (auto-track-from-URL, Enter key). Keep that name working.
  function trackShipment() {
    return trackShipmentFrom('trackingInput', 'trackError', 'btnTrack', 'btnTrackLabel');
