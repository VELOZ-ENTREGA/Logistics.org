<script>
(function () {
  /* ── Letter-by-letter animated line ── */
  const LINE_TEXT = [
    { text: 'Your World,', gold: false },
    { text: ' Delivered.', gold: true  }
  ];

  const lineEl = document.getElementById('splashLine');
  let charDelay = 2000; // ms — starts after brand text appears

  LINE_TEXT.forEach(function (chunk) {
    chunk.text.split('').forEach(function (ch) {
      if (ch === ' ') {
        const sp = document.createElement('span');
        sp.className = 'sal-space';
        lineEl.appendChild(sp);
        charDelay += 60;
      } else {
        const s = document.createElement('span');
        s.className = 'sal-letter' + (chunk.gold ? ' gold' : '');
        s.textContent = ch;
        s.style.animationDelay = charDelay + 'ms';
        lineEl.appendChild(s);
        charDelay += 65;
      }
    });
  });

  /* ── Animated dots ── */
  const dotsEl = document.getElementById('splashDots');
  let dotCount = 0;
  const dotTimer = setInterval(function () {
    dotCount = (dotCount + 1) % 4;
    dotsEl.textContent = '.'.repeat(dotCount);
  }, 400);

  /* ── Dismiss the splash ── */
  // Total time: spinner shows ~1s, text animates in, progress bar runs ~2.4s
  // We dismiss at 4200ms to let everything finish gracefully
  const SPLASH_DURATION = 4200;

  function dismissSplash() {
    clearInterval(dotTimer);
    const splash = document.getElementById('gd-splash');
    splash.classList.add('hidden');
    document.body.classList.remove('splash-active');
    // Remove from DOM after transition ends to free memory
    splash.addEventListener('transitionend', function () {
      splash.remove();
    }, { once: true });
  }

  // Auto-dismiss after duration
  setTimeout(dismissSplash, SPLASH_DURATION);

  // Also allow clicking the splash to skip it (after 1.5s)
  setTimeout(function () {
    const splash = document.getElementById('gd-splash');
    if (splash) {
      splash.style.cursor = 'pointer';
      splash.setAttribute('title', 'Click to skip');
      splash.addEventListener('click', dismissSplash, { once: true });
    }
  }, 1500);
})();
</script>

