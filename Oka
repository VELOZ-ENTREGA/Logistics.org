    if (!r.ok) {
      // The request reached JSONBin but was rejected — almost always a key/permissions problem
      const bodyText = await r.text().catch(() => '');
      console.error('[Tracking] JSONBin rejected the request. HTTP ' + r.status + '. Body:', bodyText);
      const e = new Error('http-' + r.status);
      e.kind = (r.status === 401 || r.status === 403) ? 'auth' : (r.status === 404 ? 'notfound' : 'server');
      e.status = r.status;
      throw e;
    }
    const d = await r.json();
    const record = (d.record || {});
    const combined = { ...(record.shipments || {}) };
    Object.values(record.adminShipments || {}).forEach(bucket => Object.assign(combined, bucket || {}));
    return combined;
  }

  /* ── LIVE DASHBOARD STATS (real counts pulled from the bin) ── */
  function animateCount(el, target) {
    if (!el) return;
    const start = parseInt(el.dataset.raw || '0', 10) || 0;
    const dur = 800;
    const t0 = performance.now();
    function step(t) {
      const p = Math.min(1, (t - t0) / dur);
      const val = Math.round(start + (target - start) * p);
      el.textContent = val.toLocaleString();
      if (p < 1) requestAnimationFrame(step);
      else el.dataset.raw = String(target);
    }
    requestAnimationFrame(step);
  }

  async function updateLiveDashboard() {
    try {
      const shipments = await fetchShipments();
      const all = Object.values(shipments);
      const delivered = all.filter(s => s.status === 'Delivered').length;
      const inTransit = all.filter(s => {
        const i = STAGES.indexOf(s.status);
        return i > 0 && i < STAGES.length - 1;
      }).length;
      const active = all.length - delivered;

      animateCount(document.getElementById('dashActive'), active);
      animateCount(document.getElementById('dashTransit'), inTransit);
      animateCount(document.getElementById('dashDelivered'), delivered);
      // Fleet size isn't tracked in shipment data, so it's left as-is.
    } catch (e) {
      // Keep whatever was last shown if the fetch fails; fail silently on the public page,
      // but still log so the real cause (e.g. auth) is visible in devtools.
      console.error('[Dashboard] Failed to refresh live stats:', e);
