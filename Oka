.tl-item.done .tl-check{background:var(--sky-accent);border-color:var(--sky-accent);color:#fff;}
.tl-item.current .tl-check{background:#fff;border-color:#fff;color:var(--ink-dark);box-shadow:0 0 0 4px rgba(14,165,233,0.25);}
.tl-body{flex:1;}
.tl-label{font-family:'JetBrains Mono',monospace;font-size:0.86rem;color:rgba(255,255,255,0.4);font-weight:500;}
.tl-item.done .tl-label{color:#fff;}
.tl-item.current .tl-label{color:var(--sky-accent);font-weight:600;}
.tl-time{font-size:0.72rem;color:rgba(255,255,255,0.35);margin-top:2px;font-family:'JetBrains Mono',monospace;}
.tl-note{font-size:0.76rem;color:rgba(255,255,255,0.5);margin-top:3px;}

/* ===== CUSTOMERS ===== */
.cust-list{display:flex;flex-direction:column;gap:10px;}
.cust-card{border:1px solid var(--border);border-radius:10px;padding:16px 18px;display:flex;justify-content:space-between;
  align-items:center;gap:14px;flex-wrap:wrap;cursor:pointer;transition:border-color .15s,background .15s;}
.cust-card:hover{border-color:var(--sky-accent);background:var(--sky-light);}
.cust-card .avatar{width:42px;height:42px;border-radius:50%;background:var(--ink);color:#fff;display:flex;
