<script>
(function() {
  var slides = document.querySelectorAll('.goods-carousel .goods-card');
  var dots = document.querySelectorAll('.goods-dot');
  var counter = document.getElementById('goods-current');
  var prevBtn = document.getElementById('goods-prev');
  var nextBtn = document.getElementById('goods-next');
  var current = 0;
  var total = slides.length;
  var autoplayId;

  function show(index) {
    slides[current].classList.remove('is-active');
    dots[current].classList.remove('is-active');
    current = (index + total) % total;
    slides[current].classList.add('is-active');
    dots[current].classList.add('is-active');
    if (counter) counter.textContent = current + 1;
  }

  function next() { show(current + 1); }
  function prev() { show(current - 1); }

  function startAutoplay() { autoplayId = setInterval(next, 10000); }
  function stopAutoplay() { clearInterval(autoplayId); }

  if (nextBtn) nextBtn.addEventListener('click', function() { next(); stopAutoplay(); startAutoplay(); });
  if (prevBtn) prevBtn.addEventListener('click', function() { prev(); stopAutoplay(); startAutoplay(); });
  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      show(parseInt(dot.getAttribute('data-index'), 10));
      stopAutoplay(); startAutoplay();
    });
  });

  startAutoplay();
})();
</script>

