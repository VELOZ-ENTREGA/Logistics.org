.cust-info{flex:1;min-width:160px;}
.cust-info .name{font-weight:600;color:var(--ink-dark);font-size:0.95rem;}
.cust-info .meta{font-size:0.8rem;color:var(--slate);margin-top:2px;}
.cust-stats{display:flex;gap:18px;font-size:0.82rem;color:var(--slate);}
.cust-stats b{color:var(--ink-dark);font-family:'Space Grotesk',sans-serif;font-size:1rem;display:block;}

/* ===== REPORTS ===== */
.bar-row{display:flex;align-items:center;gap:12px;padding:9px 0;}
.bar-row .lbl{width:160px;flex-shrink:0;font-size:0.85rem;color:var(--ink-dark);font-weight:500;}
.bar-track{flex:1;height:10px;border-radius:99px;background:var(--sky-light);overflow:hidden;}
.bar-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--ink),var(--sky-accent));}
.bar-row .num{width:34px;text-align:right;font-weight:700;font-size:0.85rem;color:var(--ink-dark);flex-shrink:0;}
.report-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;}
