/* ── ANIMATED VEHICLE MARKER ─────────────────────────── */
.rmp-vehicle-wrap {
  position: relative;
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rmp-vehicle-ring {
  position: absolute;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 2px solid var(--green);
  animation: rmpPulse 1.7s ease-out infinite;
}
.rmp-vehicle {
  position: relative;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--navy2), var(--navy));
  border: 2.5px solid var(--white);
  box-shadow: 0 3px 10px rgba(0,0,0,0.45), 0 0 0 3px rgba(31,110,140,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.15rem;
  line-height: 1;
  z-index: 2;
}
.rmp-vehicle.air { background: linear-gradient(145deg, #1a4a7a, #0B1420); }
.rmp-vehicle.ocean { background: linear-gradient(145deg, #0d4a5c, #0B1420); }
.rmp-vehicle.rail { background: linear-gradient(145deg, #3d2a14, #0B1420); }
.rmp-vehicle.road { background: linear-gradient(145deg, #1F6E8C, #0B1420); }
.rmp-vehicle-wake {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--gold);
  opacity: 0.55;
  animation: wakePulse 1.2s ease-out infinite;
  z-index: 1;
}
@keyframes wakePulse {
  0% { transform: scale(0.4); opacity: 0.7; }
  100% { transform: scale(2.2); opacity: 0; }
}



/* ===== ADMIN PAGE STYLES ===== */

:root{
  --ink-dark:#0A1F44;
  --ink-mid:#14335F;
  --ink:#14335F;
  --sky-accent:#D4AF37;
  --sky-light:#F5EEDA;
  --white:#FFFFFF;
  --off-white:#FBF8F0;
  --slate:#5C5C5C;
  --text:#1A1A1A;
  --border:#E0D5B0;
  --red:#8A2E2E;
  --green:#1AA37A;
  --sidebar-w:240px;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Inter',sans-serif;background:var(--off-white);color:var(--text);line-height:1.5;}
h1,h2,h3,h4{font-family:'Space Grotesk',sans-serif;}
.mono{font-family:'JetBrains Mono',monospace;}
a{color:inherit;}

/* ===== LOGIN ===== */
.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:linear-gradient(160deg,var(--ink-dark) 0%,var(--ink-mid) 55%,#0B3060 100%);padding:24px;}
.login-card{background:#fff;border-radius:14px;padding:40px;max-width:420px;width:100%;
  box-shadow:0 20px 60px rgba(0,0,0,0.35);}
.login-card .mark{width:52px;height:52px;border-radius:12px;
  background:linear-gradient(135deg,var(--sky-accent),var(--ink));
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-weight:700;font-size:1.1rem;margin-bottom:18px;
  font-family:'Space Grotesk',sans-serif;letter-spacing:-0.03em;}
.login-card h1{font-size:1.5rem;margin-bottom:4px;color:var(--ink-dark);}
.login-card .sub{color:var(--slate);font-size:0.88rem;margin-bottom:28px;}
.field{margin-bottom:18px;}
.field label{display:block;font-size:0.78rem;text-transform:uppercase;letter-spacing:0.1em;
  color:var(--slate);font-weight:600;margin-bottom:8px;}
.field input{width:100%;padding:13px 14px;border-radius:8px;border:1.5px solid var(--border);
  font-size:0.95rem;background:#fff;color:var(--text);}
.field input:focus{outline:none;border-color:var(--sky-accent);box-shadow:0 0 0 3px rgba(14,165,233,0.14);}
.btn{border:none;border-radius:8px;padding:13px 22px;
  font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:0.95rem;cursor:pointer;transition:transform .15s,box-shadow .15s;}
.btn-primary{background:var(--ink);color:#fff;}
.btn-primary:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(26,63,114,0.4);background:var(--sky-accent);}
.btn-secondary{background:var(--ink-dark);color:#fff;}
.btn-secondary:hover{background:var(--ink-mid);}
.btn-danger{background:#fff;color:var(--red);border:1.5px solid #E8C7C7;}
.btn-danger:hover{background:#FCEDED;}
.btn-green{background:var(--sky-accent);color:#fff;}
.btn-green:hover{background:var(--ink);}
.btn-outline{background:#fff;color:var(--ink);border:1.5px solid var(--border);}
.btn-outline:hover{border-color:var(--sky-accent);color:var(--sky-accent);}
.login-error{margin-top:14px;font-size:0.85rem;color:var(--red);font-weight:500;display:none;}

/* ===== SHELL / SIDEBAR ===== */
.shell{display:none;min-height:100vh;}
.sidebar{position:fixed;top:0;left:0;bottom:0;width:var(--sidebar-w);
  background:linear-gradient(180deg,var(--ink-dark) 0%,#081830 100%);
  color:#fff;display:flex;flex-direction:column;z-index:50;
  border-right:1px solid rgba(255,255,255,0.08);}
.sidebar-brand{padding:22px 20px;display:flex;align-items:center;gap:11px;
  border-bottom:1px solid rgba(255,255,255,0.08);}
.sidebar-brand .mark{width:38px;height:38px;border-radius:9px;flex-shrink:0;
  background:linear-gradient(135deg,var(--sky-accent),var(--ink));
  display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.85rem;
  letter-spacing:-0.03em;border:2px solid rgba(255,255,255,0.25);}
.sidebar-brand .name{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:0.98rem;line-height:1.2;}
.sidebar-brand .tag{font-size:0.68rem;color:rgba(255,255,255,0.5);margin-top:2px;letter-spacing:0.03em;}
.nav-section-label{font-size:0.68rem;text-transform:uppercase;letter-spacing:0.12em;color:rgba(255,255,255,0.35);
  padding:18px 20px 8px;font-weight:600;}
.nav-item{display:flex;align-items:center;gap:12px;padding:12px 20px;font-size:0.9rem;font-weight:500;
  color:rgba(255,255,255,0.68);cursor:pointer;border-left:3px solid transparent;transition:all .15s;}
.nav-item .ic{font-size:1.05rem;width:20px;text-align:center;}
.nav-item:hover{background:rgba(255,255,255,0.05);color:#fff;}
.nav-item.active{background:rgba(14,165,233,0.14);color:#fff;border-left-color:var(--sky-accent);}
.sidebar-footer{margin-top:auto;padding:16px 20px;border-top:1px solid rgba(255,255,255,0.08);}
.sidebar-footer .who{font-size:0.78rem;color:rgba(255,255,255,0.55);margin-bottom:10px;}
.sidebar-footer .who strong{color:#fff;display:block;font-size:0.88rem;margin-top:2px;}
.sidebar-toggle{display:none;}

.content-wrap{margin-left:var(--sidebar-w);min-height:100vh;display:flex;flex-direction:column;}
.topbar{background:#fff;border-bottom:1px solid var(--border);padding:16px 28px;
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
.topbar h1{font-size:1.25rem;color:var(--ink-dark);}
.topbar .sub{font-size:0.82rem;color:var(--slate);margin-top:2px;}
.topbar-actions{display:flex;gap:10px;align-items:center;}
.menu-btn{display:none;background:var(--ink);color:#fff;border:none;border-radius:8px;width:38px;height:38px;font-size:1.1rem;cursor:pointer;}

main{flex:1;max-width:1300px;width:100%;margin:0 auto;padding:26px 24px 60px;}
.tab-content{display:none;}
.tab-content.active{display:block;}

.grid{display:grid;grid-template-columns:1.1fr 1.4fr;gap:24px;}
@media(max-width:980px){.grid{grid-template-columns:1fr;}}
.panel{background:#fff;border-radius:14px;padding:28px;border:1px solid var(--border);margin-bottom:24px;}
.panel h2{font-size:1.15rem;margin-bottom:4px;color:var(--ink-dark);}
.panel .sub{color:var(--slate);font-size:0.85rem;margin-bottom:22px;}
.section-title{font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;
