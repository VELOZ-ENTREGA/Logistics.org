/* ── PARTNER MARQUEE ────────────────────────────────── */
.partners-strip { background: var(--offwhite); padding: 36px 0; overflow: hidden; border-top: 1px solid var(--grey); border-bottom: 1px solid var(--grey); }
.partners-label { text-align: center; font-size: 0.75rem; color: var(--mid); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 18px; }
