<style>

#page-admin, #page-tracking, #page-public { min-height: 100vh; }
#page-admin .login-wrap { min-height: 100vh; }
#page-admin .shell { min-height: 100vh; }
body.mode-admin { padding-top: 0 !important; overflow: auto; }
body.mode-admin > #page-public,
body.mode-tracking > #page-public { display: none !important; }
body.mode-tracking { padding-top: 0 !important; }


/* ── TOKENS ── ATELIER PALETTE: ink + brass + parchment (petrol/customs-red status) ───── */
:root {
  --navy:    #0A1930;
  --navy2:   #123B6D;
  --gold:    #1E88E5;
  --gold2:   #4FA8FF;
  --silver:  #F2A65A;
  --silver2: #FFF4E8;
  --dark-yellow: #C86E28;
  --white:   #FFFFFF;
  --offwhite:#EBF2FA;
  --grey:    #E1EAF5;
  --mid:     #55627A;
  --dark:    #0A1930;
  --green:   #0C8599;
  --red:     #D64545;

  --font-head: 'Poppins', sans-serif;
  --font-body: 'Inter', sans-serif;
  --radius: 12px;
  --shadow: 0 4px 24px rgba(10,25,48,0.18);
  --shadow-lg: 0 20px 60px rgba(10,25,48,0.28);
}

/* ── RESET ──────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; overflow-x: hidden; max-width: 100%; }
section[id], .hero[id] { scroll-margin-top: 90px; }
body { font-family: var(--font-body); background: linear-gradient(180deg, #FFFFFF 0%, #FFFFFF 20%, #FFFFFF 42%, #FFF4E8 68%, #FFFFFF 100%); color: var(--dark); font-size: 16px; line-height: 1.6; letter-spacing: 0.01em; overflow-x: hidden; max-width: 100%; }
a { text-decoration: none; color: inherit; }
img { display: block; max-width: 100%; }

/* ── UTILITY ────────────────────────────────────────── */
.container { max-width: 1860px; margin: 0 auto; padding: 0 5%; }
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(30,136,229,0.08); color: var(--navy);
  font-weight: 600; font-size: 0.72rem; letter-spacing: 0.1em;
  text-transform: uppercase; padding: 5px 12px; border-radius: 2px;
  border: 1px solid rgba(30,136,229,0.3);
}
.badge::before {
  content: '●'; font-size: 0.5rem;
  animation: badgeGlow 1.8s ease-in-out infinite;
  color: var(--gold);
}
@keyframes badgeGlow {
  0pointer-eventsvents opacity: 1; text-shadow: 0 0 0 rgba(30,136,229,0); }
  50% { opacity: 0.4; text-shadow: 0 0 6px rgba(30,136,229,0.8); }
}

/* ── SEVEN-STAR ELITE MARK ─────────────────────────────── */
.seven-star-mark {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font-head); font-style: italic; font-weight: 700;
  font-size: 0.78rem; letter-spacing: 0.06em; color: var(--gold2);
  white-space: nowrap;
}
.seven-star-mark .ssm-stars {
  display: inline-flex; gap: 1px; font-size: 0.7rem; color: var(--gold);
  letter-spacing: -1px;
}
.seven-star-mark .ssm-stars i {
  animation: ssmTwinkle 2.4s ease-in-out infinite;
}
.seven-star-mark .ssm-stars i:nth-child(2) { animation-delay: 0.2s; color: var(--silver); }
.seven-star-mark .ssm-stars i:nth-child(3) { animation-delay: 0.4s; color: var(--dark-yellow); }
.seven-star-mark .ssm-stars i:nth-child(4) { animation-delay: 0.6s; }
.seven-star-mark .ssm-stars i:nth-child(5) { animation-delay: 0.8s; color: var(--silver); }
.seven-star-mark .ssm-stars i:nth-child(6) { animation-delay: 1.0s; color: var(--dark-yellow); }
.seven-star-mark .ssm-stars i:nth-child(7) { animation-delay: 1.2s; }
@keyframes ssmTwinkle {
  0%, 100% { opacity: 0.55; transform: scale(0.94); }
  50% { opacity: 1; transform: scale(1.08); text-shadow: 0 0 8px rgba(30,136,229,0.8); }
}

/* Reusable gold foil / brushed-metal sheen for premium panels */
.gold-foil-texture {
  position: relative;
  background-image:
    repeating-linear-gradient(115deg, rgba(255,255,255,0.05) 0px, rgba(255,255,255,0.05) 1px, transparent 1px, transparent 6px),
    radial-gradient(circle at 15% 20%, rgba(30,136,229,0.16), transparent 55%),
    radial-gradient(circle at 85% 80%, rgba(242,166,90,0.14), transparent 55%);
}
.gold-foil-texture::after {
  content: '';
  position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(120deg, transparent 28%, rgba(79,168,255,0.16) 42%, rgba(255,255,255,0.14) 50%, rgba(242,166,90,0.16) 58%, transparent 72%);
  background-size: 220% 220%;
  animation: foilSweep 7s ease-in-out infinite;
  mix-blend-mode: overlay;
}
@keyframes foilSweep {
  0% { background-position: -40% -40%; }
  50% { background-position: 140% 140%; }
  100% { background-position: -40% -40%; }
}

/* ── QUICK ACCESS CARD GRID (TSA.gov-style icon cards under the hero) ── */
.quick-access-section { padding: 56px 0 64px; background: var(--white); }
.qa-head { text-align: center; max-width: 640px; margin: 0 auto 34px; }
.qa-head .badge { margin-bottom: 14px; }
.qa-head h2 {
  font-family: var(--font-head); font-weight: 700; font-style: italic;
  font-size: clamp(1.5rem, 3vw, 2rem); color: var(--navy); letter-spacing: -0.01em;
}
.qa-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px;
  max-width: 1860px; margin: 0 auto; padding: 0 5%;
}
.qa-card {
  display: flex; flex-direction: column; gap: 12px;
  background: var(--offwhite); border: 1px solid rgba(30,136,229,0.22);
  border-radius: var(--radius); padding: 26px 22px 24px;
  cursor: pointer; transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}
.qa-card:hover, .qa-card:focus-visible {
  transform: translateY(-4px); box-shadow: var(--shadow);
  border-color: var(--gold);
}
.qa-icon {
  width: 46px; height: 46px; border-radius: 10px;
  background: linear-gradient(135deg, var(--navy), var(--navy2));
  display: flex; align-items: center; justify-content: center;
  color: var(--gold2); flex-shrink: 0;
}
.qa-card h3 {
  font-family: var(--font-head); font-weight: 700; font-size: 1.05rem;
  color: var(--navy); letter-spacing: -0.005em;
}
.qa-card p { font-size: 0.88rem; color: var(--mid); line-height: 1.55; }
.qa-card .qa-link {
  margin-top: auto; font-size: 0.8rem; font-weight: 600; color: var(--dark-yellow);
  display: inline-flex; align-items: center; gap: 4px;
}
.qa-card:hover .qa-link { color: var(--gold); }
@media (max-width: 980px) {
  .qa-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 560px) {
  .qa-grid { grid-template-columns: 1fr; }
}

/* ── TOPBAR ─────────────────────────────────────────── */
.topbar {
  background: rgba(10,25,48,0.62);
  backdrop-filter: blur(18px) saturate(160%);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  padding: 8px 5%;
  display: flex; justify-content: space-between; align-items: center;
  font-size: 0.78rem; color: rgba(255,255,255,0.55);
  border-bottom: 1px solid rgba(79,168,255,0.14);
}
.topbar a { color: rgba(255,255,255,0.55); transition: color 0.2s; }
.topbar a:hover { color: var(--gold); }
.topbar-links { display: flex; gap: 24px; }
.topbar-contact { display: flex; align-items: center; gap: 8px; white-space: nowrap; }
.topbar-contact .tb-phone { font-size: 0.86em; }
.topbar-contact .tb-sep { opacity: 0.4; }

/* ── HEADER ─────────────────────────────────────────── */
header {
  background: rgba(255,255,255,0.68);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  position: fixed; top: 0; left: 0; right: 0; width: 100%; z-index: 500;
  border-bottom: 1px solid rgba(30,136,229,0.35);
  box-shadow: 0 8px 32px rgba(10,25,48,0.10);
}
/* Reserve space at the top of the page for the now-fixed header so content
   doesn't get hidden underneath it. Height matches the tallest (mobile)
   rendering of .header-inner; adjust here if the logo size changes. */
body { padding-top: 84px; }
@media (max-width: 640px) {
  body { padding-top: 74px; }
}
.header-inner {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16px 5%; max-width: 1800px; margin: 0 auto;
  flex-wrap: nowrap; gap: 10px;
}
.logo {
  font-family: var(--font-head);
  font-size: 1.7rem; font-weight: 800;
  color: var(--navy); letter-spacing: -0.02em;
  display: flex; align-items: center; gap: clamp(6px, 1.6vw, 12px);
  flex-wrap: nowrap;
  /* Shrinks instead of forcing the page wider than the viewport, so the
     hamburger button always stays on the same line without overflow. */
  flex-shrink: 1; min-width: 0;
  margin-left: -14px;
}
.logo-badge {
  display: block;
  height: clamp(40px, 8.5vw, 66px);
  width: auto;
  max-width: 100%;
  flex-shrink: 0;
  object-fit: contain;
}
/* Icon is now self-contained (own dark badge + border), so dark
   sections only need consistent sizing, not a light plate behind it. */
.logo-badge-plate {
  display: inline-flex; align-items: center; flex-shrink: 0;
}
.logo-badge-plate .logo-badge { height: 40px; }

@keyframes logoBadgePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.035); }
}
.logo-badge { animation: logoBadgePulse 2.6s ease-in-out infinite; }
@media (prefers-reduced-motion: reduce) {
  .logo-badge { animation: none; }
}

/* ── VELOZ ENTREGA WORDMARK (real text, not an image — stays crisp at any size) ── */
.apex-wordmark {
  display: flex; flex-direction: column; justify-content: center;
  flex-shrink: 1; min-width: 0;
  position: relative;
}
.aw-top {
  display: flex; align-items: baseline; gap: clamp(6px, 1vw, 9px);
  flex-wrap: nowrap; min-width: 0;
}
.aw-apex, .aw-express {
  font-family: var(--font-head); font-style: italic;
  line-height: 1; white-space: nowrap;
  font-weight: 900;
  font-size: clamp(1.55rem, 4.3vw, 2.55rem);
}
.aw-apex {
  letter-spacing: 0.01em;
  color: var(--navy);
  text-shadow: 0 1px 0 rgba(255,255,255,0.35), 0 2px 6px rgba(10,25,48,0.18);
}
.aw-express {
  letter-spacing: 0.01em;
  color: var(--gold);
  align-self: flex-end;
  padding-bottom: 0.04em;
  text-shadow: 0 2px 6px rgba(30,136,229,0.2);
}
.apex-wordmark { }
.apex-wordmark::after {
  content: '';
  position: absolute; inset: -8px -12px 0 -12px;
  pointer-events: none;
  background: none;
}
.aw-logistics {
  display: flex; align-items: center; gap: 8px;
  font-family: var(--font-body); font-weight: 700; letter-spacing: 0.4em;
  font-size: clamp(0.56rem, 1.05vw, 0.7rem); line-height: 1;
  color: var(--navy); white-space: nowrap;
  margin-top: 5px; padding-left: 2px;
}
.aw-logistics::before {
  content: ''; display: block; width: 20px; height: 2px;
  background: linear-gradient(90deg, var(--gold), transparent);
  flex-shrink: 0;
}
/* Light variant for dark backgrounds (mobile drawer, footer) */
.apex-wordmark.on-dark .aw-apex {
  color: var(--gold2);
  text-shadow: 0 2px 8px rgba(0,0,0,0.35);
}
.apex-wordmark.on-dark .aw-express {
  color: var(--white);
}
.apex-wordmark.on-dark .aw-logistics { color: rgba(255,255,255,0.85); }
.apex-wordmark.on-dark .aw-logistics::before { background: linear-gradient(90deg, var(--gold2), transparent); }
.apex-wordmark.compact .aw-apex { font-size: 1.2rem; }
.apex-wordmark.compact .aw-express { font-size: 1.2rem; }
.apex-wordmark.compact .aw-logistics { font-size: 0.48rem; margin-top: 2px; }
.apex-wordmark.compact .aw-logistics::before { width: 14px; }

nav { display: flex; align-items: center; gap: 32px; }
nav a {
  font-size: 0.85rem; font-weight: 600; letter-spacing: 0.04em;
  text-transform: uppercase; color: var(--navy);
  padding-bottom: 2px; border-bottom: 2px solid transparent;
  transition: border-color 0.2s, color 0.2s;
}
nav a:hover { color: var(--gold); border-color: var(--gold); }
.btn-nav {
  background: var(--navy); color: var(--white) !important;
  padding: 10px 22px; border: none !important; border-radius: var(--radius);
  font-size: 0.8rem !important; font-weight: 700 !important;
  transition: background 0.2s !important;
}
.btn-nav:hover { background: var(--gold) !important; color: var(--navy) !important; }

/* ── MOBILE MENU ─────────────────────────────────────── */
.hamburger-btn {
  display: none; flex-direction: column; justify-content: center; gap: 5px;
  width: 36px; height: 36px; background: none; border: none; cursor: pointer;
  padding: 4px; flex-shrink: 0;
}
.hamburger-btn span { display: block; width: 100%; height: 2.5px; background: var(--navy); border-radius: 2px; }

.mobile-drawer-backdrop {
  position: fixed; inset: 0; background: rgba(0,0,0,0.55);
  opacity: 0; pointer-events: none; transition: opacity 0.25s ease; z-index: 998;
}
.mobile-drawer-backdrop.open { opacity: 1; pointer-events: auto; }

.mobile-drawer {
  position: fixed; top: 0; right: 0; height: 100%; width: 84%; max-width: 340px;
  background: rgba(10,25,48,0.72);
  backdrop-filter: blur(22px) saturate(160%);
  -webkit-backdrop-filter: blur(22px) saturate(160%);
  color: var(--white); z-index: 999;
  transform: translateX(100%); transition: transform 0.3s ease;
  display: flex; flex-direction: column; box-shadow: -10px 0 36px rgba(0,0,0,0.35);
  border-left: 1px solid rgba(79,168,255,0.14);
}
.mobile-drawer.open { transform: translateX(0); }
.mobile-drawer-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18px 18px; border-bottom: 1px solid rgba(255,255,255,0.1); flex-shrink: 0;
}
.mobile-drawer-close { background: none; border: none; color: var(--white); font-size: 1.3rem; cursor: pointer; line-height: 1; padding: 4px; }
.mobile-drawer nav { display: flex; flex-direction: column; padding: 6px 0; overflow-y: auto; flex: 1; }
.mobile-drawer nav a {
  padding: 13px 22px; font-size: 0.92rem; font-weight: 600; letter-spacing: 0.02em;
  color: rgba(255,255,255,0.85); border-bottom: 1px solid rgba(255,255,255,0.06);
  transition: color 0.2s, background 0.2s;
}
.mobile-drawer nav a:hover { color: var(--gold); background: rgba(255,255,255,0.04); }
.mobile-drawer .md-group-label {
  padding: 16px 22px 6px; font-size: 0.66rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.08em; color: rgba(255,255,255,0.4);
}
.mobile-drawer .md-cta {
  margin: 16px 20px; padding: 13px; background: var(--gold); color: var(--navy);
  text-align: center; border-radius: var(--radius); font-weight: 700;
  text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.04em; flex-shrink: 0;
}
.mobile-drawer .md-contact {
  padding: 16px 22px 20px; font-size: 0.78rem; line-height: 1.7;
  color: rgba(255,255,255,0.5); border-top: 1px solid rgba(255,255,255,0.1); flex-shrink: 0;
}
body.drawer-open { overflow: hidden; }

/* ── HERO ───────────────────────────────────────────── */
.hero {
  background: var(--navy);
  color: var(--white);
  padding: 0;
  overflow: hidden;
  position: relative;
}
.hero-grid {
  display: grid; grid-template-columns: 1fr;
  min-height: 600px;
}
.hero-left {
  padding: 0 5% 80px;
  display: flex; flex-direction: column; justify-content: flex-start;
  align-items: center;
  position: relative; z-index: 2;
}
.hero-left .badge { margin-bottom: 24px; }
.hero-left h1 {
  font-family: var(--font-head);
  font-size: clamp(2.4rem, 4vw, 4rem);
  font-weight: 800; line-height: 1.05;
  letter-spacing: -0.02em;
  margin-bottom: 20px;
}
.hero-left h1 span { color: var(--gold); display: block; }
.hero-left p {
  color: rgba(255,255,255,0.65);
  font-size: 1.05rem; max-width: 420px;
  margin-bottom: 28px;
  margin-top: 28px;
}

/* ── VEHICLE DELIVERY SLIDESHOW ─────────────────────── */
.vehicle-slideshow {
  position: relative;
  width: 100%; max-width: 100%;
  aspect-ratio: 3 / 4;
  height: auto;
  margin: 0 0 28px;
  border-radius: 0 0 12px 12px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  border: 1px solid rgba(255,255,255,0.12);
  border-top: none;
}
@media (min-width: 900px) {
  .vehicle-slideshow { aspect-ratio: auto; height: 620px; }
}
.vs-track {
  position: absolute; inset: 0;
}
.vs-slide {
  position: absolute; inset: 0;
  opacity: 0;
  animation: vsCycle 25s infinite;
}
.vs-slide-static {
  opacity: 1;
  animation: none;
}
.vs-slide-static .vs-photo {
  animation: none;
  transform: none;
}
.vs-slide:nth-child(1) { animation-delay: 0s; }
.vs-slide:nth-child(2) { animation-delay: 5s; }
.vs-slide:nth-child(3) { animation-delay: 10s; }
.vs-slide:nth-child(4) { animation-delay: 15s; }
.vs-slide:nth-child(5) { animation-delay: 20s; }

/* Hero cycling slideshow — 4 photos, 13 seconds each (52s total loop) */
.vs-hero-cycle .vs-slide {
  animation: heroSlideCycle 52s infinite;
}
.vs-hero-cycle .vs-photo {
  animation: vsZoomStatic 30s ease-in-out infinite alternate;
}
@keyframes vsZoomStatic {
  0% { transform: scale(1); }
  100% { transform: scale(1.02); }
}
@keyframes heroSlideCycle {
  0%   { opacity: 0; }
  3%   { opacity: 1; }
  21%  { opacity: 1; }
  25%  { opacity: 0; }
  100% { opacity: 0; }
}

@keyframes vsCycle {
  0%        { opacity: 0; }
  4%        { opacity: 1; }
  17%       { opacity: 1; }
  20%       { opacity: 0; }
  100%      { opacity: 0; }
}

.vs-photo {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center;
  background: #0A1930;
  animation: vsZoom 18.6s ease-in-out infinite;
  filter: saturate(1.12) contrast(1.06) brightness(1.16);
}
/* GD branded aircraft SVG slide */
.gd-aircraft-wrap {
  object-fit: unset;
  filter: none;
  background: #0A1930;
  display: flex; align-items: center; justify-content: center;
}
.gd-aircraft-svg {
  width: 100%; height: 100%;
  animation: vsZoom 18.6s ease-in-out infinite;
}
@keyframes vsZoom {
  0% { transform: scale(1); }
  100% { transform: scale(1.12); }
}
.vs-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(10,25,48,0.08) 0%, rgba(10,25,48,0.02) 20%, rgba(10,25,48,0) 45%, rgba(10,25,48,0.05) 65%, rgba(10,25,48,0.35) 100%);
}

/* ── HERO LIVE DATE — 3D scoreboard tiles (day / month / year) on the building pillar ── */
.hero-live-date {
  position: absolute;
  top: 0; left: 0;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.16em;
  pointer-events: none;
  transform: translate(-50%, -50%);
  white-space: nowrap;
}
.hld-tile {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 1.7em;
  padding: 0.08em 0.32em 0.12em;
  font-family: var(--font-head);
  font-weight: 800;
  line-height: 1;
  color: var(--gold2);
  border-radius: 0.16em;
  background: linear-gradient(155deg, #2a4a6b 0%, #123B6D 52%, #0A1930 100%);
  border: 1px solid rgba(79,168,255,0.55);
  text-shadow: 0 1px 2px rgba(0,0,0,0.85);
  box-shadow:
    inset 0 1.5px 0 rgba(255,255,255,0.4),
    inset 0 -4px 5px rgba(0,0,0,0.55),
    0 3px 0 rgba(5,9,15,0.95),
    0 7px 10px rgba(0,0,0,0.55);
  overflow: hidden;
}
.hld-tile::after {
  content: '';
  position: absolute;
  left: 0; right: 0; top: 50%;
  height: 1px;
  background: rgba(0,0,0,0.4);
  box-shadow: 0 1px 0 rgba(255,255,255,0.06);
}
.hero-live-date .hld-day {
  font-size: 1.85em;
  min-width: 1.9em;
}
.hero-live-date .hld-month {
  font-size: 1em;
  letter-spacing: 0.08em;
  color: var(--silver2);
}
.hero-live-date .hld-year {
  font-size: 1em;
  letter-spacing: 0.02em;
}
.vs-glass-tagline {
  position: absolute;
  top: 22px; left: 5%; right: 5%;
  z-index: 3;
  display: flex; align-items: center; justify-content: center;
  padding: 14px 20px;
  background: rgba(255,255,255,0.16);
  border: 1px solid rgba(255,255,255,0.35);
  border-radius: 14px;
  backdrop-filter: blur(16px) saturate(150%);
  -webkit-backdrop-filter: blur(16px) saturate(150%);
  box-shadow: 0 8px 32px rgba(0,0,0,0.18), inset 0 1px 0 rgba(255,255,255,0.3);
}
.vs-glass-tagline span {
  font-family: var(--font-head);
  font-weight: 800;
  letter-spacing: 0.08em;
  font-size: clamp(0.95rem, 3.2vw, 1.5rem);
  color: var(--white);
  text-shadow: 0 2px 10px rgba(0,0,0,0.35);
  text-align: center;
  white-space: nowrap;
}
@media (max-width: 480px) {
  .vs-glass-tagline span { white-space: normal; letter-spacing: 0.04em; }
}
.vs-hero-text {
  position: absolute; top: 54px; left: 20px; right: 20px;
  z-index: 3;
}
.vs-hero-text .badge { margin-bottom: 18px; }
.vs-hero-text h1 { font-size: clamp(1.9rem, 3.4vw, 3.1rem); text-shadow: 0 2px 16px rgba(0,0,0,0.5); }
.vs-info {
  position: absolute; left: 16px; right: 16px; bottom: 14px;
  display: flex; align-items: center; gap: 12px;
}
.vs-logo-chip {
  background: var(--gold); color: var(--navy);
  font-family: var(--font-head); font-weight: 800;
  font-size: 0.72rem; letter-spacing: 0.04em;
  padding: 5px 9px; border-radius: 5px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.35);
  border: 1.5px solid rgba(255,255,255,0.6);
  white-space: nowrap; flex-shrink: 0;
}
.vs-text { min-width: 0; }
.vs-name {
  display: block;
  font-family: var(--font-head); font-weight: 700;
  font-size: 0.95rem; letter-spacing: 0.02em;
  color: var(--white);
}
.vs-cargo {
  display: block;
  font-size: 0.74rem; color: rgba(255,255,255,0.65);
}
.vs-label-row {
  position: absolute; top: 20px; right: 20px;
  display: flex; align-items: center; gap: 6px;
  font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em;
  text-transform: uppercase; color: rgba(255,255,255,0.85);
  z-index: 3;
  background: rgba(12,133,153,0.18);
  padding: 6px 12px; border-radius: 20px;
  border: 1px solid rgba(255,255,255,0.18);
  backdrop-filter: blur(10px) saturate(140%);
  -webkit-backdrop-filter: blur(10px) saturate(140%);
  box-shadow: 0 4px 14px rgba(0,0,0,0.25), inset 0 1px 0 rgba(255,255,255,0.15);
}
.vs-label-row .live-tag {
  display: inline-flex; align-items: center; gap: 4px;
  color: var(--green); font-weight: 700;
}
.vs-label-row .live-tag::before {
  content: ''; width: 5px; height: 5px; border-radius: 50%;
  background: var(--green); animation: pulse 1.5s infinite;
}
.vs-progress {
  position: absolute; bottom: 0; left: 0; height: 3px;
  background: var(--gold);
  width: 100%;
  animation: vsProgress 25s linear infinite;
  transform-origin: left;
  z-index: 3;
}
@keyframes vsProgress {
  0%   { transform: scaleX(0); }
  100% { transform: scaleX(1); }
}

.hero-stats {
  display: flex; gap: 36px; margin-top: 12px;
  border-top: 1px solid rgba(255,255,255,0.1);
  padding-top: 28px;
}
.hero-stat strong {
  display: block;
  font-family: var(--font-head);
  font-size: 2rem; font-weight: 800;
  color: var(--gold); line-height: 1;
  animation: statFloat 3s ease-in-out infinite;
}
.hero-stat:nth-child(2) strong { animation-delay: 0.3s; }
.hero-stat:nth-child(3) strong { animation-delay: 0.6s; }
@keyframes statFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}
.hero-stat span { font-size: 0.78rem; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.06em; }

/* ── HERO WRITE-UP ──────────────────────────────────── */
.hero-writeup {
  position: relative; z-index: 1;
  width: 100%;
  padding: 40px 0 8px;
}
.hero-writeup-inner {
  max-width: 820px; margin: 0 auto; text-align: left;
}
.vision-heading-wrap { text-align: center; margin-bottom: 28px; }
.hero-writeup h2 {
  font-family: var(--font-head);
  font-size: clamp(1.1rem, 4.4vw, 2.2rem);
  font-weight: 800; letter-spacing: 0.02em;
  color: var(--gold);
  white-space: nowrap;
  display: inline-block;
  padding: 14px 32px;
  border-radius: 50px;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.28);
  backdrop-filter: blur(14px) saturate(140%);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  box-shadow: 0 8px 28px rgba(0,0,0,0.25), inset 0 1px 0 rgba(255,255,255,0.2);
}
.hero-writeup p {
  color: rgba(255,255,255,0.72);
  font-size: 1.05rem; line-height: 1.75;
  margin-bottom: 18px;
  text-align: left;
}
.hero-writeup-tagline {
  color: var(--white);
  font-weight: 700;
  font-size: 1.15rem;
  margin-top: 28px;
  margin-bottom: 0;
  text-align: left;
}

.hero-right {
  background: var(--navy2);
  display: flex; align-items: center; justify-content: center;
  padding: 60px 5% 60px 40px;
  position: relative;
}
.hero-right::before {
  content: '';
  position: absolute; inset: 0;
  background: repeating-linear-gradient(
    -45deg,
    transparent,
    transparent 12px,
    rgba(255,255,255,0.015) 12px,
    rgba(255,255,255,0.015) 24px
  );
}

/* ── TRACK CARD ─────────────────────────────────────── */
.track-card {
  background: var(--white);
  border-radius: 6px;
  padding: 36px 32px;
  box-shadow: var(--shadow-lg);
  width: 100%; max-width: 420px;
  position: relative; z-index: 2;
  border-top: 4px solid var(--gold);
}

/* Tracking card overlaps the lower portion of the hero photo, then
   continues below it so most of the photo stays visible and uncovered */
.track-card-overlay {
  position: relative;
  z-index: 4;
  width: 100%;
  max-width: 980px;
  margin: -100px auto 28px;
  padding: 24px 26px 34px;
  background: rgba(255,255,255,0.97);
  backdrop-filter: blur(8px) saturate(140%);
  -webkit-backdrop-filter: blur(8px) saturate(140%);
  box-shadow: 0 18px 50px rgba(0,0,0,0.35);
  border-radius: 6px;
  border-top: 4px solid var(--navy);
}
.track-card-overlay h3 { margin-bottom: 4px; color: var(--gold); }
.track-card-overlay p { margin-bottom: 16px; }
.track-card-overlay .field-group { margin-bottom: 12px; }
.track-card-overlay .btn-track { background: var(--navy); color: var(--gold); }
.track-card-overlay .btn-track:hover { background: #123B6D; }
.track-card h3 {
  font-family: var(--font-head);
  font-size: 1.25rem; font-weight: 700;
  color: var(--navy); margin-bottom: 6px;
  letter-spacing: 0.01em;
}
.track-card p { font-size: 0.85rem; color: var(--mid); margin-bottom: 24px; }

.field-group { position: relative; margin-bottom: 14px; }
.field-group label {
  display: block; font-size: 0.75rem; font-weight: 600;
  color: var(--mid); text-transform: uppercase; letter-spacing: 0.06em;
  margin-bottom: 6px;
}
.field-group input {
  width: 100%; padding: 13px 16px;
  border: 1.5px solid var(--grey); border-radius: var(--radius);
  font-family: var(--font-body); font-size: 0.95rem;
  color: var(--dark); background: var(--offwhite);
  transition: border-color 0.25s, background 0.25s;
}
.field-group input:focus {
  outline: none; border-color: var(--gold);
  background: var(--white);
  box-shadow: 0 0 0 3px rgba(30,136,229,0.12);
}
.field-group input::placeholder { color: #ADA48D; }

.btn-track {
  width: 100%; padding: 14px 20px;
  background: var(--gold); color: var(--navy);
  border: none; border-radius: var(--radius);
  font-family: var(--font-head); font-size: 1rem; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  cursor: pointer; transition: background 0.2s, transform 0.15s;
  display: flex; align-items: center; justify-content: center; gap: 10px;
  margin-top: 8px;
  position: relative; overflow: hidden;
}
.btn-track::before {
  content: '';
  position: absolute; top: 0; left: -60%;
  width: 40%; height: 100%;
  background: linear-gradient(120deg, transparent, rgba(255,255,255,0.45), transparent);
  animation: shimmerSweep 3.2s ease-in-out infinite;
}
@keyframes shimmerSweep {
  0% { left: -60%; }
  100% { left: 130%; }
}
.btn-track svg { transition: transform 0.2s; }
.btn-track:hover { background: var(--gold2); transform: translateY(-1px); }
.btn-track:hover svg { transform: translateX(4px); }
.btn-track:active { transform: translateY(0); }

.track-error {
  color: var(--red); font-size: 0.82rem; font-weight: 500;
  margin-top: 10px; display: none; align-items: center; gap: 6px;
}
.track-error::before { content: '⚠'; }
.track-card { transition: box-shadow 0.35s ease, transform 0.35s ease; }
.track-card:hover { box-shadow: 0 26px 70px rgba(0,0,0,0.32); transform: translateY(-2px); }

/* ── SECONDARY TRACKER — AIR WAYBILL STYLE ─────────────
   Same live JSONBin lookup as the hero tracker, dressed as
   the waybill stub that travels with the freight itself. */
.tracker-waybill-section {
  background: linear-gradient(180deg, var(--navy) 0%, #080D14 100%);
  padding: 92px 5%; position: relative; overflow: hidden;
}
.tracker-waybill-section::before {
  content: ''; position: absolute; inset: 0;
  background-image: radial-gradient(rgba(30,136,229,0.10) 1px, transparent 1px);
  background-size: 28px 28px; opacity: 0.6; pointer-events: none;
}
.waybill-eyebrow {
  position: relative; z-index: 1; text-align: center;
  font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--gold); margin-bottom: 12px;
}
.tracker-waybill-title {
  position: relative; z-index: 1; text-align: center;
  font-family: var(--font-head); color: var(--white);
  font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; margin-bottom: 40px;
}
.tracker-waybill-title span { color: var(--gold); font-style: italic; }
.waybill-card {
  position: relative; z-index: 1;
  max-width: 680px; margin: 0 auto;
  background: linear-gradient(155deg, #0F1A28 0%, #0A1930 100%);
  border: 1px solid rgba(30,136,229,0.35);
  border-radius: 4px; display: flex; flex-wrap: wrap;
  box-shadow: var(--shadow-lg);
}
.waybill-main { flex: 1 1 320px; padding: 40px 38px; }
.waybill-main > p { color: rgba(255,255,255,0.55); font-size: 0.86rem; margin-bottom: 24px; }
.waybill-stub {
  flex: 0 0 210px; border-left: 2px dashed rgba(30,136,229,0.4);
  padding: 36px 26px; display: flex; flex-direction: column;
  justify-content: center; gap: 20px; background: rgba(30,136,229,0.04);
  position: relative;
}
.waybill-stub::before, .waybill-stub::after {
  content: ''; position: absolute; left: -10px; width: 18px; height: 18px;
  border-radius: 50%; background: #080D14; border: 1px solid rgba(30,136,229,0.35);
}
.waybill-stub::before { top: -10px; }
.waybill-stub::after { bottom: -10px; }
.ws-label { font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 6px; }
.ws-code { font-family: var(--font-head); font-size: 1.25rem; color: var(--gold); letter-spacing: 0.04em; }
.ws-barcode {
  height: 32px; border-radius: 1px; opacity: 0.9;
  background: repeating-linear-gradient(90deg, var(--gold) 0 2px, transparent 2px 5px, rgba(30,136,229,0.5) 5px 6px, transparent 6px 9px);
}
.waybill-field { margin-bottom: 16px; }
.waybill-field label {
  display: block; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.1em;
  text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 7px;
}
.waybill-field input {
  width: 100%; padding: 13px 14px; background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.16); border-radius: 2px; color: var(--white);
  font-family: var(--font-body); font-size: 0.95rem;
  transition: border-color 0.25s, background 0.25s;
}
.waybill-field input::placeholder { color: rgba(255,255,255,0.28); }
.waybill-field input:focus { outline: none; border-color: var(--gold); background: rgba(30,136,229,0.07); }
.btn-waybill {
  width: 100%; padding: 14px 18px; background: transparent; color: var(--gold);
  border: 1.5px solid var(--gold); border-radius: 2px; cursor: pointer;
  font-family: var(--font-head); font-weight: 700; letter-spacing: 0.08em;
  text-transform: uppercase; font-size: 0.9rem;
  display: flex; align-items: center; justify-content: center; gap: 10px;
  transition: background 0.2s, color 0.2s, transform 0.15s;
}
.btn-waybill:hover { background: var(--gold); color: var(--navy); transform: translateY(-1px); }
.btn-waybill:active { transform: translateY(0); }
.waybill-error {
  color: #C4685A; font-size: 0.82rem; margin-top: 10px;
  display: none; align-items: center; gap: 6px;
}
.waybill-error::before { content: '⚠'; }

/* ── TERTIARY TRACKER — LEDGER / MANIFEST STYLE ────────
   Same live lookup again, set as a letterpress ledger entry. */
.tracker-ledger-section {
  background: var(--offwhite); padding: 84px 5%;
  border-top: 1px solid var(--grey); border-bottom: 1px solid var(--grey);
}
.ledger-eyebrow {
  text-align: center; font-size: 0.72rem; font-weight: 600;
  letter-spacing: 0.18em; text-transform: uppercase; color: var(--mid); margin-bottom: 12px;
}
.tracker-ledger-title {
  text-align: center; font-family: var(--font-head); color: var(--navy);
  font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; margin-bottom: 40px;
}
.ledger-card {
  max-width: 720px; margin: 0 auto; background: var(--white);
  border: 1px solid var(--dark); padding: 44px 48px; position: relative;
}
.ledger-card::before {
  content: ''; position: absolute; inset: 6px;
  border: 1px solid rgba(10,25,48,0.14); pointer-events: none;
}
.ledger-head {
  display: flex; justify-content: space-between; align-items: flex-end;
  border-bottom: 2px solid var(--dark); padding-bottom: 16px; margin-bottom: 26px;
}
.ledger-head h3 { font-family: var(--font-head); font-size: 1.35rem; font-weight: 800; letter-spacing: -0.01em; }
.ledger-head span { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mid); }
.ledger-row { display: flex; gap: 22px; flex-wrap: wrap; }
.ledger-field { flex: 1 1 220px; }
.ledger-field label {
  display: block; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--mid); margin-bottom: 8px; font-weight: 600;
}
.ledger-field input {
  width: 100%; border: none; border-bottom: 1.5px solid var(--dark);
  padding: 10px 2px; font-family: var(--font-head); font-size: 1.05rem;
  background: transparent; transition: border-color 0.25s;
}
.ledger-field input:focus { outline: none; border-color: var(--gold); }
.ledger-field input::placeholder { color: #ADA48D; font-family: var(--font-body); font-size: 0.85rem; }
.btn-ledger {
  margin-top: 26px; padding: 13px 30px; background: var(--dark); color: var(--offwhite);
  border: none; cursor: pointer; font-family: var(--font-head); font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.88rem;
  display: inline-flex; align-items: center; gap: 10px;
  transition: background 0.2s, color 0.2s, transform 0.15s;
}
.btn-ledger:hover { background: var(--gold); color: var(--navy); transform: translateY(-1px); }
.btn-ledger:active { transform: translateY(0); }
.ledger-error {
  color: var(--red); font-size: 0.82rem; margin-top: 12px;
  display: none; align-items: center; gap: 6px;
}
.ledger-error::before { content: '⚠'; }
.ledger-foot {
  margin-top: 22px; padding-top: 16px; border-top: 1px dashed var(--grey);
  font-size: 0.78rem; color: var(--mid); display: flex;
  justify-content: space-between; flex-wrap: wrap; gap: 8px;
}
@media (max-width: 640px) {
  .waybill-stub { flex: 1 1 100%; border-left: none; border-top: 2px dashed rgba(30,136,229,0.4); flex-direction: row; justify-content: space-between; }
  .waybill-stub::before, .waybill-stub::after { display: none; }
  .ledger-card { padding: 32px 24px; }
  .ledger-head { flex-direction: column; align-items: flex-start; gap: 6px; }
}

/* ── MARQUEE STRIP ──────────────────────────────────── */
.marquee-strip {
  background: var(--gold);
  padding: 11px 0; overflow: hidden;
  border-bottom: 1px solid rgba(0,0,0,0.06);
}
.marquee-inner {
  display: flex; gap: 0;
  animation: marqueeScroll 22s linear infinite;
  width: max-content;
}
.marquee-inner span {
  font-family: var(--font-head);
  font-size: 0.8rem; font-weight: 700;
  color: var(--navy); letter-spacing: 0.08em;
  text-transform: uppercase; white-space: nowrap;
  padding: 0 36px;
}
.marquee-inner span::after { content: '◆'; margin-left: 36px; font-size: 0.5rem; vertical-align: middle; }
@keyframes marqueeScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

/* ── SERVICES ───────────────────────────────────────── */
.section { padding: 80px 5%; }
.section-head { text-align: center; margin-bottom: 56px; }
.section-head .badge { margin-bottom: 16px; }
.section-head h2 {
  font-family: var(--font-head);
  font-size: clamp(1.8rem, 3vw, 2.8rem); font-weight: 800;
  color: var(--navy); line-height: 1.1; letter-spacing: -0.01em;
}
.section-head h2 span { color: var(--gold); }
.section-head p { color: var(--mid); font-size: 1rem; margin-top: 12px; max-width: 520px; margin-left: auto; margin-right: auto; }

.services-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
  max-width: 1800px; margin: 0 auto;
}
.service-card {
  background: var(--white); border-radius: 6px;
  border: 1.5px solid var(--grey);
  padding: 0;
  transition: border-color 0.25s, box-shadow 0.25s, transform 0.2s;
  position: relative; overflow: hidden;
  display: flex; flex-direction: column;
}
.service-media {
  width: 100%; aspect-ratio: 3 / 2; overflow: hidden;
  display: block; line-height: 0; position: relative;
}
.service-media img {
  width: 100%; height: 100%; object-fit: cover; object-position: center;
  display: block;
}
.service-body { padding: 24px 28px 32px; }
.service-card::before {
  content: '';
  position: absolute; top: 0; left: -75%; width: 50%; height: 100%;
  background: linear-gradient(120deg, transparent, rgba(30,136,229,0.16), transparent);
  transition: left 0.7s ease;
  pointer-events: none;
}
.service-card:hover::before { left: 130%; }
.service-card::after {
  content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(90deg, var(--gold), var(--gold2), var(--gold)); transform: scaleX(0); transform-origin: left;
  transition: transform 0.3s ease;
}
.service-card:hover { border-color: transparent; box-shadow: 0 22px 55px rgba(10,25,48,0.16), 0 0 0 1px rgba(30,136,229,0.25); transform: translateY(-6px); }
.service-card:hover::after { transform: scaleX(1); }
.service-card:hover .service-media img { transform: scale(1.05); }
.service-media img { transition: transform 0.4s ease; }

.service-card.clickable { cursor: pointer; }

.service-card h3 {
  font-family: var(--font-head); font-size: 1.15rem; font-weight: 700;
  color: var(--navy); margin-bottom: 10px; letter-spacing: 0.01em;
}
.service-card p { font-size: 0.88rem; color: var(--mid); line-height: 1.65; }
.service-tag {
  display: inline-block; margin-top: 18px;
  font-size: 0.73rem; font-weight: 600; letter-spacing: 0.06em;
  text-transform: uppercase; color: var(--gold);
  border-bottom: 1.5px solid var(--gold); padding-bottom: 1px;
}

/* ── COUNTRIES SERVED ───────────────────────────────── */
#countries-section {
  display: none;
  background: var(--offwhite);
  padding: 64px 5% 80px;
  animation: fadeUp 0.4s ease-out;
}
.countries-wrap { max-width: 880px; margin: 0 auto; }
.countries-head {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 28px; gap: 16px; flex-wrap: wrap;
}
.countries-head h2 {
  font-family: var(--font-head); font-size: clamp(1.6rem, 2.6vw, 2.2rem);
  font-weight: 800; color: var(--navy); letter-spacing: -0.01em; margin-bottom: 6px;
}
.countries-head p { color: var(--mid); font-size: 0.9rem; }
.close-countries {
  background: var(--white); border: 1.5px solid var(--grey);
  color: var(--navy); font-weight: 600; font-size: 0.8rem;
  padding: 9px 16px; border-radius: var(--radius); cursor: pointer;
  letter-spacing: 0.02em; transition: border-color 0.2s, color 0.2s;
  flex-shrink: 0;
}
.close-countries:hover { border-color: var(--gold); color: var(--gold); }

.region { margin-bottom: 12px; }

.region-label {
  font-family: var(--font-head);
  font-size: 0.95rem;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--navy);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  background: var(--white);
  border: 1.5px solid var(--grey);
  border-radius: 6px;
  padding: 14px 16px;
  cursor: pointer;
  transition: border-color 0.15s ease, background 0.15s ease;
}
.region-label:hover { border-color: var(--gold); }
.region-label .count {
  color: var(--mid); font-weight: 500; font-size: 0.75rem;
  text-transform: none; letter-spacing: 0;
}
.region-label .chev {
  margin-left: auto;
  transition: transform 0.15s ease;
  color: var(--mid);
}
.region.open .region-label {
  border-color: var(--gold);
  background: rgba(30,136,229,0.07);
}
.region.open .region-label .chev { transform: rotate(180deg); }

.flag-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 6px;
  margin-top: 8px;
}
.region:not(.open) .flag-grid { display: none; }

.country {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 11px; border: 1px solid transparent; border-radius: 6px;
  background: var(--white); font-family: var(--font-body);
  font-size: 0.85rem; color: var(--dark);
}
.country .flag { font-size: 18px; line-height: 1; width: 24px; flex: none; text-align: center; }
.country .name { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* ── HOW IT WORKS ───────────────────────────────────── */
.how-section { background: var(--navy); padding: 80px 5%; color: var(--white); }
.steps-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px;
  max-width: 1800px; margin: 0 auto; position: relative;
}
.steps-grid::before {
  content: '';
  position: absolute; top: 28px; left: 10%; right: 10%;
  height: 1px; background: rgba(30,136,229,0.25);
  pointer-events: none;
}
.step { text-align: center; position: relative; }
.step-num {
  width: 56px; height: 56px;
  background: var(--gold); color: var(--navy);
  border-radius: 50%; display: grid; place-items: center;
  font-family: var(--font-head); font-size: 1.2rem; font-weight: 800;
  margin: 0 auto 20px; position: relative; z-index: 1;
  transition: transform 0.35s ease;
}
.step:hover .step-num { transform: scale(1.1) rotate(-6deg); }
.step-num::before {
  content: '';
  position: absolute; inset: -6px;
  border: 1.5px solid var(--gold);
  border-radius: 50%;
  opacity: 0;
  animation: stepRing 2.4s ease-out infinite;
}
.step:nth-child(2) .step-num::before { animation-delay: 0.4s; }
.step:nth-child(3) .step-num::before { animation-delay: 0.8s; }
.step:nth-child(4) .step-num::before { animation-delay: 1.2s; }
@keyframes stepRing {
  0% { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(1.4); opacity: 0; }
}
.step h4 {
  font-family: var(--font-head); font-size: 1.05rem; font-weight: 700;
  letter-spacing: 0.02em; margin-bottom: 10px; color: var(--white);
}
.step p { font-size: 0.83rem; color: rgba(255,255,255,0.5); line-height: 1.65; }

/* ── WHY US ─────────────────────────────────────────── */
.why-section { background: var(--offwhite); padding: 80px 5%; }
.why-inner {
  display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;
  max-width: 1800px; margin: 0 auto;
}
.why-visual {
  background: var(--navy);
  border-radius: 6px; padding: 48px 40px;
  color: var(--white); position: relative; overflow: hidden;
}
.why-visual::before {
  content: 'GD'; position: absolute; right: -20px; bottom: -24px;
  font-family: var(--font-head); font-size: 9rem; font-weight: 800;
  color: rgba(255,255,255,0.04); line-height: 1;
  pointer-events: none; user-select: none;
}
.why-metric { margin-bottom: 32px; }
.why-metric:last-child { margin-bottom: 0; }
.why-metric .val {
  font-family: var(--font-head); font-size: 3rem; font-weight: 800;
  color: var(--gold); line-height: 1; display: block;
}
.why-metric .lbl { font-size: 0.82rem; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.07em; margin-top: 4px; display: block; }
.why-bar { height: 3px; background: rgba(255,255,255,0.1); border-radius: 2px; margin-top: 10px; overflow: hidden; }
.why-bar-fill { height: 100%; background: var(--gold); border-radius: 2px; position: relative; overflow: hidden; }
.why-bar-fill::after {
  content: '';
  position: absolute; top: 0; left: -100%;
  width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
  animation: barShimmer 2.4s ease-in-out infinite;
}
@keyframes barShimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

.why-content .badge { margin-bottom: 16px; }
.why-content h2 {
  font-family: var(--font-head); font-size: clamp(1.8rem, 2.5vw, 2.6rem);
  font-weight: 800; color: var(--navy); line-height: 1.1; margin-bottom: 20px;
}
.why-content p { font-size: 0.95rem; color: var(--mid); margin-bottom: 28px; line-height: 1.75; }
.why-list { list-style: none; display: flex; flex-direction: column; gap: 14px; }
.why-list li {
  display: flex; align-items: flex-start; gap: 12px;
  font-size: 0.9rem; color: var(--dark);
}
.why-list li::before {
  content: '✓'; flex-shrink: 0;
  width: 22px; height: 22px;
  background: var(--gold); color: var(--navy);
  border-radius: 50%; display: grid; place-items: center;
  font-size: 0.7rem; font-weight: 700; margin-top: 1px;
}

/* ── RESULT SECTION ─────────────────────────────────── */
#result-section {
  background: var(--offwhite);
  padding: 60px 5%; display: none;
  animation: fadeUp 0.4s ease-out;
}
@keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

.result-card {
  background: var(--white);
  border-radius: 6px; padding: 40px;
  box-shadow: var(--shadow);
  max-width: 860px; margin: 0 auto;
  border-left: 5px solid var(--green);
}
.result-header {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 32px; flex-wrap: wrap; gap: 16px;
}
.result-id {
  font-family: var(--font-head); font-size: 1.5rem; font-weight: 800;
  color: var(--navy); letter-spacing: 0.02em;
}
.result-id span { color: var(--gold); }
.status-pill {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 7px 16px; border-radius: 30px;
  font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
}
.status-pill.transit { background: rgba(12,133,153,0.1); color: var(--green); border: 1.5px solid rgba(12,133,153,0.3); }
.status-pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--green); animation: pulse 1.5s infinite; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }

.result-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 32px; }
.result-item label {
  display: block; font-size: 0.72rem; font-weight: 600;
  color: var(--mid); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 5px;
}
.result-item strong { font-size: 0.95rem; color: var(--dark); font-weight: 600; }

.timeline { border-top: 1.5px solid var(--grey); padding-top: 28px; }
.timeline h4 {
  font-family: var(--font-head); font-size: 1rem; font-weight: 700;
  color: var(--navy); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 20px;
}

/* ── LIVE ROUTE MAP (origin → destination on a real map) ─── */
.route-map-section { position: relative; padding: 0 0 20px; margin-bottom: 8px; }
.route-map-head {
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: 10px; margin-bottom: 14px;
}
.route-map-head h4 {
  font-family: var(--font-head); font-size: 1rem; font-weight: 700;
  color: var(--navy); letter-spacing: 0.04em; text-transform: uppercase; margin: 0;
}
.route-map-pct {
  font-size: 0.72rem; font-weight: 700; color: var(--navy);
  background: var(--offwhite); border: 1.5px solid var(--grey);
  padding: 4px 12px; border-radius: 20px; white-space: nowrap;
}
.route-map-frame {
  width: 100%; height: 380px; border-radius: 10px; overflow: hidden;
  border: 1.5px solid var(--grey); background: var(--offwhite);
  position: relative; box-shadow: var(--shadow);
}
.route-map-frame .leaflet-container { width: 100%; height: 100%; background: var(--offwhite); font-family: var(--font-body); }
.route-map-loading {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  color: var(--mid); font-size: 0.85rem; font-weight: 600; background: var(--offwhite); z-index: 5;
}
/* Custom Leaflet marker styling */
.rmp-pin {
  width: 30px; height: 30px; border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg); display: flex; align-items: center; justify-content: center;
  box-shadow: 0 3px 8px rgba(0,0,0,0.35); border: 2px solid var(--white); overflow: hidden;
}
.rmp-pin.origin { background: var(--navy); }
.rmp-pin.destination { background: var(--gold); }
.rmp-pin span { transform: rotate(45deg); font-size: 0.95rem; }
.rmp-pin img { transform: rotate(45deg); }

/* Pulsing indicator marking the shipment's current location */
.rmp-current-wrap { position: relative; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; }
.rmp-current-ring {
  position: absolute; width: 30px; height: 30px; border-radius: 50%;
  border: 2.5px solid var(--green); animation: rmpPulse 1.7s ease-out infinite;
}
@keyframes rmpPulse {
  0% { transform: scale(0.45); opacity: 0.9; }
  100% { transform: scale(1.7); opacity: 0; }
}
.rmp-current {
  position: relative; width: 26px; height: 26px; border-radius: 50%;
  background: var(--green); border: 2.5px solid var(--white);
  box-shadow: 0 2px 8px rgba(0,0,0,0.4);
  display: flex; align-items: center; justify-content: center; font-size: 0.9rem;
}
.route-map-labels {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-top: 14px; font-size: 0.76rem; color: var(--mid); font-weight: 600; flex-wrap: wrap; gap: 12px;
}
.route-map-labels strong { color: var(--dark); font-weight: 700; }
.route-map-labels .rml-col { display: flex; align-items: flex-start; gap: 7px; min-width: 0; }
.route-map-labels .rml-flag { display: inline-flex; flex-shrink: 0; margin-top: 2px; line-height: 0; }
.route-map-labels .rml-flag img { display: block; }
.route-map-labels .rml-current { text-align: center; flex-direction: column; align-items: center; gap: 3px; }
.route-map-labels .rml-current .rml-dot {
  width: 8px; height: 8px; border-radius: 50%; background: var(--green);
  box-shadow: 0 0 0 3px rgba(12,133,153,0.18); flex-shrink: 0;
}
.route-map-labels .rml-dest { text-align: right; flex-direction: row-reverse; }

.timeline-steps { display: flex; flex-direction: column; gap: 0; }
.tl-step {
  display: flex; gap: 16px; position: relative;
  padding-bottom: 20px;
  opacity: 0; animation: tlIn 0.5s ease forwards;
}
.tl-step:last-child { padding-bottom: 0; }
.tl-left { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.tl-dot {
  width: 15px; height: 15px; border-radius: 50%; flex-shrink: 0;
  border: 2px solid var(--grey); background: var(--white);
  position: relative; z-index: 1;
}
.tl-dot.done { background: var(--green); border-color: var(--green); }
.tl-dot.done::after {
  content: '✓'; position: absolute; inset: 0; display: flex;
  align-items: center; justify-content: center;
  color: #fff; font-size: 9px; font-weight: 800; line-height: 1;
}
.tl-dot.active { background: var(--gold); border-color: var(--gold); box-shadow: 0 0 0 3px rgba(30,136,229,0.2); }
.tl-dot.active::after {
  content: ''; position: absolute; inset: -6px; border-radius: 50%;
  border: 2px solid var(--gold); animation: tlPulse 1.6s infinite;
}
.tl-line { width: 2px; flex: 1; background: var(--grey); min-height: 24px; position: relative; overflow: hidden; }
.tl-line-fill { position: absolute; top: 0; left: 0; width: 100%; height: 0%; background: var(--green); transition: height 0.7s ease 0.15s; }
.tl-line.done .tl-line-fill { height: 100%; }
.tl-step:last-child .tl-line { display: none; }
.tl-content { padding-top: 0; }
.tl-content strong { font-size: 0.88rem; font-weight: 600; color: var(--dark); display: block; line-height: 1.3; }
.tl-content span { font-size: 0.78rem; color: var(--mid); }
.tl-content .tl-location {
  display: block; font-size: 0.8rem; font-weight: 600; color: var(--navy);
  margin-top: 3px; line-height: 1.4;
}
.tl-content .tl-time {
  display: block; font-size: 0.74rem; color: var(--mid); margin-top: 2px;
}
@keyframes tlIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }
@keyframes tlPulse { 0% { transform: scale(0.6); opacity: 0.85; } 100% { transform: scale(1.7); opacity: 0; } }

/* ── SETTLEMENT: AMOUNT DUE / SIGNATURE / STAMP ──────── */
.settlement { border-top: 1.5px solid var(--grey); margin-top: 32px; padding-top: 28px; }
.settlement h4 {
  font-family: var(--font-head); font-size: 1rem; font-weight: 700;
  color: var(--navy); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 20px;
}
.settlement-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 24px; align-items: stretch; }
@media (max-width: 700px) { .settlement-grid { grid-template-columns: 1fr; } }

.amount-card {
  background: var(--offwhite); border: 1.5px solid var(--grey); border-radius: 6px;
  padding: 22px 24px;
}
.amount-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; font-size: 0.9rem; }
.amount-row + .amount-row { border-top: 1px dashed var(--grey); }
.amount-row label { color: var(--mid); font-weight: 600; }
.amount-row strong { color: var(--dark); font-weight: 700; }
.amount-row.due strong { color: var(--red); font-size: 1.1rem; }
.amount-row.paid strong { color: var(--green); }
.amount-status-pill {
  display: inline-block; padding: 3px 12px; border-radius: 30px;
  font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
}
.amount-status-pill.unpaid { background: rgba(214,69,69,0.1); color: var(--red); border: 1.5px solid rgba(214,69,69,0.3); }
.amount-status-pill.partial { background: rgba(30,136,229,0.12); color: var(--navy2); border: 1.5px solid rgba(30,136,229,0.35); }
.amount-status-pill.paid { background: rgba(12,133,153,0.1); color: var(--green); border: 1.5px solid rgba(12,133,153,0.3); }
.amount-note {
  margin-top: 14px; padding-top: 14px; border-top: 1.5px solid var(--grey);
}
.amount-note label {
  display: block; font-size: 0.72rem; font-weight: 700; color: var(--mid);
  text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;
}
.amount-note p {
  font-size: 0.86rem; color: var(--dark); line-height: 1.5;
  min-height: 2.4em;
}
.amount-note p.empty { color: var(--mid); font-style: italic; }

.sign-stamp-card {
  display: flex; flex-direction: column; justify-content: flex-start;
  gap: 18px; padding: 22px 20px; border: 1.5px solid var(--grey); border-radius: 6px;
}
.receiver-name-block { text-align: center; padding-bottom: 16px; border-bottom: 1.5px dashed var(--grey); }
.receiver-name-block label {
  display: block; font-size: 0.68rem; font-weight: 700; color: var(--mid);
  text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px;
}
.receiver-name {
  font-family: var(--font-head); font-weight: 800; font-size: 1.15rem;
  color: var(--navy); text-transform: uppercase; letter-spacing: 0.04em;
}
.agent-sign { text-align: center; padding-bottom: 16px; border-bottom: 1.5px dashed var(--grey); }
.agent-sign .sig-name {
  font-family: 'Brush Script MT', cursive; font-size: 1.7rem; color: var(--navy);
  line-height: 1.1;
}
.agent-sign .sig-rule { border-top: 1.5px solid var(--mid); margin: 6px auto 0; width: 80%; }
.agent-sign .sig-label {
  font-size: 0.68rem; color: var(--mid); text-transform: uppercase;
  letter-spacing: 0.08em; margin-top: 6px; font-weight: 600;
}

.goods-stamp-wrap { display: flex; justify-content: center; }
.goods-stamp {
  width: 108px; height: 108px; border-radius: 50%;
  border: 3px solid var(--green); color: var(--green);
  display: flex; align-items: center; justify-content: center;
  transform: rotate(-12deg); opacity: 0.9;
  position: relative;
}
.goods-stamp::before {
  content: ''; position: absolute; inset: 6px; border-radius: 50%;
  border: 1.5px solid var(--green);
}
.goods-stamp-text {
  font-family: var(--font-head); font-weight: 800; font-size: 0.88rem;
  letter-spacing: 0.03em; text-align: center; line-height: 1.25;
  text-transform: uppercase;
}
.goods-stamp-text small { display: block; font-size: 0.58rem; font-weight: 700; letter-spacing: 0.1em; margin-top: 3px; }

/* ── TRACKING SEARCH PRELOADER ──────────────────────── */
#trackPreloader {
  position: fixed; inset: 0; z-index: 9999;
  background: var(--navy);
  display: none;
  flex-direction: column; justify-content: space-between;
  font-family: var(--font-body);
  color: var(--offwhite);
}
#trackPreloader.open { display: flex; }
#trackPreloader.tp-fade-out { animation: tpOut 0.5s ease forwards; }
@keyframes tpOut { to { opacity: 0; visibility: hidden; } }
.tp-grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
  background-size: 42px 42px;
  mask-image: radial-gradient(circle at 50% 50%, black 40%, transparent 85%);
  opacity: 0.8;
}
.tp-manifest {
  position: relative; display: flex; justify-content: space-between;
  padding: 26px 5%; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
  color: rgba(235,242,250,0.55);
}
.tp-manifest b { color: var(--offwhite); font-weight: 600; }
.tp-manifest .tp-tag {
  color: var(--gold2); border: 1px solid var(--gold2); padding: 2px 10px;
  border-radius: 2px; font-size: 10px; letter-spacing: 0.16em;
}
.tp-center {
  position: relative; flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 30px; padding: 0 5%; text-align: center;
}
.tp-wordmark {
  font-family: var(--font-head); font-style: italic; font-weight: 800;
  font-size: clamp(26px,4.4vw,44px); color: var(--offwhite);
}
.tp-wordmark span { color: var(--gold2); }
.tp-sub {
  font-size: 11px; letter-spacing: 0.22em; color: rgba(235,242,250,0.55);
  text-transform: uppercase; margin-top: 6px;
}
.tp-route-wrap { width: min(520px, 78vw); }
svg.tp-route { width: 100%; height: 60px; overflow: visible; }
.tp-route-path { fill: none; stroke: rgba(255,255,255,0.14); stroke-width: 2; stroke-dasharray: 6 8; }
.tp-route-progress { fill: none; stroke: var(--gold2); stroke-width: 2; stroke-dasharray: 620; stroke-dashoffset: 620; }
