<script>
(function(){

  /* ── LIVE TRACKING (connected to Veloz Admin via JSONBin) ─
     Same bin / same 9-stage journey as the homepage trackers, so
     this page always matches whatever the admin portal shows. */
  const JSONBIN_BIN_ID     = '6a722488f5f4af5e29eaf0a1';
  const JSONBIN_ACCESS_KEY = '$2a$10$bZ.0N.sW4eXQhtFylKqtAe/EP3I62yrmWMmoONNhz3cQ0KlDqbk0y';
  const JSONBIN_BASE       = 'https://api.jsonbin.io/v3/b/' + JSONBIN_BIN_ID;

  const STAGES = ['Shipment Created','Picked Up','Warehouse','Airport','Customs',
    'Destination Country','Local Distribution','Out for Delivery','Delivered'];

  function esc(str) {
    const d = document.createElement('div');
    d.textContent = str == null ? '' : String(str);
    return d.innerHTML;
  }
  function fmtDate(iso) {
    if (!iso) return '—';
    return new Date(iso).toLocaleString(undefined, { month:'short', day:'numeric', year:'numeric', hour:'2-digit', minute:'2-digit' });
  }
  function fmtDateOnly(iso) {
    if (!iso) return '—';
    const d = new Date(iso + (String(iso).includes('T') ? '' : 'T00:00:00'));
    return d.toLocaleDateString(undefined, { month:'long', day:'numeric', year:'numeric' });
  }
  function parseMoney(str) {
    if (str == null) return null;
    const n = parseFloat(String(str).replace(/[^0-9.\-]/g, ''));
    return isNaN(n) ? null : n;
  }
  function fmtMoney(n) {
    if (n == null || isNaN(n)) return 'N/A';
    return '£' + n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  async function fetchShipments() {
    let r;
    try {
      r = await fetch(JSONBIN_BASE + '/latest', {
        headers: { 'X-Access-Key': JSONBIN_ACCESS_KEY }
      });
    } catch (networkErr) {
      console.error('[Tracking] Network-level failure reaching JSONBin:', networkErr);
      const e = new Error('network');
      e.kind = 'network';
      throw e;
    }
    if (!r.ok) {
      const bodyText = await r.text().catch(() => '');
      console.error('[Tracking] JSONBin rejected the request. HTTP ' + r.status + '. Body:', bodyText);
      const e = new Error('http-' + r.status);
      e.kind = (r.status === 401 || r.status === 403) ? 'auth' : (r.status === 404 ? 'notfound' : 'server');
      e.status = r.status;
      throw e;
    }
    const d = await r.json();
    return (d.record && d.record.shipments) || {};
  }

  function getVehicleIcon(service) {
    const sv = (service || '').toLowerCase();
    if (sv.includes('air')) return '✈️';
    if (sv.includes('ocean') || sv.includes('sea')) return '🚢';
    if (sv.includes('rail')) return '🚆';
    if (sv.includes('road')) return '🚚';
    if (sv.includes('same-day') || sv.includes('same day')) return '🏍️';
    if (sv.includes('white glove')) return '🚐';
    return '📦';
  }

  // ── LIVE ROUTE MAP ── geocodes origin + destination and plots them.
  let routeMapInstance = null;
  let routeMapLayers = [];
  let routeMapReqToken = 0;

  const COUNTRY_CODE_MAP = {
    'nigeria':'ng','united kingdom':'gb','uk':'gb','great britain':'gb','england':'gb','scotland':'gb','wales':'gb',
    'united states':'us','usa':'us','us':'us','united states of america':'us','america':'us',
    'canada':'ca','china':'cn','india':'in','pakistan':'pk','bangladesh':'bd','japan':'jp','south korea':'kr','korea':'kr',
    'germany':'de','france':'fr','italy':'it','spain':'es','portugal':'pt','netherlands':'nl','belgium':'be',
    'switzerland':'ch','austria':'at','sweden':'se','norway':'no','denmark':'dk','finland':'fi','poland':'pl',
    'ireland':'ie','greece':'gr','turkey':'tr','russia':'ru','ukraine':'ua','romania':'ro','hungary':'hu','czech republic':'cz',
    'south africa':'za','kenya':'ke','ghana':'gh','egypt':'eg','morocco':'ma','ethiopia':'et','tanzania':'tz','uganda':'ug',
    'senegal':'sn','ivory coast':'ci', "cote d'ivoire":'ci','cameroon':'cm','algeria':'dz','tunisia':'tn','zambia':'zm','zimbabwe':'zw',
    'australia':'au','new zealand':'nz','brazil':'br','mexico':'mx','argentina':'ar','chile':'cl','colombia':'co','peru':'pe',
    'venezuela':'ve','uae':'ae','united arab emirates':'ae','dubai':'ae','saudi arabia':'sa','qatar':'qa','kuwait':'kw',
    'bahrain':'bh','oman':'om','israel':'il','jordan':'jo','lebanon':'lb','iraq':'iq','iran':'ir',
    'indonesia':'id','malaysia':'my','singapore':'sg','thailand':'th','vietnam':'vn','philippines':'ph','myanmar':'mm',
    'sri lanka':'lk','nepal':'np','hong kong':'hk','taiwan':'tw',
    'iceland':'is','luxembourg':'lu','croatia':'hr','serbia':'rs','bulgaria':'bg',
    'slovakia':'sk','slovenia':'si','estonia':'ee','latvia':'lv','lithuania':'lt','cyprus':'cy','malta':'mt',
  };
  function countryCodeFromLocation(str) {
    if (!str) return null;
    const parts = String(str).split(',').map(p => p.trim().toLowerCase()).filter(Boolean);
    for (let i = parts.length - 1; i >= 0; i--) {
      if (COUNTRY_CODE_MAP[parts[i]]) return COUNTRY_CODE_MAP[parts[i]];
    }
    return COUNTRY_CODE_MAP[String(str).trim().toLowerCase()] || null;
  }
  function flagImgHtml(location, size) {
    const cc = countryCodeFromLocation(location);
    if (!cc) return '';
    return `<img src="https://flagcdn.com/w80/${cc}.png" alt="" style="width:${size}px;height:${size}px;object-fit:cover;border-radius:50%;border:1.5px solid rgba(255,255,255,0.85);" onerror="this.style.display='none'">`;
  }

  async function geocodeLocation(query) {
    const q = encodeURIComponent(query);
    const r = await fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' + q);
    const results = await r.json();
    if (!results || !results.length) return null;
    return { lat: parseFloat(results[0].lat), lon: parseFloat(results[0].lon) };
  }

  function makePinIcon(kind, location) {
    return L.divIcon({
      className: '',
      html: `<div class="rmp-pin ${kind}">${flagImgHtml(location, 20) || `<span>${kind === 'origin' ? '📍' : '🏁'}</span>`}</div>`,
      iconSize: [30, 30],
      iconAnchor: [15, 29],
      popupAnchor: [0, -28]
    });
  }

  function getVehicleMeta(service) {
    const sv = (service || '').toLowerCase();
    if (sv.includes('air')) return { glyph: '✈️', cls: 'air', speed: 0.00035 };
    if (sv.includes('ocean') || sv.includes('sea')) return { glyph: '🚢', cls: 'ocean', speed: 0.00018 };
    if (sv.includes('rail')) return { glyph: '🚆', cls: 'rail', speed: 0.00028 };
    if (sv.includes('road') || sv.includes('same-day') || sv.includes('same day') || sv.includes('white glove'))
      return { glyph: '🚚', cls: 'road', speed: 0.00032 };
    return { glyph: '📦', cls: 'road', speed: 0.00025 };
  }

  function makeVehicleIcon(service) {
    const meta = getVehicleMeta(service);
    return L.divIcon({
      className: '',
      html: `<div class="rmp-vehicle-wrap"><div class="rmp-vehicle-ring"></div><div class="rmp-vehicle-wake"></div><div class="rmp-vehicle ${meta.cls}">${meta.glyph}</div></div>`,
      iconSize: [42, 42],
      iconAnchor: [21, 21]
    });
  }

  // Keep legacy name used elsewhere
  function makeCurrentLocationIcon(glyph) {
    return L.divIcon({
      className: '',
      html: `<div class="rmp-current-wrap"><div class="rmp-current-ring"></div><div class="rmp-current">${glyph}</div></div>`,
      iconSize: [30, 30],
      iconAnchor: [15, 15]
    });
  }

  let vehicleAnimFrame = null;
  let vehicleMarkerRef = null;
  let vehicleAnimState = null;

  function stopVehicleAnimation() {
    if (vehicleAnimFrame) {
      cancelAnimationFrame(vehicleAnimFrame);
      vehicleAnimFrame = null;
    }
    vehicleMarkerRef = null;
    vehicleAnimState = null;
  }

  function startVehicleAnimation(marker, originPt, destPt, baseFrac, service) {
    stopVehicleAnimation();
    if (!marker || !originPt || !destPt) return;
    const meta = getVehicleMeta(service);
    // Travel window: from true progress toward a bit ahead (direction of delivery)
    const windowSize = 0.07;
    const startF = Math.max(0, Math.min(1, baseFrac));
    const endF = Math.min(1, startF + windowSize);
    vehicleAnimState = {
      originPt, destPt, startF, endF,
      t: 0, dir: 1,
      speed: meta.speed * (service && String(service).toLowerCase().includes('air') ? 1.4 : 1)
    };
    vehicleMarkerRef = marker;

    function lerp(a, b, t) { return a + (b - a) * t; }
    function posAt(frac) {
      return [
        lerp(originPt[0], destPt[0], frac),
        lerp(originPt[1], destPt[1], frac)
      ];
    }

    let last = performance.now();
    function tick(now) {
      if (!vehicleMarkerRef || !vehicleAnimState) return;
      const st = vehicleAnimState;
      const dt = Math.min(48, now - last);
      last = now;
      st.t += st.dir * st.speed * dt;
      if (st.t >= 1) { st.t = 1; st.dir = -1; }
      if (st.t <= 0) { st.t = 0; st.dir = 1; }
      // Ease for smoother motion
      const eased = st.t * st.t * (3 - 2 * st.t);
      const frac = lerp(st.startF, st.endF, eased);
      vehicleMarkerRef.setLatLng(posAt(frac));
      vehicleAnimFrame = requestAnimationFrame(tick);
    }
    vehicleAnimFrame = requestAnimationFrame(tick);
  }

  async function renderRouteMap(s, curIdx) {
    const myToken = ++routeMapReqToken;
    const pct = s.status === 'Delivered'
      ? 100
      : curIdx > 0
        ? Math.round((curIdx / (STAGES.length - 1)) * 100)
        : 4;

    document.getElementById('rpOrigin').textContent = s.origin || '—';
    document.getElementById('rpDestination').textContent = s.destination || '—';
    document.getElementById('rpCurrent').textContent = s.currentLocation || (s.status || 'In transit');
    document.getElementById('rpOriginFlag').innerHTML = flagImgHtml(s.origin, 16);
    document.getElementById('rpDestFlag').innerHTML = flagImgHtml(s.destination, 16);
    document.getElementById('rpPct').textContent = pct + '%';

    const loading = document.getElementById('routeMapLoading');
    const mapEl   = document.getElementById('routeMapEl');
    loading.style.display = 'flex';
    loading.textContent = 'Loading map…';
    mapEl.style.visibility = 'hidden';

    if (!s.origin || !s.destination) {
      loading.textContent = 'No route on file for this shipment.';
      return;
    }

    try {
      const geocodeCurrent = (s.currentLocation && s.currentLocation.trim())
        ? geocodeLocation(s.currentLocation)
        : Promise.resolve(null);

      const [origin, destination, current] = await Promise.all([
        geocodeLocation(s.origin),
        geocodeLocation(s.destination),
        geocodeCurrent
      ]);
      if (myToken !== routeMapReqToken) return;
      if (!origin || !destination) {
        loading.textContent = 'Map unavailable for this route.';
        return;
      }

      if (!routeMapInstance) {
        routeMapInstance = L.map('routeMapEl', {
          zoomControl: true, attributionControl: true, scrollWheelZoom: false
        });
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '&copy; OpenStreetMap contributors'
        }).addTo(routeMapInstance);
      }

      routeMapLayers.forEach(layer => routeMapInstance.removeLayer(layer));
      routeMapLayers = [];

      const originPt = [origin.lat, origin.lon];
      const destPt = [destination.lat, destination.lon];

      const originMarker = L.marker(originPt, { icon: makePinIcon('origin', s.origin) })
        .bindPopup('<strong>Origin</strong><br>' + esc(s.origin))
        .addTo(routeMapInstance);
      const destMarker = L.marker(destPt, { icon: makePinIcon('destination', s.destination) })
        .bindPopup('<strong>Destination</strong><br>' + esc(s.destination))
        .addTo(routeMapInstance);
      const routeLine = L.polyline([originPt, destPt], {
        color: '#C08A3E', weight: 3, opacity: 0.85, dashArray: '2,10', lineCap: 'round'
      }).addTo(routeMapInstance);

      routeMapLayers.push(originMarker, destMarker, routeLine);

      const frac = Math.max(0, Math.min(1, pct / 100));
      const currentPt = current
        ? [current.lat, current.lon]
        : [
            originPt[0] + (destPt[0] - originPt[0]) * frac,
            originPt[1] + (destPt[1] - originPt[1]) * frac
          ];
      stopVehicleAnimation();
      const currentMarker = L.marker(currentPt, { icon: makeVehicleIcon(s.service) })
        .bindPopup('<strong>Current Location</strong><br>' + esc(s.currentLocation || s.status || 'In Transit') + '<br>' + pct + '% of the way there')
        .addTo(routeMapInstance);
      routeMapLayers.push(currentMarker);
      // Animate vehicle toward destination while staying near true progress
      if (s.status !== 'Delivered') {
        startVehicleAnimation(currentMarker, originPt, destPt, frac, s.service);
      }

      mapEl.style.visibility = 'visible';
      loading.style.display = 'none';

      requestAnimationFrame(() => {
        routeMapInstance.invalidateSize();
        routeMapInstance.fitBounds(L.latLngBounds([originPt, destPt, currentPt]), { padding: [40, 40], maxZoom: 6 });
      });
    } catch (e) {
      if (myToken === routeMapReqToken) loading.textContent = 'Map unavailable right now.';
    }
  }

  function renderTrackedShipment(s) {
    document.getElementById('resId').textContent = s.id;
    document.getElementById('resStatus').textContent = s.status || 'In Transit';

    const lastUpdateTime = (s.history && s.history.length)
      ? s.history[s.history.length - 1].time
      : s.created;

    document.getElementById('resGrid').innerHTML = `
      <div class="result-item"><label>Origin</label><strong>${esc(s.origin)}</strong></div>
      <div class="result-item"><label>Destination</label><strong>${esc(s.destination)}</strong></div>
      <div class="result-item"><label>Service</label><strong>${esc(s.service || '—')}</strong></div>
      <div class="result-item"><label>Weight</label><strong>${esc(s.weight || '—')}</strong></div>
      <div class="result-item"><label>Est. Delivery</label><strong>${fmtDateOnly(s.eta)}</strong></div>
      <div class="result-item"><label>Last Update</label><strong>${fmtDate(lastUpdateTime)}</strong></div>
    `;

    const stageTimes = {};
    const stageLocations = {};
    (s.history || []).forEach(h => {
      if (STAGES.includes(h.status)) {
        stageTimes[h.status] = h.time;
        if (h.location) stageLocations[h.status] = h.location;
      }
    });
    if (!stageTimes['Shipment Created']) stageTimes['Shipment Created'] = s.created;
    if (!stageLocations['Shipment Created']) stageLocations['Shipment Created'] = s.origin;

    const curIdx = STAGES.indexOf(s.status);

    renderRouteMap(s, curIdx);

    const tl = document.getElementById('resTimeline');
    tl.innerHTML = STAGES.map((stage, i) => {
      const done   = curIdx >= 0 && i < curIdx;
      const active = i === curIdx;
      const state  = active ? 'active' : (done ? 'done' : 'pending');
      const time   = stageTimes[stage];
      const location = stageLocations[stage];
      const fillIt = done || active;
      return `
      <div class="tl-step" style="animation-delay:${i * 70}ms;">
        <div class="tl-left">
          <div class="tl-dot ${state}"></div>
          <div class="tl-line" data-fill="${fillIt ? '1' : '0'}">
            <div class="tl-line-fill"></div>
          </div>
        </div>
        <div class="tl-content">
          <strong>${esc(stage)}</strong>
          ${location ? `<span class="tl-location">📍 ${esc(location)}</span>` : ''}
          <span class="tl-time">${time ? fmtDate(time) : (active || done ? '—' : 'Pending')}</span>
        </div>
      </div>
    `;
    }).join('');

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        tl.querySelectorAll('.tl-line[data-fill="1"]').forEach(el => el.classList.add('done'));
      });
    });

    renderSettlement(s);
  }

  function renderSettlement(s) {
    document.getElementById('resReceiverName').textContent = (s.receiverName || '—').toUpperCase();

    const total   = parseMoney(s.amountToPay);
    const paid    = parseMoney(s.amountPaid) || 0;
    const balance = total != null ? Math.max(total - paid, 0) : null;
    const status  = (total != null && total > 0 && paid >= total) ? 'Paid' : (paid > 0 ? 'Partial' : 'Unpaid');

    document.getElementById('resAmountTotal').textContent   = (s.amountToPay && s.amountToPay !== 'N/A') ? s.amountToPay : 'N/A';
    document.getElementById('resAmountPaid').textContent    = fmtMoney(paid);
    document.getElementById('resAmountBalance').textContent = balance != null ? fmtMoney(balance) : 'N/A';

    const pill = document.getElementById('resPaymentStatus');
    pill.textContent = status;
    pill.className = 'amount-status-pill ' + status.toLowerCase();

    const noteEl = document.getElementById('resPaymentNote');
    if (s.paymentNote && s.paymentNote.trim()) {
      noteEl.textContent = s.paymentNote;
      noteEl.classList.remove('empty');
    } else {
      noteEl.textContent = 'No note has been added for this shipment yet.';
      noteEl.classList.add('empty');
    }
  }

  function showState(which) {
    document.getElementById('trLoading').classList.toggle('hidden', which !== 'loading');
    document.getElementById('trNotFound').classList.toggle('hidden', which !== 'notfound');
    document.getElementById('resultCard').classList.toggle('hidden', which !== 'result');
  }
// Make the device/browser "back" button always return to the homepage,
  // regardless of how this page was reached (search redirect, shared link,
  // QR code, etc). We push one extra history entry for this page, so the
  // first back-press lands on our own popstate handler instead of wherever
  // history happened to point, and we send the customer home from there.
  history.pushState({ page: 'tracking-result' }, '', window.location.href);
  window.addEventListener('popstate', function () {
    showPublicPage();
  });

  window.velozInitTrackingPage = async function (forcedId) {
    const params = new URLSearchParams(window.location.search);
    const idFromUrl = (forcedId || params.get('id') || '').trim();

    if (!idFromUrl) {
      showState('notfound');
      const msg = document.getElementById('trNotFoundMsg');
      if (msg) msg.textContent = 'No tracking number was provided. Please search for a shipment from the homepage.';
      return;
    }

    showState('loading');

    let s = null;
    try {
      const cached = sessionStorage.getItem('veloz_tracked_shipment');
      if (cached) {
        const parsed = JSON.parse(cached);
        if (parsed && parsed.id && parsed.id.toLowerCase() === idFromUrl.toLowerCase()) {
          s = parsed;
        }
      }
    } catch (e) { /* ignore */ }
    sessionStorage.removeItem('veloz_tracked_shipment');

    if (!s) {
      try {
        const shipments = await fetchShipments();
        const matchKey = Object.keys(shipments).find(k => k.toLowerCase() === idFromUrl.toLowerCase());
        s = matchKey ? shipments[matchKey] : null;
      } catch (e) {
        showState('notfound');
        const msg = document.getElementById('trNotFoundMsg');
        if (msg) {
          if (e && e.kind === 'auth') {
            msg.textContent = 'Tracking service is temporarily unavailable (connection not authorized). Please contact support.';
          } else {
            msg.textContent = 'Could not reach the tracking service right now. Please try again shortly.';
          }
        }
        return;
      }
    }

    if (!s) {
      showState('notfound');
      const msg = document.getElementById('trNotFoundMsg');
      if (msg) msg.textContent = 'No shipment found for that tracking number. Please check and try again.';
      return;
    }

    renderTrackedShipment(s);
    showState('result');
  };

  // Auto-run only if this page is visible / has id (router may also call)
  (function () {
    const params = new URLSearchParams(window.location.search);
    if ((params.get('id') || '').trim()) {
      window.velozInitTrackingPage();
    }
  })();

// exports for onclick handlers
  try { window['velozInitTrackingPage'] = velozInitTrackingPage; } catch(e) {}
  try { window['fetchShipments'] = fetchShipments; } catch(e) {}
  try { window['renderTrackedShipment'] = renderTrackedShipment; } catch(e) {}
})();
</script>

