/* ── CARGO TYPES ────────────────────────────────────── */
.cargo-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
  max-width: 1800px; margin: 0 auto;
}
.cargo-card {
  border-radius: 8px;
