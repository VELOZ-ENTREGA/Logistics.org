}
.cargo-card:hover .cargo-icon { transform: scale(1.12) rotate(-4deg); }
.cargo-top h4 { font-family: var(--font-head); font-size: 1.02rem; font-weight: 700; }
.cargo-top span { font-size: 0.76rem; }
