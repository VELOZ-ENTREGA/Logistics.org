<script>
/* ═══ UNIFIED ROUTER — single-file public + tracking + admin ═══ */
(function () {
  const pagePublic = () => document.getElementById('page-public');
  const pageTracking = () => document.getElementById('page-tracking');
  const pageAdmin = () => document.getElementById('page-admin');

  function hideAll() {
    [pagePublic(), pageTracking(), pageAdmin()].forEach(el => {
      if (el) el.style.display = 'none';
    });
    document.body.classList.remove('drawer-open', 'mode-admin', 'mode-tracking');
  }

  window.showPublicPage = function () {
    hideAll();
    document.body.classList.remove('mode-admin', 'mode-tracking');
    if (pagePublic()) pagePublic().style.display = '';
    // Clean id from URL without reload when going home
    try {
      const u = new URL(window.location.href);
      if (u.searchParams.has('id') && !u.hash.includes('admin')) {
        u.searchParams.delete('id');
        history.replaceState({}, '', u.pathname + (u.search || '') + '#home');
      } else if (location.hash !== '#home' && location.hash !== '#admin') {
        history.replaceState({}, '', u.pathname + u.search + '#home');
      }
    } catch (e) {}
    window.scrollTo(0, 0);
    return false;
  };

  window.showAdminPage = function () {
    hideAll();
    document.body.classList.add('mode-admin');
    if (pageAdmin()) pageAdmin().style.display = '';
    try {
      const u = new URL(window.location.href);
      // Drop tracking id when opening admin
      u.search = '';
      history.replaceState({}, '', u.pathname + '#admin');
    } catch (e) {}
    // If session already active, show dashboard; otherwise login form
    try {
      if (sessionStorage.getItem('gd_admin_session') === '1') {
        const shell = document.getElementById('adminShell');
        const login = document.getElementById('loginScreen');
        if (shell) shell.style.display = 'block';
        if (login) login.style.display = 'none';
        if (typeof window.loadShipments === 'function') window.loadShipments();
      } else {
        const shell = document.getElementById('adminShell');
        const login = document.getElementById('loginScreen');
        if (shell) shell.style.display = 'none';
        if (login) login.style.display = 'flex';
      }
    } catch (e) {}
    window.scrollTo(0, 0);
    return false;
  };

  window.openTrackingPage = function (id, shipmentObj) {
    hideAll();
    document.body.classList.add('mode-tracking');
    if (pageTracking()) pageTracking().style.display = '';
    try {
      const u = new URL(window.location.href);
      u.searchParams.set('id', id);
      history.pushState({ page: 'tracking', id: id }, '', u.pathname + '?' + u.searchParams.toString());
    } catch (e) {}
    window.scrollTo(0, 0);

    // Hand off cached shipment for instant render (tracking page reads this)
    try {
      if (shipmentObj) sessionStorage.setItem('veloz_tracked_shipment', JSON.stringify(shipmentObj));
    } catch (e) {}

    // Re-run tracking page init if available
    if (typeof window.velozInitTrackingPage === 'function') {
      window.velozInitTrackingPage(id);
    } else {
      // Fallback: set URL and trigger load via custom event
      window.dispatchEvent(new CustomEvent('veloz-open-tracking', { detail: { id: id } }));
    }
  };

  // Override admin track base URL builder when present
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof window.getTrackBaseUrl === 'function') {
      window.getTrackBaseUrl = function () {
        // Shareable link points to this same file with ?id=
        return window.location.origin + window.location.pathname;
      };
    }
  });

  function routeFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const id = (params.get('id') || '').trim();
    const hash = (window.location.hash || '').replace(/^#/, '');

    if (hash === 'admin') {
      showAdminPage();
      return;
    }
    if (id) {
      // Show tracking results for this id
      hideAll();
      document.body.classList.add('mode-tracking');
      if (pageTracking()) pageTracking().style.display = '';
      if (typeof window.velozInitTrackingPage === 'function') {
        window.velozInitTrackingPage(id);
      }
      return;
    }
    showPublicPage();
  }

  window.addEventListener('hashchange', function () {
    if ((window.location.hash || '') === '#admin') showAdminPage();
    else if ((window.location.hash || '') === '#home') showPublicPage();
  });

  window.addEventListener('popstate', function () {
    routeFromUrl();
  });

  // Initial route after all scripts defined — delay slightly so tracking init exists
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      setTimeout(routeFromUrl, 0);
    });
  } else {
    setTimeout(routeFromUrl, 0);
  }
})();
</script>

</body>
</html>
