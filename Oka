  const COUNTRY_CODE_MAP = {
    'nigeria':'ng','united kingdom':'gb','uk':'gb','great britain':'gb','england':'gb','scotland':'gb','wales':'gb',
    'united states':'us','usa':'us','us':'us','united states of america':'us','america':'us',
    'canada':'ca','china':'cn','india':'in','pakistan':'pk','bangladesh':'bd','japan':'jp','south korea':'kr','korea':'kr',
