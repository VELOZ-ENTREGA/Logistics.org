    window.addEventListener('scroll', toggleScrollTopBtn, { passive: true });
    scrollTopBtn.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // Duplicate the photo strip once at runtime so it loops seamlessly,
  // without doubling the images inside the page source.
  var track = document.getElementById('photoStripTrack');
  if (track) { track.innerHTML += track.innerHTML; }

  // Fade/slide in gallery + banner elements as they enter the viewport.
  var targets = document.querySelectorAll('.reveal-up');
  if ('IntersectionObserver' in window && targets.length) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    targets.forEach(function (el) { io.observe(el); });
  } else {
    targets.forEach(function (el) { el.classList.add('is-visible'); });
  }
})();
</script>

