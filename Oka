<script>
(function(){

// ═══════════════════════════════════════════════════
// CONFIG — CREDENTIALS
// ═══════════════════════════════════════════════════
const JSONBIN_BIN_ID    = '6a722488f5f4af5e29eaf0a1';
const JSONBIN_MASTER_KEY= '$2a$10$IcANNBnxATNH82Dp9yKY2eqpeRU7M4F5Lu60qb9GYNUEsyrZ60A6y';
const JSONBIN_BASE       = 'https://api.jsonbin.io/v3/b/' + JSONBIN_BIN_ID;

const SESSION_KEY = 'gd_admin_session';
const SESSION_USER_KEY = 'gd_admin_session_user';
const CREDS_KEY   = 'gd_admin_creds_v2';
const ADMIN33_CREDS_KEY = 'gd_admin33_creds_v1';
let currentAdminId = 'default';
const TRACK_URL_KEY = 'gd_track_base_url';

// 9-stage customer-facing tracking journey
const STAGES = ['Shipment Created','Picked Up','Warehouse','Airport','Customs',
  'Destination Country','Local Distribution','Out for Delivery','Delivered'];

function getTrackBaseUrl() {
  const saved = localStorage.getItem(TRACK_URL_KEY);
  if (saved) return saved;
  // Same single-file page — shareable links use ?id=
  return window.location.origin + window.location.pathname;
}
function saveTrackBaseUrl() {
  const v = document.getElementById('trackBaseUrl').value.trim();
  if (v) localStorage.setItem(TRACK_URL_KEY, v);
  const ok = document.getElementById('trackUrlOk');
  ok.style.display = 'block';
  setTimeout(() => ok.style.display = 'none', 2500);
  showToast('Tracking page URL saved', 'success');
}
function buildTrackLink(id) {
  return getTrackBaseUrl() + '?id=' + encodeURIComponent(id);
}

function populateStageSelects() {
  ['u_status','f_status'].forEach(selId => {
    const sel = document.getElementById(selId);
    sel.innerHTML = STAGES.map(s => `<option value="${s}">${s}</option>`).join('');
  });
  document.getElementById('f_status').value = 'Shipment Created';
}
populateStageSelects();

function getCreds() {
  try {
    if (currentAdminId === 'admin33') return JSON.parse(localStorage.getItem(ADMIN33_CREDS_KEY)) || { user:'admin 33', pass:'001155' };
    return JSON.parse(localStorage.getItem(CREDS_KEY)) || { user:'Admin-Velox1', pass:'202465' };
  } catch(e) {
    return currentAdminId === 'admin33' ? { user:'admin 33', pass:'001155' } : { user:'Admin-Velox1', pass:'202465' };
  }
}
function saveCreds(c) {
  if (currentAdminId === 'admin33') localStorage.setItem(ADMIN33_CREDS_KEY, JSON.stringify(c));
  else localStorage.setItem(CREDS_KEY, JSON.stringify(c));
}

window.login = function login() {
  const u = document.getElementById('username').value.trim();
  const p = document.getElementById('password').value;
  const stored33 = (() => { try { return JSON.parse(localStorage.getItem(ADMIN33_CREDS_KEY)) || {pass:'001155'}; } catch(e) { return {pass:'001155'}; } })();
  const isAdmin33 = u.toLowerCase() === 'admin 33' && p === stored33.pass;
  currentAdminId = isAdmin33 ? 'admin33' : 'default';
  const creds = getCreds();
  if (isAdmin33 || (u === creds.user && p === creds.pass)) {
    sessionStorage.setItem(SESSION_KEY, '1');
    sessionStorage.setItem(SESSION_USER_KEY, currentAdminId);
    document.getElementById('loginError').style.display = 'none';
    showAdmin();
  } else {
    document.getElementById('loginError').style.display = 'block';
  }
}
function logout() {
  sessionStorage.removeItem(SESSION_KEY);
  sessionStorage.removeItem(SESSION_USER_KEY);
  currentAdminId = 'default';
  document.getElementById('loginScreen').style.display = 'flex';
  document.getElementById('adminShell').style.display = 'none';
  document.getElementById('password').value = '';
}
const FRESH_START_KEY = 'gd_fresh_start_20260710';
async function freshStartIfNeeded() {
  // Intentionally disabled — never wipe remote JSONBin data on login.
  // Shipments must remain visible across browsers via the shared bin.
  return;
}

async function showAdmin() {
  currentAdminId = sessionStorage.getItem(SESSION_USER_KEY) === 'admin33' ? 'admin33' : 'default';
  document.getElementById('loginScreen').style.display = 'none';
  document.getElementById('adminShell').style.display = 'block';
  document.getElementById('currentUser').textContent = getCreds().user;
  document.getElementById('settingsUser').textContent = getCreds().user;
  document.getElementById('trackBaseUrl').value = getTrackBaseUrl();
  await freshStartIfNeeded();
  loadShipments();
}
document.getElementById('password').addEventListener('keydown', e => { if(e.key==='Enter') login(); });
document.getElementById('username').addEventListener('keydown', e => { if(e.key==='Enter') login(); });
if (sessionStorage.getItem(SESSION_KEY) === '1') {
  currentAdminId = sessionStorage.getItem(SESSION_USER_KEY) === 'admin33' ? 'admin33' : 'default';
  showAdmin();
}

function changePassword() {
  const cur  = document.getElementById('pwd_current').value;
  const nw   = document.getElementById('pwd_new').value;
  const conf = document.getElementById('pwd_confirm').value;
  const ok   = document.getElementById('pwdOk');
  const err  = document.getElementById('pwdErr');
  ok.style.display = 'none'; err.style.display = 'none';
  const creds = getCreds();
  if (cur !== creds.pass) { err.textContent = '❌ Current password is incorrect.'; err.style.display = 'block'; return; }
  if (nw.length < 6)      { err.textContent = '❌ New password must be at least 6 characters.'; err.style.display = 'block'; return; }
  if (nw !== conf)         { err.textContent = '❌ Passwords do not match.'; err.style.display = 'block'; return; }
  saveCreds({ user: creds.user, pass: nw });
  document.getElementById('pwd_current').value = '';
  document.getElementById('pwd_new').value = '';
  document.getElementById('pwd_confirm').value = '';
  ok.style.display = 'block';
  showToast('Password updated successfully!', 'success');
}

const TAB_META = {
  dashboard: ['Dashboard','Overview of all shipping activity'],
  shipments: ['Shipments','Manage and update every shipment'],
  create:    ['New Shipment','Register a new shipment and notify the customer'],
  customers: ['Customers','Everyone who has shipped with you'],
  reports:   ['Reports','Performance and volume insights'],
  settings:  ['Settings','Account and tracking page configuration'],
};

function switchTab(name, el) {
  document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  document.getElementById('tab-' + name).classList.add('active');
  if (el) el.classList.add('active');
  else document.querySelector(`.nav-item[data-tab="${name}"]`).classList.add('active');
  const meta = TAB_META[name];
  if (meta) {
    document.getElementById('topbarTitle').textContent = meta[0];
    document.getElementById('topbarSub').textContent = meta[1];
  }
  document.getElementById('sidebar').classList.remove('open');
  if (name === 'dashboard') renderDashboard();
  if (name === 'customers') renderCustomers();
  if (name === 'reports') renderReports();
}
function switchTabByName(name) { switchTab(name, document.querySelector(`.nav-item[data-tab="${name}"]`)); }

function showToast(msg, type='info') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast ' + type + ' show';
  setTimeout(() => t.classList.remove('show'), 3500);
}

async function fetchBin() {
  const r = await fetch(JSONBIN_BASE + '/latest', {
    headers: { 'X-Master-Key': JSONBIN_MASTER_KEY }
  });
  if (!r.ok) throw new Error('Unable to load shipment store (' + r.status + ')');
  const d = await r.json();
  return d.record || { shipments: {}, adminShipments: {} };
}
async function saveBin(data) {
  const record = await fetchBin();
  const bucket = data.shipments || {};
  if (currentAdminId === 'admin33') {
    record.adminShipments = record.adminShipments || {};
    record.adminShipments.admin33 = bucket;
  } else {
    record.shipments = bucket;
  }
  const r = await fetch(JSONBIN_BASE, {
    method: 'PUT',
    headers: { 'Content-Type':'application/json', 'X-Master-Key': JSONBIN_MASTER_KEY },
    body: JSON.stringify(record)
  });
  if (!r.ok) throw new Error('Unable to save shipment store (' + r.status + ')');
}

let allShipments = {};
let selectedId   = null;
let lastCreated  = null;

async function loadShipments() {
  showToast('Loading shipments…', 'info');
  try {
    const data = await fetchBin();
    allShipments = currentAdminId === 'admin33'
      ? ((data.adminShipments || {}).admin33 || {})
      : (data.shipments || {});
    renderList();
    updateStats();
    renderDashboard();
    if (document.getElementById('tab-customers').classList.contains('active')) renderCustomers();
    if (document.getElementById('tab-reports').classList.contains('active')) renderReports();
    if (selectedId) renderDetail();
    showToast('Shipments loaded ✓', 'success');
  } catch(e) {
    showToast('Failed to load shipments. Check connection.', 'error');
  }
}

function generateTrackingId() {
  const year = new Date().getFullYear();
  const prefix = currentAdminId === 'admin33' ? `VELOZ-${year}-33-` : `VELOZ-${year}-`;
  let id = prefix + Math.floor(10000 + Math.random() * 90000);
  while (allShipments[id]) {
    id = prefix + Math.floor(10000 + Math.random() * 90000);
  }
  return id;
}

async function createShipment() {
  const get = id => document.getElementById(id).value.trim();
  const required = [
    ['f_senderName','Sender Name'],['f_senderPhone','Sender Phone'],
    ['f_senderEmail','Sender Email'],['f_origin','Sender Location'],
    ['f_senderAddress','Sender Street Address'],['f_senderCountry','Sender Country'],
    ['f_receiverName','Receiver Name'],['f_receiverPhone','Receiver Phone'],
    ['f_receiverEmail','Receiver Email'],['f_destination','Receiver Location'],
    ['f_receiverAddress','Receiver Street Address'],['f_receiverCountry','Receiver Country'],
    ['f_goods','Goods Description'],['f_weight','Weight'],
    ['f_dateShipped','Date Shipped'],['f_eta','Expected Delivery Date'],
    ['f_amount','Amount to be Paid'],
  ];
  for (const [id, label] of required) {
    if (!get(id)) { showToast(`Please fill in: ${label}`, 'error'); return; }
  }
  const btn = document.getElementById('createBtn');
  btn.innerHTML = '<span class="spinner"></span> Creating…';
  btn.disabled = true;

  const id = generateTrackingId();
  const nowIso = new Date().toISOString();
  const initialStage = document.getElementById('f_status').value || 'Shipment Created';
  const shipment = {
    id,
    senderName   : get('f_senderName'),
    senderPhone  : get('f_senderPhone'),
    senderEmail  : get('f_senderEmail'),
    origin       : get('f_origin'),
    senderAddress: get('f_senderAddress'),
    senderCountry: get('f_senderCountry'),
    receiverName : get('f_receiverName'),
    receiverPhone: get('f_receiverPhone'),
    receiverEmail: get('f_receiverEmail'),
    destination  : get('f_destination'),
    receiverAddress: get('f_receiverAddress'),
    receiverCountry: get('f_receiverCountry'),
    goods        : get('f_goods'),
    itemType     : get('f_itemType'),
    weight       : get('f_weight'),
    quantity     : get('f_quantity') || '1',
    declaredValue: get('f_value') || 'N/A',
    amountToPay  : get('f_amount') || 'N/A',
    amountPaid   : '$0',
    paymentNote  : '',
    dateShipped  : get('f_dateShipped'),
    eta          : get('f_eta'),
    status       : initialStage,
    service      : document.getElementById('f_service').value,
    readyForPickup: false,
    notes        : get('f_notes') || 'None',
    currentLocation: get('f_currentLocation') || get('f_origin'),
    created      : nowIso,
    history      : [{ location: get('f_origin'), status: initialStage, time: nowIso, note: 'Shipment registered with VELOZ ENTREGA LOGISTICS.' }]
  };

  allShipments[id] = shipment;
  lastCreated = shipment;

  try {
    await saveBin({ shipments: allShipments });
    showTrackPanel(id);
    resetCreateForm();
    renderList();
    updateStats();
    renderDashboard();
    showToast('Shipment created: ' + id, 'success');
  } catch(e) {
    showToast('Error saving shipment. Please try again.', 'error');
  }
  btn.innerHTML = 'Generate Tracking ID & Create Shipment';
  btn.disabled = false;
}

function showTrackPanel(id) {
  const link = buildTrackLink(id);
  document.getElementById('newIdValue').textContent = id;
  document.getElementById('newTrackLink').value = link;
  document.getElementById('newQr').src = 'https://api.qrserver.com/v1/create-qr-code/?size=140x140&margin=4&data=' + encodeURIComponent(link);
  document.getElementById('newTrackPanel').classList.add('show');
}

function resetCreateForm() {
  ['f_senderName','f_senderPhone','f_senderEmail','f_origin','f_senderAddress','f_senderCountry',
   'f_receiverName','f_receiverPhone','f_receiverEmail','f_destination','f_receiverAddress','f_receiverCountry',
   'f_goods','f_weight','f_quantity','f_value','f_amount','f_dateShipped','f_eta','f_notes','f_currentLocation']
    .forEach(id => document.getElementById(id).value = '');
  document.getElementById('f_itemType').value = '';
  document.getElementById('f_status').value = 'Shipment Created';
  document.getElementById('f_service').value = 'International Air Express';
}

function copyNewId() {
  navigator.clipboard.writeText(document.getElementById('newIdValue').textContent)
    .then(() => showToast('Tracking ID copied!', 'success'));
}
function copyTrackLink(inputId) {
  const el = document.getElementById(inputId);
  navigator.clipboard.writeText(el.value).then(() => showToast('Tracking link copied!', 'success'));
}
function openTrackLink() {
  window.open(document.getElementById('newTrackLink').value, '_blank');
}

function updateStats() {
  const all = Object.values(allShipments);
  document.getElementById('statTotal').textContent     = all.length;
  document.getElementById('statTransit').textContent   = all.filter(s => {
    const i = STAGES.indexOf(s.status);
    return i > 0 && i < STAGES.length - 1;
  }).length;
  document.getElementById('statDelivered').textContent = all.filter(s => s.status === 'Delivered').length;
  document.getElementById('statPending').textContent   = all.filter(s => s.status === 'Shipment Created').length;
}

function renderList(filter='') {
  const list = Object.values(allShipments)
    .filter(s => !filter || JSON.stringify(s).toLowerCase().includes(filter.toLowerCase()))
    .sort((a,b) => new Date(b.created) - new Date(a.created));
  const container = document.getElementById('shipList');
  const empty     = document.getElementById('shipEmpty');
  container.innerHTML = '';
  if (list.length === 0) { empty.style.display = 'block'; return; }
  empty.style.display = 'none';
  list.forEach(s => container.appendChild(buildShipCard(s)));
}

function buildShipCard(s, onClickOverride) {
  const div = document.createElement('div');
  div.className = 'ship-card' + (s.id === selectedId ? ' active' : '');
  div.onclick = onClickOverride || (() => selectShipment(s.id));
  div.innerHTML = `
    <div class="top">
      <span class="id">${esc(s.id)}</span>
      <span class="status-badge ${statusClass(s.status)}">${esc(s.status)}</span>
    </div>
    <div class="route">${esc(s.origin)} → ${esc(s.destination)}</div>
    <div class="route" style="margin-top:3px;">📦 ${esc(s.goods)} · 👤 ${esc(s.receiverName)}</div>
    <div class="ship-card-actions">
      <button type="button" class="mini-btn" onclick="event.stopPropagation(); viewShipmentCard('${esc(s.id)}')">👁 View</button>
      <button type="button" class="mini-btn mini-green" onclick="event.stopPropagation(); downloadInvoiceCard('${esc(s.id)}')">⬇ Invoice</button>
      <button type="button" class="mini-btn mini-danger" onclick="event.stopPropagation(); deleteShipmentCard('${esc(s.id)}')">🗑 Delete</button>
    </div>
  `;
  return div;
}

function viewShipmentCard(id) {
  selectShipment(id);
}

function downloadInvoiceCard(id) {
  const s = allShipments[id];
  if (s) generateInvoice(s);
  else showToast('Shipment not found.', 'error');
}

async function deleteShipmentCard(id) {
  const s = allShipments[id];
  if (!s) return;
  if (!confirm('Delete shipment ' + id + '? This cannot be undone.')) return;

  // Remove locally and refresh the UI immediately so it's visibly gone right away
  delete allShipments[id];
  if (selectedId === id) selectedId = null;
  const searchVal = document.querySelector('#tab-shipments .search-bar') ? document.querySelector('#tab-shipments .search-bar').value : '';
  renderList(searchVal);
  renderDetail();
  updateStats();
  renderDashboard();
  showToast('Shipment deleted.', 'info');

  // Persist the change to the backend
  try {
    await saveBin({ shipments: allShipments });
  } catch (e) {
    showToast('Deleted locally, but failed to sync — check connection.', 'error');
  }
}

async function clearAllShipments() {
  if (!confirm('Delete ALL shipments? This cannot be undone.')) return;
  allShipments = {};
  selectedId = null;
  renderList();
  renderDetail();
  updateStats();
  renderDashboard();
  showToast('All shipments deleted.', 'info');
  try {
    await saveBin({ shipments: {} });
  } catch (e) {
    showToast('Cleared locally, but failed to sync — check connection.', 'error');
  }
}

function filterShipments(q) { renderList(q); }

function selectShipment(id) {
  selectedId = id;
  renderList(document.querySelector('#tab-shipments .search-bar').value);
  renderDetail();
  switchTabByName('shipments');
}

function renderDetail() {
  const s = allShipments[selectedId];
  const empty   = document.getElementById('detailEmpty');
  const content = document.getElementById('detailContent');
  if (!s) { empty.style.display = 'block'; content.style.display = 'none'; selectedId = null; return; }
  empty.style.display = 'none';
  content.style.display = 'block';

  setText('d_id', s.id);
  setText('d_beneficiary', 'For ' + s.receiverName + ' · ' + s.receiverEmail);
  const badge = document.getElementById('d_statusBadge');
  badge.textContent = s.status;
  badge.className = 'status-badge ' + statusClass(s.status);

  document.getElementById('d_trackLink').value = buildTrackLink(s.id);

  document.getElementById('d_timeline').innerHTML = renderTimelineHtml(s);

  setText('d_senderName',   s.senderName);
  setText('d_senderPhone',  s.senderPhone);
  setText('d_senderEmail',  s.senderEmail);
  setText('d_senderAddress',s.senderAddress);
  setText('d_senderCountry',s.senderCountry);
  setText('d_origin',       s.origin);
  setText('d_receiverName', s.receiverName);
  setText('d_receiverPhone',s.receiverPhone);
  setText('d_receiverEmail',s.receiverEmail);
  setText('d_receiverAddress',s.receiverAddress);
  setText('d_receiverCountry',s.receiverCountry);
  setText('d_destination',  s.destination);
  setText('d_currentLocation', s.currentLocation || s.origin || '—');
  setText('d_goods',        s.goods);
  setText('d_weight',       s.weight);
  setText('d_itemType',     s.itemType || '—');
  setText('d_quantity',     s.quantity || '—');
  setText('d_service',      s.service || '—');
  setText('d_dateShipped',  fmtDateOnly(s.dateShipped));
  setText('d_eta',          fmtDateOnly(s.eta));
  setText('d_notes',        s.notes || '—');
  setText('d_pickup',       s.readyForPickup ? '✅ Yes' : 'No');

  const totalAmt = parseMoney(s.amountToPay);
  const paidAmt  = parseMoney(s.amountPaid) || 0;
  const balance  = totalAmt != null ? Math.max(totalAmt - paidAmt, 0) : null;
  const payStatus = (totalAmt != null && totalAmt > 0 && paidAmt >= totalAmt) ? 'Paid'
    : (paidAmt > 0 ? 'Partial' : 'Unpaid');

  setText('d_amountToPay', s.amountToPay || 'N/A');
  setText('d_amountPaid',  fmtMoney(paidAmt));
  setText('d_balanceDue',  balance != null ? fmtMoney(balance) : 'N/A');
  const payBadge = document.getElementById('d_paymentBadge');
  payBadge.textContent = payStatus;
  payBadge.className = 'status-badge ' + (payStatus === 'Paid' ? 'delivered' : payStatus === 'Partial' ? 'customs' : 'pending');
  setText('d_paymentNote', s.paymentNote || '—');

  document.getElementById('u_amountToPay').value = (s.amountToPay && s.amountToPay !== 'N/A') ? s.amountToPay : '';
  document.getElementById('u_amountPaid').value  = (s.amountPaid && s.amountPaid !== '$0') ? s.amountPaid : '';
  document.getElementById('u_paymentNote').value = s.paymentNote || '';

  document.getElementById('u_location').value = s.currentLocation || '';
  document.getElementById('u_note').value = '';
  document.getElementById('u_status').value   = s.status;
  document.getElementById('u_pickup').checked  = !!s.readyForPickup;

  const histEl = document.getElementById('d_history');
  histEl.innerHTML = '';
  const items = (s.history || []).slice().reverse();
  if (items.length === 0) {
    histEl.innerHTML = `<div class="detail-row"><span class="k">Shipment created</span><span class="v">${fmtDate(s.created)}</span></div>`;
  } else {
    items.forEach(h => {
      const div = document.createElement('div');
      div.className = 'detail-row';
      div.innerHTML = `<span class="k">${esc(h.location)} <span style="color:var(--sky-accent);">[${esc(h.status||'')}]</span>${h.note ? '<br><span style="font-size:0.78rem;color:var(--slate);">'+esc(h.note)+'</span>' : ''}</span><span class="v" style="font-weight:500;">${fmtDate(h.time)}</span>`;
      histEl.appendChild(div);
    });
  }
}

function renderTimelineHtml(s) {
  const curIdx = STAGES.indexOf(s.status);
  const stageTimes = {};
  const stageNotes = {};
  (s.history || []).forEach(h => {
    if (STAGES.includes(h.status)) { stageTimes[h.status] = h.time; stageNotes[h.status] = h.note; }
  });
  if (!stageTimes['Shipment Created']) stageTimes['Shipment Created'] = s.created;

  return STAGES.map((stage, i) => {
    const done = curIdx >= 0 && i <= curIdx;
    const isCurrent = i === curIdx;
    const time = stageTimes[stage];
    const note = stageNotes[stage];
    return `<div class="tl-item ${done ? 'done' : ''} ${isCurrent ? 'current' : ''}">
      <div class="tl-check">${done ? '✔' : ''}</div>
      <div class="tl-body">
        <div class="tl-label">${esc(stage)}</div>
        ${time ? `<div class="tl-time">${fmtDate(time)}</div>` : ''}
        ${note ? `<div class="tl-note">${esc(note)}</div>` : ''}
      </div>
    </div>`;
  }).join('');
}

async function addLocationUpdate() {
  if (!selectedId) return;
  const location = document.getElementById('u_location').value.trim();
  const status   = document.getElementById('u_status').value;
  const note     = document.getElementById('u_note').value.trim();
  const pickup   = document.getElementById('u_pickup').checked;
  const s = allShipments[selectedId];
  if (!s) return;
  s.history = s.history || [];
  s.history.push({ location: location || s.destination || s.origin, status, time: new Date().toISOString(), note });
  s.status = status;
  if (location) s.currentLocation = location;
  s.readyForPickup = pickup;
  try {
    await saveBin({ shipments: allShipments });
    renderList(document.querySelector('#tab-shipments .search-bar').value);
    renderDetail();
    updateStats();
    showToast('Tracking updated to "' + status + '" ✓', 'success');
  } catch(e) {
    showToast('Error saving update.', 'error');
  }
}

async function updatePayment() {
  if (!selectedId) return;
  const s = allShipments[selectedId];
  if (!s) return;
  const amountToPay = document.getElementById('u_amountToPay').value.trim();
  const amountPaid  = document.getElementById('u_amountPaid').value.trim();
  const paymentNote = document.getElementById('u_paymentNote').value.trim();
  s.amountToPay = amountToPay || s.amountToPay || 'N/A';
  s.amountPaid  = amountPaid || '$0';
  s.paymentNote = paymentNote;
  try {
    await saveBin({ shipments: allShipments });
    renderDetail();
    renderList(document.querySelector('#tab-shipments .search-bar').value);
    showToast('Payment info updated ✓', 'success');
  } catch(e) {
    showToast('Error saving payment update.', 'error');
  }
}

async function deleteShipment() {
  if (!selectedId) return;
  if (!confirm('Delete shipment ' + selectedId + '? This cannot be undone.')) return;
  const id = selectedId;
  delete allShipments[id];
  selectedId = null;
  renderList();
  renderDetail();
  updateStats();
  renderDashboard();
  showToast('Shipment deleted.', 'info');
  try {
    await saveBin({ shipments: allShipments });
  } catch(e) {
    showToast('Deleted locally, but failed to sync — check connection.', 'error');
  }
}

function downloadLastInvoice() {
  if (lastCreated) generateInvoice(lastCreated);
  else showToast('No shipment to generate invoice for.', 'error');
}
function downloadInvoice() {
  const s = allShipments[selectedId];
  if (s) generateInvoice(s);
