}
@keyframes cargoGrow { from { filter: brightness(0.92); } to { filter: brightness(1.08); } }

/* ── GOODS CATALOG ──────────────────────────────────── */
.goods-carousel {
  position: relative;
  max-width: 460px; margin: 0 auto;
}
.goods-track { position: relative; width: 100%; aspect-ratio: 1 / 0.92; }
.goods-card {
  position: absolute; inset: 0;
  background: var(--offwhite); border-radius: 14px; padding: 0;
  text-align: left; border: 1px solid var(--grey);
  overflow: hidden;
  opacity: 0; pointer-events: none; transform: scale(0.96);
  transition: opacity 1.1s ease-in-out, transform 1.1s ease-in-out, border-color 0.3s ease, box-shadow 0.3s ease;
}
.goods-card.is-active { opacity: 1; pointer-events: auto; transform: scale(1); z-index: 1; box-shadow: var(--shadow-lg); border-color: var(--gold); }
.goods-photo {
  position: absolute; inset: 0;
  width: 100%; height: 100%; object-fit: cover;
  transform: scale(1.02);
  transition: transform 7s ease-out;
}
.goods-card.is-active .goods-photo { transform: scale(1.1); }
.goods-scrim {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(10,25,48,0) 22%, rgba(10,25,48,0.55) 58%, rgba(10,25,48,0.95) 100%);
  pointer-events: none;
}
.goods-caption {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
  padding: 18px 22px 20px;
}
.goods-num {
  display: block;
  font-family: var(--font-head); font-style: italic; font-weight: 700;
  font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--gold2); margin-bottom: 5px;
}
.goods-card h5 {
  font-family: var(--font-head); font-weight: 700;
  font-size: clamp(1.2rem, 3vw, 1.6rem); letter-spacing: 0.005em;
  color: var(--white);
  text-shadow: 0 2px 10px rgba(0,0,0,0.45);
}
.goods-divider {
  width: 30px; height: 2px; background: var(--gold);
  margin: 8px 0 0;
}
.goods-desc {
  font-family: var(--font-body);
  font-size: 0.86rem; line-height: 1.5;
  color: rgba(255,255,255,0.88);
  margin-top: 10px; max-width: 380px;
  text-shadow: 0 1px 6px rgba(0,0,0,0.4);
}
.goods-count {
  position: absolute; top: 12px; right: 14px; z-index: 2;
  color: var(--navy); opacity: 0.55; font-size: 0.78rem; font-weight: 600;
}
.goods-arrow {
  position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
  width: 38px; height: 38px; border-radius: 50%;
  background: var(--white);
  border: 1px solid var(--grey);
  color: var(--navy); font-size: 1.1rem;
  display: grid; place-items: center; cursor: pointer;
  transition: border-color 0.25s ease, transform 0.25s ease;
}
.goods-arrow:hover { border-color: var(--gold); transform: translateY(-50%) scale(1.08); }
.goods-arrow.prev { left: -50px; }
.goods-arrow.next { right: -50px; }
.goods-dots {
  display: flex; justify-content: center; flex-wrap: wrap; gap: 8px;
  padding: 18px 0 0;
}
.goods-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--grey); border: none; cursor: pointer;
  padding: 0; transition: background 0.25s ease, transform 0.25s ease;
}
.goods-dot.is-active { background: var(--gold); transform: scale(1.3); }
@media (max-width: 560px) {
  .goods-arrow.prev { left: 0; }
  .goods-arrow.next { right: 0; }
}

/* ── REVIEWS ────────────────────────────────────────── */
.reviews-track-wrap { overflow: hidden; max-width: 1800px; margin: 0 auto; }
.reviews-track {
  display: flex; gap: 20px;
  animation: reviewsScroll 30s linear infinite;
  width: max-content;
}
.review-card {
  background: var(--white); border: 1.5px solid var(--grey); border-radius: 8px;
