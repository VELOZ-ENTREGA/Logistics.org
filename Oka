.btn-contact:disabled { background: var(--mid); cursor: not-allowed; transform: none; }

.cf-error {
  font-size: 0.82rem; color: var(--red);
  background: rgba(214,69,69,0.07); border: 1px solid rgba(214,69,69,0.2);
  padding: 10px 14px; border-radius: var(--radius); margin-bottom: 12px;
}
.cf-disclaimer {
  font-size: 0.74rem; color: var(--mid); text-align: center;
  margin-top: 12px; line-height: 1.5;
}

/* Success state */
.contact-success {
  text-align: center; padding: 32px 16px;
}
.success-icon { font-size: 2.5rem; margin-bottom: 12px; }
.contact-success strong {
  display: block; font-family: var(--font-head); font-size: 1.4rem;
  font-weight: 800; color: var(--navy); margin-bottom: 10px;
}
.contact-success p { font-size: 0.9rem; color: var(--mid); line-height: 1.65; }

@media (max-width: 900px) {
  .contact-inner { grid-template-columns: 1fr; gap: 40px; }
  .cf-row { grid-template-columns: 1fr; }
