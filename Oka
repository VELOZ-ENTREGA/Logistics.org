/* ── CHAT WIDGET ────────────────────────────────────── */
/* Fixed to the bottom-right of the viewport; stays put while scrolling
   and softens (fades) while the visitor is actively scrolling so it
   doesn't obstruct the content being read. */
.chat-widget {
  position: fixed; right: 26px; bottom: 132px; top: auto;
  transform: none;
  z-index: 9000; font-family: var(--font-body);
  transition: opacity 0.4s ease;
}
.chat-widget.is-scrolling { opacity: 0.42; }
.chat-widget.is-scrolling:hover { opacity: 1; }

.chat-widget-toggle {
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(16px) saturate(180%);
  -webkit-backdrop-filter: blur(16px) saturate(180%);
  color: var(--navy);
  border: 1px solid rgba(255,255,255,0.5); border-radius: 50%; cursor: pointer;
  width: 74px; height: 74px; padding: 0;
  box-shadow: var(--shadow-lg);
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.chat-widget-toggle:hover { transform: scale(1.06); box-shadow: 0 16px 40px rgba(0,0,0,0.28); background: rgba(255,255,255,0.7); }
.chat-widget-toggle .cw-icon-wrap {
  width: 44px; height: 44px; border-radius: 50%;
  background: rgba(30,136,229,0.85);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; position: relative;
}
.chat-widget-toggle .cw-icon-wrap svg { width: 21px; height: 21px; }
.chat-widget-toggle .cw-ping {
  position: absolute; top: 0; right: 0; width: 13px; height: 13px;
  background: var(--green); border-radius: 50%; border: 2px solid var(--white);
}
.chat-widget-toggle .cw-close-icon { display: none; width: 20px; height: 20px; }

/* Container-free vertical stack of channel icons — opens upward,
   centered against the toggle button, so each icon floats on its own.
   (Toggle is sized larger than each popped-out icon on purpose.) */
.chat-widget-panel {
  position: absolute; right: 11px; bottom: calc(100% + 16px);
  display: flex; flex-direction: column; align-items: center; gap: 13px;
  opacity: 0; visibility: hidden; pointer-events: none;
  transition: opacity 0.2s ease, visibility 0.2s;
}
.chat-widget.open .chat-widget-panel { opacity: 1; visibility: visible; pointer-events: auto; }
.chat-widget.open .chat-widget-toggle .cw-icon-wrap svg.cw-chat-icon { display: none; }
.chat-widget.open .chat-widget-toggle .cw-close-icon { display: block; }
.chat-widget.open .chat-widget-toggle .cw-ping { display: none; }

/* Each channel is just its symbol — no card, border or label */
.cw-option {
  display: flex; align-items: center; justify-content: center;
  width: 46px; height: 46px; border-radius: 50%;
  backdrop-filter: blur(8px) saturate(160%);
  -webkit-backdrop-filter: blur(8px) saturate(160%);
  border: 1px solid rgba(255,255,255,0.35);
  box-shadow: 0 8px 20px rgba(0,0,0,0.24);
  cursor: pointer; position: relative;
  opacity: 0; transform: translateY(14px) scale(0.85);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
/* Staggered, elastic pop-in entrance whenever the panel opens —
   a livelier launch with a touch of rotation and blur for polish */
.chat-widget.open .cw-option {
  animation: cwPopIn 0.55s cubic-bezier(0.68, -0.4, 0.27, 1.4) forwards;
}
.chat-widget.open .cw-option:nth-child(1) { animation-delay: 0.04s; }
.chat-widget.open .cw-option:nth-child(2) { animation-delay: 0.1s; }
.chat-widget.open .cw-option:nth-child(3) { animation-delay: 0.16s; }
.chat-widget.open .cw-option:nth-child(4) { animation-delay: 0.22s; }
@keyframes cwPopIn {
  0% { opacity: 0; transform: translateY(20px) scale(0.35) rotate(-20deg); filter: blur(3px); }
  55% { opacity: 1; filter: blur(0); }
  70% { transform: translateY(-4px) scale(1.1) rotate(5deg); }
  100% { opacity: 1; transform: translateY(0) scale(1) rotate(0deg); }
}
.cw-option:hover {
  transform: translateY(-4px) scale(1.14);
  box-shadow: 0 14px 30px rgba(0,0,0,0.36);
}
.cw-option svg { width: 22px; height: 22px; transition: transform 0.35s ease; }
.cw-option:hover svg { animation: cwIconWiggle 0.5s ease; }
@keyframes cwIconWiggle {
  0%, 100% { transform: scale(1) rotate(0deg); }
  30% { transform: scale(1.16) rotate(-9deg); }
  60% { transform: scale(1.06) rotate(7deg); }
}
.cw-option.cw-line { background: rgba(0,185,0,0.82); }

/* Small tooltip label on hover, since the icons carry no text of their own */
.cw-option::after {
  content: attr(data-label);
  position: absolute; right: calc(100% + 10px); top: 50%; transform: translateY(-50%) translateX(4px);
  background: rgba(10,25,48,0.7);
  backdrop-filter: blur(10px) saturate(160%);
  -webkit-backdrop-filter: blur(10px) saturate(160%);
  color: var(--white); font-size: 0.68rem; font-weight: 600;
  padding: 4px 9px; border-radius: 6px; white-space: nowrap;
  border: 1px solid rgba(79,168,255,0.18);
  opacity: 0; visibility: hidden; pointer-events: none;
  transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
}
.cw-option:hover::after { opacity: 1; visibility: visible; transform: translateY(-50%) translateX(0); }

@media (max-width: 480px) {
  .chat-widget { right: 14px; bottom: 108px; }
  .chat-widget-toggle { width: 62px; height: 62px; }
  .chat-widget-toggle .cw-icon-wrap { width: 37px; height: 37px; }
  .cw-option { width: 42px; height: 42px; }
  .cw-option::after { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .cw-option, .chat-widget.open .cw-option { animation: none !important; opacity: 1; transform: none; }
  .cw-option:hover svg { animation: none; }
  .chat-widget.is-scrolling { opacity: 1; }
}

