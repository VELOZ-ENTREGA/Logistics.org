.stat-card.green{border-top-color:var(--green);}
.stat-card.slate{border-top-color:var(--slate);}
.stat-card.amber{border-top-color:#C99A2E;}
.stat-card .val{font-family:'Space Grotesk',sans-serif;font-size:2rem;font-weight:700;color:var(--ink);}
.stat-card .lbl{font-size:0.78rem;color:var(--slate);text-transform:uppercase;letter-spacing:0.06em;margin-top:4px;}
.spinner{display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,0.3);
  border-top-color:#fff;border-radius:50%;animation:spin 0.7s linear infinite;vertical-align:middle;margin-right:6px;}
@keyframes spin{to{transform:rotate(360deg);}}

/* ===== TIMELINE (dark card, matches reference) ===== */
.timeline-card{background:linear-gradient(180deg,#15161b,#0c0d11);border-radius:18px;padding:24px 22px;
  color:#fff;border:1px solid rgba(255,255,255,0.06);}
.timeline-card .tl-title{font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:rgba(255,255,255,0.45);
