function countryCodeFromLocation(str) {
  if (!str) return null;
  const parts = String(str).split(',').map(p => p.trim().toLowerCase()).filter(Boolean);
  for (let i = parts.length - 1; i >= 0; i--) {
    if (COUNTRY_CODE_MAP[parts[i]]) return COUNTRY_CODE_MAP[parts[i]];
  }
  const whole = String(str).trim().toLowerCase();
  return COUNTRY_CODE_MAP[whole] || null;
}
async function fetchFlagPNG(countryCode, widthMM) {
  if (!countryCode) return null;
  try {
    const img = await new Promise((resolve, reject) => {
      const im = new Image();
      im.crossOrigin = 'anonymous';
      im.onload = () => resolve(im);
      im.onerror = reject;
      im.src = 'https://flagcdn.com/w320/' + countryCode + '.png';
    });
    const DPI = 300, PXMM = DPI / 25.4;
    const wpx = Math.round(widthMM * PXMM);
    const hpx = Math.round(wpx * (img.height / img.width));
    const c = document.createElement('canvas');
    c.width = wpx; c.height = hpx;
    const ctx = c.getContext('2d');
    ctx.drawImage(img, 0, 0, wpx, hpx);
    return { dataUrl: c.toDataURL('image/png'), heightMM: widthMM * (img.height / img.width) };
  } catch (e) { return null; }
}

// ── vector layout primitives ──────────────────────────
function vRect(doc, x, y, w, h, rgb, style) {
  doc.setFillColor(rgb[0], rgb[1], rgb[2]);
  doc.rect(x, y, w, h, style || 'F');
}
function vRR(doc, x, y, w, h, r, rgb, style) {
  doc.setFillColor(rgb[0], rgb[1], rgb[2]);
  doc.roundedRect(x, y, w, h, r, r, style || 'F');
}
function vStrokeRR(doc, x, y, w, h, r, rgb, lw) {
  doc.setDrawColor(rgb[0], rgb[1], rgb[2]);
  doc.setLineWidth(lw);
  doc.roundedRect(x, y, w, h, r, r, 'S');
}
function vLine(doc, x1, y1, x2, y2, rgb, lw) {
  doc.setDrawColor(rgb[0], rgb[1], rgb[2]);
  doc.setLineWidth(lw);
  doc.line(x1, y1, x2, y2);
}
function vText(doc, fonts, text, x, y, opts) {
  opts = opts || {};
  setInvoiceFont(doc, fonts, opts.weight || 'normal', opts.size || 9);
  const c = opts.color || [0, 0, 0];
  doc.setTextColor(c[0], c[1], c[2]);
  const o = { align: opts.align || 'left' };
  if (opts.angle) o.angle = opts.angle;
