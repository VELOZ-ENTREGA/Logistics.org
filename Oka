@media(max-width:560px){.form-row{grid-template-columns:1fr;}}
.form-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:14px;}
@media(max-width:700px){.form-row-3{grid-template-columns:1fr 1fr;}}
@media(max-width:480px){.form-row-3{grid-template-columns:1fr;}}
.field-inline label{display:block;font-size:0.78rem;text-transform:uppercase;letter-spacing:0.1em;
  color:var(--slate);font-weight:600;margin-bottom:8px;}
.field-inline input,.field-inline select,.field-inline textarea{
  width:100%;padding:12px 14px;border-radius:8px;border:1.5px solid var(--border);
  font-size:0.92rem;background:#fff;color:var(--text);font-family:inherit;}
.field-inline textarea{resize:vertical;min-height:80px;}
.field-inline input:focus,.field-inline select:focus,.field-inline textarea:focus{
  outline:none;border-color:var(--sky-accent);box-shadow:0 0 0 3px rgba(14,165,233,0.12);}

/* ===== TRACKING PANEL (post-create) ===== */
.track-panel{margin-top:20px;border-radius:16px;overflow:hidden;border:1.5px solid var(--sky-accent);
  display:none;}
.track-panel.show{display:block;}
.track-panel-head{background:linear-gradient(120deg,var(--ink-dark),var(--ink-mid));color:#fff;padding:22px 26px;
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;}
.track-panel-head .label{font-size:0.74rem;text-transform:uppercase;letter-spacing:0.1em;color:rgba(255,255,255,0.6);margin-bottom:4px;}
.track-panel-head .id{font-family:'JetBrains Mono',monospace;font-size:1.35rem;font-weight:700;}
.track-panel-body{background:#fff;padding:22px 26px;display:flex;gap:24px;flex-wrap:wrap;align-items:center;}
.track-link-box{flex:1;min-width:260px;}
.track-link-box .lbl{font-size:0.72rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--slate);font-weight:600;margin-bottom:8px;}
.track-link-row{display:flex;gap:8px;}
.track-link-row input{flex:1;padding:11px 13px;border-radius:8px;border:1.5px solid var(--border);
  font-family:'JetBrains Mono',monospace;font-size:0.82rem;background:var(--off-white);color:var(--ink-dark);}
.track-link-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;}
.qr-box{text-align:center;flex-shrink:0;}
.qr-box img{width:104px;height:104px;border-radius:10px;border:1.5px solid var(--border);padding:6px;background:#fff;}
.qr-box .cap{font-size:0.7rem;color:var(--slate);margin-top:6px;}

.copy-btn{background:var(--ink);color:#fff;border:none;border-radius:6px;padding:8px 14px;
  font-size:0.8rem;font-weight:600;cursor:pointer;font-family:'Space Grotesk',sans-serif;}
.copy-btn:hover{background:var(--sky-accent);}
.copy-btn.alt{background:var(--sky-accent);}
.copy-btn.ghost{background:#fff;color:var(--ink);border:1.5px solid var(--border);}

.ship-list{display:flex;flex-direction:column;gap:10px;}
.ship-card{border:1px solid var(--border);border-radius:10px;padding:16px;cursor:pointer;transition:border-color .15s,background .15s;}
.ship-card:hover{border-color:var(--ink);background:var(--sky-light);}
.ship-card.active{border-color:var(--sky-accent);background:var(--sky-light);}
.ship-card .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;}
.ship-card .id{font-family:'JetBrains Mono',monospace;font-weight:600;font-size:0.92rem;color:var(--ink-dark);}
.ship-card .route{font-size:0.85rem;color:var(--slate);}
.ship-card-actions{display:flex;gap:6px;margin-top:10px;flex-wrap:wrap;}
.ship-card-actions .mini-btn{border:1.5px solid var(--border);background:#fff;color:var(--ink);
  border-radius:6px;padding:6px 10px;font-size:0.74rem;font-weight:600;cursor:pointer;
  font-family:'Space Grotesk',sans-serif;display:inline-flex;align-items:center;gap:4px;transition:all .15s;}
.ship-card-actions .mini-btn:hover{border-color:var(--sky-accent);color:var(--sky-accent);background:var(--sky-light);}
.ship-card-actions .mini-btn.mini-danger{color:var(--red);border-color:#E8C7C7;}
.ship-card-actions .mini-btn.mini-danger:hover{background:#FCEDED;border-color:var(--red);}
.ship-card-actions .mini-btn.mini-green{color:var(--green);border-color:#B7E3D3;}
.ship-card-actions .mini-btn.mini-green:hover{background:#E7F8F1;border-color:var(--green);}
.status-badge{display:inline-block;padding:4px 11px;border-radius:99px;
  font-size:0.7rem;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;white-space:nowrap;}
.status-badge.delivered{background:rgba(26,163,122,0.15);color:var(--green);}
.status-badge.transit{background:rgba(14,165,233,0.12);color:var(--sky-accent);}
.status-badge.pending{background:rgba(74,96,128,0.12);color:var(--slate);}
.status-badge.customs{background:rgba(180,140,30,0.15);color:#7a5c10;}
.empty-state{text-align:center;padding:48px 20px;color:var(--slate);}
.empty-state .icon{font-size:2.4rem;margin-bottom:12px;}
.detail-row{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid var(--sky-light);font-size:0.9rem;gap:10px;}
.detail-row:last-child{border-bottom:none;}
.detail-row .k{color:var(--slate);flex-shrink:0;}
.detail-row .v{font-weight:600;text-align:right;max-width:60%;color:var(--ink-dark);}
.actions-row{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap;}
.placeholder-note{color:var(--slate);font-size:0.9rem;text-align:center;padding:30px 0;}
.toast{position:fixed;bottom:24px;right:24px;background:var(--ink-dark);color:#fff;
  padding:14px 20px;border-radius:10px;font-size:0.88rem;font-weight:500;
  box-shadow:0 8px 24px rgba(0,0,0,0.25);z-index:9999;max-width:320px;
  transform:translateY(80px);opacity:0;transition:all 0.3s ease;pointer-events:none;}
.toast.show{transform:translateY(0);opacity:1;}
.toast.success{border-left:4px solid var(--green);}
.toast.error{border-left:4px solid var(--red);}
