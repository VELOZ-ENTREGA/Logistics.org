.pwd-section{max-width:480px;}
.pwd-status{font-size:0.85rem;margin-top:10px;font-weight:500;display:none;}
.pwd-status.ok{color:var(--green);}
.pwd-status.err{color:var(--red);}
.search-bar{width:100%;padding:11px 14px;border-radius:8px;border:1.5px solid var(--border);
