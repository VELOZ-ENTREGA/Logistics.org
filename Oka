<!-- Hero pillar date overlay, aligned to the photo's printed graphics -->
<script>
(function () {
  var container = document.getElementById('vehicleSlideshow');
  var photo     = document.getElementById('heroPhoto');
  var dateBox   = document.getElementById('heroLiveDate');
  var dayEl     = document.getElementById('hldDay');
  var monthEl   = document.getElementById('hldMonth');
  var yearEl    = document.getElementById('hldYear');
  if (!container || !photo || !dateBox) return;

  // Natural pixel coordinates of the pillar date spot, measured against the
  // source photo at its native 1086 x 1448 size.
  var NATURAL_W = 1086, NATURAL_H = 1448;
  var DATE  = { x: 918, y: 412, h: 150 };   // center x, center y, stack height

  var MONTHS = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];

  function positionOverlays() {
    var rect = container.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    // object-fit: cover math — image is scaled uniformly to fill the box,
    // then center-cropped, so we replicate that to find each point on screen.
    var scale = Math.max(rect.width / NATURAL_W, rect.height / NATURAL_H);
    var dispW = NATURAL_W * scale, dispH = NATURAL_H * scale;
    var offsetX = (rect.width - dispW) / 2;
    var offsetY = (rect.height - dispH) / 2;

    var dateX = offsetX + DATE.x * scale;
    var dateY = offsetY + DATE.y * scale;
    var dateH = DATE.h * scale;
    dateBox.style.left = dateX + 'px';
    dateBox.style.top = dateY + 'px';
    dateBox.style.fontSize = (dateH * 0.24) + 'px';
  }

  function tick() {
    var now = new Date();
    dayEl.textContent = String(now.getDate()).padStart(2, '0');
    monthEl.textContent = MONTHS[now.getMonth()];
    yearEl.textContent = now.getFullYear();
  }

  function start() {
    positionOverlays();
    tick();
    setInterval(tick, 1000);
  }

  if (photo.complete && photo.naturalWidth) {
    start();
  } else {
    photo.addEventListener('load', start, { once: true });
  }
  window.addEventListener('resize', positionOverlays);
  window.addEventListener('orientationchange', positionOverlays);
})();
</script>

