/* ── SPLASH / INTRO LOADER ───────────────────────────── */
#gd-splash {
  position: fixed; inset: 0; z-index: 9999;
  background: var(--navy);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 0;
  overflow: hidden;
  transition: opacity 0.7s ease, visibility 0.7s ease;
}
#gd-splash.hidden {
  opacity: 0; visibility: hidden; pointer-events: none;
}

/* Prevent body scroll while splash is showing */
body.splash-active { overflow: hidden; }

/* ── Animated background particles ── */
#gd-splash::before {
  content: '';
  position: absolute; inset: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(30,136,229,0.07) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(10,25,48,0.6) 0%, transparent 55%),
    radial-gradient(circle at 60% 15%, rgba(30,136,229,0.04) 0%, transparent 40%);
  pointer-events: none;
}

/* ── Globe ring spinner ── */
.splash-globe-wrap {
  position: relative;
  width: 140px; height: 140px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 36px;
}

/* Outer spinning ring */
.splash-ring-outer {
  position: absolute; inset: 0;
  border-radius: 50%;
  border: 3px solid transparent;
  border-top-color: var(--gold);
  border-right-color: rgba(30,136,229,0.3);
  animation: splashSpinCW 1.4s linear infinite;
}
/* Middle counter-spinning ring */
.splash-ring-mid {
  position: absolute; inset: 12px;
  border-radius: 50%;
  border: 2.5px solid transparent;
  border-top-color: rgba(30,136,229,0.5);
  border-left-color: var(--gold);
  animation: splashSpinCCW 2s linear infinite;
}
/* Inner pulsing ring */
.splash-ring-inner {
  position: absolute; inset: 24px;
  border-radius: 50%;
  border: 2px solid rgba(30,136,229,0.2);
  animation: splashPulseRing 2s ease-in-out infinite;
}
@keyframes splashSpinCW  { to { transform: rotate(360deg); } }
@keyframes splashSpinCCW { to { transform: rotate(-360deg); } }
@keyframes splashPulseRing {
  0%, 100% { border-color: rgba(30,136,229,0.15); transform: scale(0.95); }
  50%       { border-color: rgba(30,136,229,0.45); transform: scale(1.05); }
}

/* Globe emoji in centre */
.splash-globe-emoji {
  font-size: 3.6rem; line-height: 1;
  animation: splashGlobeSpin 6s linear infinite;
  display: inline-block;
  filter: drop-shadow(0 0 12px rgba(30,136,229,0.4));
}
@keyframes splashGlobeSpin { to { transform: rotate(360deg); } }

/* GD badge overlay on globe */
.splash-gd-badge {
  position: absolute; bottom: 6px; right: 6px;
  background: var(--gold); color: var(--navy);
  font-family: var(--font-head); font-size: 0.65rem; font-weight: 900;
  letter-spacing: 0.04em; padding: 3px 7px; border-radius: 4px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.4);
  border: 2px solid var(--white);
}

/* ── Welcome text block ── */
.splash-text {
  text-align: center;
  animation: splashTextFadeIn 0.8s ease forwards;
  opacity: 0;
  animation-delay: 0.5s;
}
@keyframes splashTextFadeIn {
  from { opacity: 0; transform: translateY(18px); }
  to   { opacity: 1; transform: translateY(0); }
}

.splash-welcome {
  font-family: var(--font-head);
  font-size: clamp(0.85rem, 2vw, 1rem);
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 10px;
  opacity: 0;
  animation: splashTextFadeIn 0.6s ease forwards;
  animation-delay: 0.7s;
}

.splash-brand {
  font-family: var(--font-head);
  font-size: clamp(2.2rem, 6vw, 3.8rem);
  font-weight: 900;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--white);
  opacity: 0;
  animation: splashTextFadeIn 0.7s ease forwards;
  animation-delay: 1s;
}
.splash-brand .brand-gold {
  color: var(--gold);
  display: inline-block;
  animation: splashGoldSheen 3s linear infinite;
  background: linear-gradient(90deg, var(--gold) 0%, var(--gold2) 30%, #EBF2FA 50%, var(--gold2) 70%, var(--gold) 100%);
  background-size: 250% auto;
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
@keyframes splashGoldSheen {
  0%   { background-position: 0% center; }
  100% { background-position: 200% center; }
}

.splash-tagline {
  font-family: var(--font-body);
  font-size: clamp(0.82rem, 1.8vw, 1rem);
  font-weight: 400;
  color: rgba(255,255,255,0.5);
  letter-spacing: 0.04em;
  margin-top: 12px;
  opacity: 0;
  animation: splashTextFadeIn 0.6s ease forwards;
  animation-delay: 1.4s;
}

/* ── Animated letter-by-letter welcome line ── */
.splash-animated-line {
  display: flex; justify-content: center; flex-wrap: wrap; gap: 3px;
  margin-top: 28px;
  opacity: 0;
  animation: splashTextFadeIn 0.4s ease forwards;
  animation-delay: 1.7s;
}
.sal-letter {
  font-family: var(--font-head);
  font-size: clamp(1rem, 2.5vw, 1.4rem);
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--white);
  display: inline-block;
  opacity: 0;
  animation: salLetterIn 0.5s ease forwards;
}
.sal-letter.gold { color: var(--gold); }
.sal-space { width: 0.4em; display: inline-block; }

/* ── Progress bar ── */
.splash-progress-wrap {
  width: 240px; height: 3px;
  background: rgba(255,255,255,0.1);
  border-radius: 3px;
  margin-top: 40px;
  overflow: hidden;
  opacity: 0;
  animation: splashTextFadeIn 0.4s ease forwards;
  animation-delay: 1.9s;
}
.splash-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--gold), var(--gold2));
  border-radius: 3px;
  width: 0%;
  animation: splashFillBar 2.4s ease forwards;
  animation-delay: 2s;
}
@keyframes splashFillBar {
  0%   { width: 0%; }
  60%  { width: 75%; }
  90%  { width: 92%; }
  100% { width: 100%; }
}

/* ── Entering label ── */
.splash-entering {
  margin-top: 14px;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.35);
  opacity: 0;
  animation: splashTextFadeIn 0.5s ease forwards;
  animation-delay: 2.1s;
}
.splash-entering span {
  color: var(--gold);
  animation: splashDots 1.4s steps(3, end) infinite;
  animation-delay: 2.5s;
}
@keyframes splashDots {
  0%   { content: '.'; }
  33%  { content: '..'; }
  66%  { content: '...'; }
  100% { content: ''; }
}

/* Floating delivery icons around the globe */
.splash-orbit {
  position: absolute; inset: 0;
  pointer-events: none;
}
.splash-orbit-icon {
  position: absolute;
  font-size: 1.3rem;
  opacity: 0;
  animation: orbitFadeIn 0.6s ease forwards, orbitFloat 3s ease-in-out infinite;
}
@keyframes orbitFadeIn { to { opacity: 0.7; } }
@keyframes orbitFloat {
  0%, 100% { transform: translateY(0px); }
  50%       { transform: translateY(-8px); }
}

/* ══════════════════════════════════════════════════════════
   VISUAL ENHANCEMENT LAYER — colour washes, glass photography,
   gallery, cinematic bands. Added on top of the original design
   system; nothing above this point was altered.
══════════════════════════════════════════════════════════ */
:root {
  --aurora-1: #1E88E5;
  --aurora-2: #4FA8FF;
  --aurora-3: #0C8599;
  --aurora-4: #0A1930;
  --glass-bg: rgba(255,255,255,0.10);
  --glass-bg-strong: rgba(255,255,255,0.16);
  --glass-border: rgba(255,255,255,0.28);
  --glass-shadow: 0 20px 60px rgba(10,25,48,0.35);
}

/* ── Hero aurora wash ───────────────────────────────── */
.hero-aurora { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
.hero-aurora::before, .hero-aurora::after {
  content: ''; position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.55;
  animation: auroraDrift 16s ease-in-out infinite;
}
.hero-aurora::before {
  width: 460px; height: 460px; top: -160px; left: -100px;
  background: radial-gradient(circle, var(--aurora-1), transparent 70%);
}
.hero-aurora::after {
  width: 380px; height: 380px; bottom: -140px; right: 6%;
  background: radial-gradient(circle, var(--aurora-3), transparent 70%);
  animation-delay: 3.5s; animation-duration: 19s;
}
.hero-aurora span { position: absolute; border-radius: 50%; filter: blur(60px); opacity: 0.4; animation: auroraDrift 14s ease-in-out infinite; }
.hero-aurora span:nth-child(1) { width: 300px; height: 300px; top: 30%; left: 38%; background: radial-gradient(circle, var(--aurora-2), transparent 70%); animation-delay: 1.5s; }
.hero-aurora span:nth-child(2) { width: 240px; height: 240px; top: 6%; right: 22%; background: radial-gradient(circle, var(--aurora-4), transparent 72%); opacity: 0.22; animation-delay: 5s; animation-duration: 21s; }
@keyframes auroraDrift {
  0%, 100% { transform: translate(0,0) scale(1); }
  50%      { transform: translate(30px,-24px) scale(1.12); }
}
.hero-grid { position: relative; z-index: 1; }

/* ── Colour-wash blobs used across several sections ─── */
#services, #cargo, #goods, #reviews {
  position: relative; overflow: hidden; isolation: isolate;
}
#services::before, #cargo::before, #goods::before, #reviews::before {
  content: ''; position: absolute; z-index: 0; pointer-events: none; filter: blur(80px);
}
#services::before {
  width: 520px; height: 520px; top: -220px; right: -160px; border-radius: 50%;
  background: radial-gradient(circle, rgba(30,136,229,0.22), transparent 70%);
}
#cargo::before {
  width: 640px; height: 420px; bottom: -200px; left: -180px; border-radius: 50%;
  background: radial-gradient(circle, rgba(12,133,153,0.16), transparent 70%);
}
#goods::before {
  width: 560px; height: 560px; top: -240px; left: 50%; transform: translateX(-50%); border-radius: 50%;
  background: radial-gradient(circle, rgba(79,168,255,0.28), transparent 70%);
}
#reviews::before {
  width: 600px; height: 600px; bottom: -260px; right: -200px; border-radius: 50%;
  background: radial-gradient(circle, rgba(214,69,69,0.10), transparent 70%);
}
#services > *, #cargo > *, #goods > *, #reviews > * { position: relative; z-index: 1; }

/* ── Glass utility ──────────────────────────────────── */
.glass-panel {
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(14px) saturate(140%);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  box-shadow: var(--glass-shadow);
}

/* ── Scroll reveal ──────────────────────────────────── */
.reveal-up { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; transition-delay: var(--d, 0s); }
.reveal-up.is-visible { opacity: 1; transform: translateY(0); }

/* ── Operations photo strip (between hero & dashboard) ─ */
.photo-strip-band {
  background: var(--dark);
  padding: 22px 0;
  overflow: hidden;
  position: relative;
  border-top: 1px solid rgba(255,255,255,0.06);
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.photo-strip-band::before {
  content: 'Live From The Floor'; position: absolute; top: 6px; left: 5%;
  font-family: var(--font-head); font-size: 0.62rem; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.28);
}
.photo-strip-track {
  display: flex; gap: 18px; width: max-content;
  animation: photoStripScroll 38s linear infinite;
  padding-top: 14px;
}
.photo-strip-band:hover .photo-strip-track { animation-play-state: paused; }
@keyframes photoStripScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
.ps-chip {
  position: relative; flex: none; width: 190px; height: 132px;
  border-radius: 10px; overflow: hidden;
  border: 1px solid rgba(255,255,255,0.14);
  box-shadow: 0 10px 30px rgba(0,0,0,0.35);
}
.ps-chip img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(1.05); transition: transform 0.6s ease; }
.ps-chip:hover img { transform: scale(1.09); }
.ps-chip span {
  position: absolute; left: 0; right: 0; bottom: 0; padding: 6px 9px 5px;
  font-size: 0.66rem; font-weight: 600; letter-spacing: 0.02em; color: #fff;
  background: linear-gradient(to top, rgba(10,25,48,0.88), transparent);
}

/* ── Cinematic banner (before Why Us) ──────────────────── */
.cinematic-banner {
  position: relative; min-height: 380px;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; padding: 60px 5%;
  background: var(--navy);
}
.cinematic-banner img {
  position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  opacity: 0.55; transform: scale(1.05);
  animation: cinematicKen 22s ease-in-out infinite alternate;
}
@keyframes cinematicKen { from { transform: scale(1.0); } to { transform: scale(1.13); } }
.cinematic-banner::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(115deg, rgba(10,25,48,0.92) 10%, rgba(10,25,48,0.55) 55%, rgba(10,25,48,0.85) 100%);
}
.cinematic-inner {
  position: relative; z-index: 1; max-width: 760px; text-align: center;
  padding: 44px 48px; border-radius: 14px;
}
.cinematic-inner .badge { margin: 0 auto 18px; }
.cinematic-inner h2 { font-family: var(--font-head); color: var(--white); font-size: clamp(1.7rem,3.2vw,2.6rem); font-weight: 800; line-height: 1.15; margin-bottom: 14px; }
.cinematic-inner h2 span { color: var(--gold); }
.cinematic-inner p { color: rgba(255,255,255,0.72); font-size: 1rem; line-height: 1.7; }

/* ── Why-visual background photo ───────────────────────── */
.why-visual { isolation: isolate; }
.why-visual-photo {
  position: absolute; inset: 0; z-index: 0;
  background-size: cover; background-position: center;
  opacity: 0.32; filter: saturate(1.1);
}
.why-visual-photo::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(160deg, rgba(10,25,48,0.92), rgba(10,25,48,0.75));
}
.why-metric { position: relative; z-index: 1; }

/* ── GLOBAL OPERATIONS GALLERY ──────────────────────────── */
.gallery-section {
  background: linear-gradient(180deg, var(--offwhite) 0%, var(--white) 100%);
  position: relative; overflow: hidden;
}
.gallery-section::before {
  content: ''; position: absolute; z-index: 0; pointer-events: none; filter: blur(90px);
  width: 700px; height: 700px; top: -280px; right: -220px; border-radius: 50%;
  background: radial-gradient(circle, rgba(30,136,229,0.18), transparent 70%);
}
.gallery-section::after {
  content: ''; position: absolute; z-index: 0; pointer-events: none; filter: blur(90px);
  width: 600px; height: 600px; bottom: -240px; left: -200px; border-radius: 50%;
  background: radial-gradient(circle, rgba(12,133,153,0.14), transparent 70%);
}
.gallery-section > * { position: relative; z-index: 1; }

.gallery-carousel {
  position: relative;
  max-width: 1180px; margin: 0 auto;
  border-radius: 20px; overflow: hidden;
  border: 1px solid rgba(255,255,255,0.5);
  box-shadow: 0 24px 60px rgba(10,25,48,0.22);
  background: #0A1930;
}
.gallery-track { position: relative; width: 100%; aspect-ratio: 16 / 10; }
.glass-photo {
  position: absolute; inset: 0;
  opacity: 0; pointer-events: none;
  transition: opacity 1.4s ease-in-out;
}
.glass-photo.is-active { opacity: 1; pointer-events: auto; z-index: 1; }
.glass-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transform: scale(1); transition: transform 6s ease-out; }
.glass-photo.is-active img { transform: scale(1.08); }
.glass-photo-cap {
  position: absolute; left: 0; right: 0; bottom: 0; padding: 26px 30px 22px;
  background: linear-gradient(to top, rgba(10,25,48,0.92) 0%, rgba(10,25,48,0.35) 65%, transparent 100%);
  color: var(--white); font-family: var(--font-head); font-weight: 700;
  font-size: 1.15rem; letter-spacing: 0.01em;
  display: flex; align-items: center; gap: 10px;
}
.glass-photo-cap::before { content: '●'; color: var(--gold); font-size: 0.6rem; }
.glass-photo-count {
  position: absolute; top: 16px; right: 18px; z-index: 2;
  background: var(--glass-bg-strong);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(8px);
  color: var(--white); font-size: 0.8rem; font-weight: 600;
  padding: 5px 12px; border-radius: 20px;
}
.gallery-arrow {
  position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
  width: 46px; height: 46px; border-radius: 50%;
  background: var(--glass-bg-strong);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(8px);
  color: var(--white); font-size: 1.2rem;
  display: grid; place-items: center; cursor: pointer;
  transition: background 0.25s ease, transform 0.25s ease;
}
.gallery-arrow:hover { background: rgba(0,0,0,0.55); transform: translateY(-50%) scale(1.08); }
.gallery-arrow.prev { left: 16px; }
.gallery-arrow.next { right: 16px; }
.gallery-dots {
  display: flex; justify-content: center; flex-wrap: wrap; gap: 8px;
  padding: 18px 0 0;
}
.gallery-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: rgba(10,25,48,0.18); border: none; cursor: pointer;
  padding: 0; transition: background 0.25s ease, transform 0.25s ease;
}
.gallery-dot.is-active { background: var(--gold); transform: scale(1.25); }

@media (max-width: 640px) {
  .gallery-track { aspect-ratio: 4 / 3.4; }
  .glass-photo-cap { font-size: 0.92rem; padding: 16px 16px 14px; }
  .gallery-arrow { width: 38px; height: 38px; font-size: 1rem; }
  .cinematic-banner { min-height: 300px; padding: 44px 6%; }
  .cinematic-inner { padding: 28px 22px; }
  .ps-chip { width: 150px; height: 104px; }
}

/* ══════════════════════════════════════════════════════════
   HAUTE MAISON POLISH LAYER — elevated, editorial luxury touches
   applied globally on top of the existing design system.
   ══════════════════════════════════════════════════════════ */

/* Gold hairline flourish under every section title */
.section-head h2 { position: relative; padding-bottom: 20px; letter-spacing: -0.01em; }
.section-head h2::after {
  content: ''; position: absolute; left: 50%; bottom: 0;
  transform: translateX(-50%);
  width: 64px; height: 2px;
  background: linear-gradient(90deg, transparent, var(--gold) 20%, var(--gold2) 50%, var(--gold) 80%, transparent);
}
#cargo.section .section-head h2::after,
.dash-section .section-head h2::after { background: linear-gradient(90deg, transparent, var(--gold2) 20%, var(--gold) 50%, var(--gold2) 80%, transparent); }

/* Shimmering badge — a slow gold sweep across every kicker label */
.badge {
  position: relative; overflow: hidden;
  box-shadow: inset 0 0 0 1px rgba(30,136,229,0.06);
}
.badge::after {
  content: ''; position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(115deg, transparent 30%, rgba(30,136,229,0.35) 46%, rgba(255,255,255,0.5) 50%, rgba(30,136,229,0.35) 54%, transparent 70%);
  background-size: 220% 100%;
  animation: badgeShimmer 5.5s ease-in-out infinite;
}
@keyframes badgeShimmer {
  0% { background-position: 160% 0; }
  55%, 100% { background-position: -60% 0; }
}

/* Primary CTA buttons: deeper gold gradient + soft glow on hover, more couture than corporate */
.btn-contact {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
  box-shadow: 0 6px 18px rgba(10,25,48,0.28);
}
.btn-contact:hover {
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold2) 100%);
  box-shadow: 0 10px 28px rgba(30,136,229,0.4);
}

/* Cards get a touch more air, a hairline gold edge, and a heavier resting shadow —
   reads closer to a product vitrine than a SaaS dashboard card. */
.service-card, .goods-card, .contact-form-card {
  box-shadow: 0 10px 30px rgba(10,25,48,0.08), 0 1px 0 rgba(30,136,229,0.12);
}
.contact-form-card { border: 1px solid rgba(30,136,229,0.18); }

/* Section-head kicker + heading rhythm — slightly more generous, editorial */
.section-head { margin-bottom: 64px; }
.section-head .badge { letter-spacing: 0.14em; }

/* Subtle vignette across the whole page for depth, never intrusive */
body::before {
  content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
  background: radial-gradient(140% 100% at 50% 0%, transparent 60%, rgba(10,25,48,0.05) 100%);
}

/* ══════════════════════════════════════════════════════════
   DARK MODE TOGGLE — circular button + sitewide theme flip
   ══════════════════════════════════════════════════════════ */
.theme-toggle-btn {
  position: relative; flex-shrink: 0;
  width: 30px; height: 30px; border-radius: 50%;
  display: grid; place-items: center;
  background: linear-gradient(145deg, var(--navy) 0%, var(--navy2) 100%);
  border: 1.5px solid var(--gold);
  color: var(--gold2);
  cursor: pointer;
  box-shadow: 0 3px 10px rgba(10,25,48,0.25), inset 0 0 0 1px rgba(30,136,229,0.15);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  margin-left: 2px;
  align-self: center;
  transform: translateY(8px);
}
.theme-toggle-btn:hover { transform: translateY(8px) scale(1.08); box-shadow: 0 4px 14px rgba(30,136,229,0.35), inset 0 0 0 1px rgba(30,136,229,0.25); }
.theme-toggle-btn:active { transform: translateY(8px) scale(0.94); }
.ttb-icon {
  position: absolute; inset: 0; display: grid; place-items: center;
  transition: opacity 0.3s ease, transform 0.4s ease;
}
.ttb-icon svg { width: 13px; height: 13px; }
.ttb-sun { opacity: 1; transform: rotate(0deg) scale(1); }
.ttb-moon { opacity: 0; transform: rotate(-70deg) scale(0.6); }
.ttb-eye { opacity: 0; transform: rotate(-70deg) scale(0.6); }
html.dark-mode .ttb-sun { opacity: 0; transform: rotate(70deg) scale(0.6); }
html.dark-mode .ttb-moon { opacity: 1; transform: rotate(0deg) scale(1); }
html.eyecare-mode .ttb-sun { opacity: 0; transform: rotate(70deg) scale(0.6); }
html.eyecare-mode .ttb-eye { opacity: 1; transform: rotate(0deg) scale(1); }

/* The flip itself: inverting lightness + rotating hue back gives a coherent
   dark theme across every existing color in one move, without needing to
   redeclare colors on thousands of individual rules. Real photography and
   inline brand art are counter-inverted so they still read naturally. */
html.dark-mode {
  background: #0A1930;
}
html.dark-mode body {
  filter: invert(1) hue-rotate(180deg);
  background: #fff;
}
html.dark-mode img,
html.dark-mode video,
html.dark-mode picture,
html.dark-mode iframe,
html.dark-mode .logo-badge,
html.dark-mode .ps-chip img,
html.dark-mode .glass-photo img,
html.dark-mode .goods-photo,
html.dark-mode .service-media img {
  filter: invert(1) hue-rotate(180deg);
}
html.dark-mode .theme-toggle-btn { filter: invert(1) hue-rotate(180deg); }

/* ── EYE CARE MODE ──────────────────────────────────────────
   Warms the whole page (lower blue light, softer contrast) with
   a single filter pass — a warm parchment backdrop and muted,
   paper-like colors that are easier on the eyes for long reading. */
html.eyecare-mode {
  background: #F1E6D3;
}
html.eyecare-mode body {
  filter: sepia(0.35) saturate(0.82) brightness(0.98) contrast(0.94) hue-rotate(-6deg);
}
body { transition: filter 0.4s ease; }



/* ===== TRACKING PAGE STYLES ===== */

:root {
  --navy:    #0B1420;
  --navy2:   #16283F;
  --gold:    #C08A3E;
  --gold2:   #E3B569;
  --silver:  #B9AD86;
  --silver2: #F3ECDC;
  --dark-yellow: #96702E;
  --white:   #FFFFFF;
  --offwhite:#F5F1E6;
  --grey:    #E7E1D2;
  --mid:     #5C5850;
  --dark:    #17140F;
  --green:   #1F6E8C;
  --red:     #A33B2E;

  --font-head: 'Fraunces', serif;
  --font-body: 'Inter', sans-serif;
  --shadow: 0 4px 24px rgba(23,20,15,0.18);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { -webkit-text-size-adjust: 100%; }
body {
  font-family: var(--font-body); background: var(--offwhite); color: var(--dark);
  font-size: 16px; line-height: 1.6; letter-spacing: 0.01em; min-height: 100vh;
}
a { text-decoration: none; color: inherit; }

/* ── MINIMAL TOP BAR ─────────────────────────────────── */
.tr-topbar {
  background: var(--navy); color: var(--offwhite);
  padding: 16px 5%; display: flex; align-items: center; justify-content: space-between;
  gap: 16px; flex-wrap: wrap;
}
.tr-topbar-left { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
.tr-home-btn {
  display: inline-flex; align-items: center; gap: 7px;
  background: var(--gold); color: var(--navy);
  font-weight: 700; font-size: 0.82rem; letter-spacing: 0.02em;
  padding: 9px 18px; border-radius: 4px; white-space: nowrap;
  transition: background 0.2s, transform 0.2s;
}
.tr-home-btn:hover { background: var(--gold2); transform: translateY(-1px); }
.tr-home-btn svg { flex-shrink: 0; }
.tr-logo { display: flex; align-items: center; gap: 10px; font-family: var(--font-head); }
.tr-logo svg { flex-shrink: 0; }
.tr-logo-text { font-weight: 800; font-size: 1rem; letter-spacing: 0.02em; }
.tr-logo-text span { color: var(--gold2); font-style: italic; }
.tr-back {
  font-size: 0.82rem; font-weight: 600; color: var(--gold2);
  display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
}
.tr-back:hover { color: var(--gold); }

/* ── LIVE CHAT US BUTTON + DROPDOWN ─────────────────── */
.tr-livechat { position: relative; }
.tr-livechat-btn {
  display: inline-flex; align-items: center; gap: 7px;
  background: transparent; color: var(--offwhite);
  border: 1.5px solid rgba(243,236,220,0.35);
  font-weight: 700; font-size: 0.82rem; letter-spacing: 0.02em;
  padding: 9px 18px; border-radius: 4px; white-space: nowrap;
  cursor: pointer; font-family: var(--font-body);
  transition: background 0.2s, border-color 0.2s, transform 0.2s;
}
.tr-livechat-btn:hover { background: rgba(243,236,220,0.08); border-color: var(--gold2); transform: translateY(-1px); }
.tr-livechat-btn svg { flex-shrink: 0; transition: transform 0.2s; }
.tr-livechat.open .tr-livechat-btn svg.chevron { transform: rotate(180deg); }
.tr-livechat-btn .dot {
  width: 7px; height: 7px; border-radius: 50%; background: #3BC763; flex-shrink: 0;
  box-shadow: 0 0 0 3px rgba(59,199,99,0.2);
}

.tr-livechat-panel {
  position: absolute; top: calc(100% + 10px); left: 0;
  background: var(--white); border-radius: 8px; box-shadow: var(--shadow);
  width: 250px; padding: 10px; z-index: 50;
  opacity: 0; visibility: hidden; transform: translateY(-8px);
  transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
}
.tr-livechat.open .tr-livechat-panel { opacity: 1; visibility: visible; transform: translateY(0); }
.tr-livechat-panel::before {
  content: ''; position: absolute; top: -6px; left: 22px;
  width: 12px; height: 12px; background: var(--white);
  transform: rotate(45deg); border-radius: 2px;
}
.tr-livechat-label {
  font-size: 0.68rem; font-weight: 700; color: var(--mid);
  text-transform: uppercase; letter-spacing: 0.07em;
  padding: 6px 10px 8px;
}
.tr-livechat-option {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 10px; border-radius: 6px;
  font-size: 0.88rem; font-weight: 600; color: var(--dark);
  transition: background 0.15s;
}
.tr-livechat-option:hover { background: var(--offwhite); }
.tr-livechat-option .lc-icon {
  width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.tr-livechat-option .lc-icon.line { background: #06C755; }
.tr-livechat-option .lc-text { display: flex; flex-direction: column; line-height: 1.25; }
.tr-livechat-option .lc-sub { font-size: 0.72rem; font-weight: 500; color: var(--mid); }

@media (max-width: 640px) {
  .tr-livechat-panel { left: auto; right: 0; }
  .tr-livechat-panel::before { left: auto; right: 22px; }
}

/* ── PAGE WRAP ───────────────────────────────────────── */
.tr-wrap { padding: 44px 5% 70px; max-width: 940px; margin: 0 auto; }

/* ── LOADING / NOT-FOUND STATES ─────────────────────── */
.tr-state {
  max-width: 860px; margin: 60px auto; text-align: center;
  background: var(--white); border-radius: 6px; padding: 60px 40px;
  box-shadow: var(--shadow);
}
.tr-state.hidden { display: none; }
.tr-spinner {
  width: 40px; height: 40px; border-radius: 50%; margin: 0 auto 22px;
  border: 3px solid var(--grey); border-top-color: var(--gold);
  animation: trSpin 0.8s linear infinite;
}
@keyframes trSpin { to { transform: rotate(360deg); } }
.tr-state h2 {
  font-family: var(--font-head); font-weight: 700; font-size: 1.3rem; color: var(--navy); margin-bottom: 10px;
}
.tr-state p { color: var(--mid); font-size: 0.95rem; margin-bottom: 22px; }
.tr-state .tr-home-link {
  display: inline-block; background: var(--navy); color: var(--gold2);
  font-weight: 700; font-size: 0.85rem; padding: 12px 26px; border-radius: 4px;
  letter-spacing: 0.03em;
}
.tr-state .tr-home-link:hover { background: var(--navy2); }

/* ── RESULT CARD (ported from the main site) ────────── */
.result-card {
  background: var(--white);
  border-radius: 6px; padding: 40px;
  box-shadow: var(--shadow);
  max-width: 860px; margin: 0 auto;
  border-left: 5px solid var(--green);
}
.result-card.hidden { display: none; }
.result-header {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 32px; flex-wrap: wrap; gap: 16px;
}
.result-id {
  font-family: var(--font-head); font-size: 1.5rem; font-weight: 800;
  color: var(--navy); letter-spacing: 0.02em;
}
.result-id span { color: var(--gold); }
.status-pill {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 7px 16px; border-radius: 30px;
  font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
}
.status-pill.transit { background: rgba(31,110,140,0.1); color: var(--green); border: 1.5px solid rgba(31,110,140,0.3); }
.status-pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--green); animation: pulse 1.5s infinite; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }

.result-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 32px; }
.result-item label {
  display: block; font-size: 0.72rem; font-weight: 600;
  color: var(--mid); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 5px;
}
.result-item strong { font-size: 0.95rem; color: var(--dark); font-weight: 600; }

.timeline { border-top: 1.5px solid var(--grey); padding-top: 28px; }
.timeline h4 {
  font-family: var(--font-head); font-size: 1rem; font-weight: 700;
  color: var(--navy); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 20px;
}

/* ── LIVE ROUTE MAP ──────────────────────────────────── */
.route-map-section { position: relative; padding: 0 0 20px; margin-bottom: 8px; }
.route-map-head {
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: 10px; margin-bottom: 14px;
}
.route-map-head h4 {
  font-family: var(--font-head); font-size: 1rem; font-weight: 700;
  color: var(--navy); letter-spacing: 0.04em; text-transform: uppercase; margin: 0;
}
.route-map-pct {
  font-size: 0.72rem; font-weight: 700; color: var(--navy);
  background: var(--offwhite); border: 1.5px solid var(--grey);
  padding: 4px 12px; border-radius: 20px; white-space: nowrap;
}
.route-map-frame {
  width: 100%; height: 380px; border-radius: 10px; overflow: hidden;
  border: 1.5px solid var(--grey); background: var(--offwhite);
  position: relative; box-shadow: var(--shadow);
}
.route-map-frame .leaflet-container { width: 100%; height: 100%; background: var(--offwhite); font-family: var(--font-body); }
.route-map-loading {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  color: var(--mid); font-size: 0.85rem; font-weight: 600; background: var(--offwhite); z-index: 5;
}
.rmp-pin {
  width: 30px; height: 30px; border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg); display: flex; align-items: center; justify-content: center;
  box-shadow: 0 3px 8px rgba(0,0,0,0.35); border: 2px solid var(--white); overflow: hidden;
}
.rmp-pin.origin { background: var(--navy); }
.rmp-pin.destination { background: var(--gold); }
.rmp-pin span { transform: rotate(45deg); font-size: 0.95rem; }
.rmp-pin img { transform: rotate(45deg); }

.rmp-current-wrap { position: relative; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; }
.rmp-current-ring {
  position: absolute; width: 30px; height: 30px; border-radius: 50%;
  border: 2.5px solid var(--green); animation: rmpPulse 1.7s ease-out infinite;
}
@keyframes rmpPulse {
  0% { transform: scale(0.45); opacity: 0.9; }
  100% { transform: scale(1.7); opacity: 0; }
}
.rmp-current {
  position: relative; width: 26px; height: 26px; border-radius: 50%;
  background: var(--green); border: 2.5px solid var(--white);
  box-shadow: 0 2px 8px rgba(0,0,0,0.4);
  display: flex; align-items: center; justify-content: center; font-size: 0.9rem;
}
.route-map-labels {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-top: 14px; font-size: 0.76rem; color: var(--mid); font-weight: 600; flex-wrap: wrap; gap: 12px;
}
.route-map-labels strong { color: var(--dark); font-weight: 700; }
.route-map-labels .rml-col { display: flex; align-items: flex-start; gap: 7px; min-width: 0; }
.route-map-labels .rml-flag { display: inline-flex; flex-shrink: 0; margin-top: 2px; line-height: 0; }
.route-map-labels .rml-flag img { display: block; }
.route-map-labels .rml-current { text-align: center; flex-direction: column; align-items: center; gap: 3px; }
.route-map-labels .rml-current .rml-dot {
  width: 8px; height: 8px; border-radius: 50%; background: var(--green);
  box-shadow: 0 0 0 3px rgba(31,110,140,0.18); flex-shrink: 0;
}
.route-map-labels .rml-dest { text-align: right; flex-direction: row-reverse; }

.timeline-steps { display: flex; flex-direction: column; gap: 0; }
.tl-step {
  display: flex; gap: 16px; position: relative;
  padding-bottom: 20px;
  opacity: 0; animation: tlIn 0.5s ease forwards;
}
.tl-step:last-child { padding-bottom: 0; }
.tl-left { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.tl-dot {
  width: 15px; height: 15px; border-radius: 50%; flex-shrink: 0;
  border: 2px solid var(--grey); background: var(--white);
  position: relative; z-index: 1;
}
.tl-dot.done { background: var(--green); border-color: var(--green); }
.tl-dot.done::after {
  content: '✓'; position: absolute; inset: 0; display: flex;
  align-items: center; justify-content: center;
  color: #fff; font-size: 9px; font-weight: 800; line-height: 1;
}
.tl-dot.active { background: var(--gold); border-color: var(--gold); box-shadow: 0 0 0 3px rgba(192,138,62,0.2); }
.tl-dot.active::after {
  content: ''; position: absolute; inset: -6px; border-radius: 50%;
  border: 2px solid var(--gold); animation: tlPulse 1.6s infinite;
}
.tl-line { width: 2px; flex: 1; background: var(--grey); min-height: 24px; position: relative; overflow: hidden; }
.tl-line-fill { position: absolute; top: 0; left: 0; width: 100%; height: 0%; background: var(--green); transition: height 0.7s ease 0.15s; }
.tl-line.done .tl-line-fill { height: 100%; }
.tl-step:last-child .tl-line { display: none; }
.tl-content { padding-top: 0; }
.tl-content strong { font-size: 0.88rem; font-weight: 600; color: var(--dark); display: block; line-height: 1.3; }
.tl-content span { font-size: 0.78rem; color: var(--mid); }
.tl-content .tl-location {
  display: block; font-size: 0.8rem; font-weight: 600; color: var(--navy);
  margin-top: 3px; line-height: 1.4;
}
.tl-content .tl-time {
  display: block; font-size: 0.74rem; color: var(--mid); margin-top: 2px;
}
@keyframes tlIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }
@keyframes tlPulse { 0% { transform: scale(0.6); opacity: 0.85; } 100% { transform: scale(1.7); opacity: 0; } }

/* ── SETTLEMENT ──────────────────────────────────────── */
.settlement { border-top: 1.5px solid var(--grey); margin-top: 32px; padding-top: 28px; }
.settlement h4 {
  font-family: var(--font-head); font-size: 1rem; font-weight: 700;
  color: var(--navy); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 20px;
}
.settlement-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 24px; align-items: stretch; }
@media (max-width: 700px) { .settlement-grid { grid-template-columns: 1fr; } }

.amount-card {
  background: var(--offwhite); border: 1.5px solid var(--grey); border-radius: 6px;
  padding: 22px 24px;
}
.amount-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; font-size: 0.9rem; }
.amount-row + .amount-row { border-top: 1px dashed var(--grey); }
.amount-row label { color: var(--mid); font-weight: 600; }
.amount-row strong { color: var(--dark); font-weight: 700; }
.amount-row.due strong { color: var(--red); font-size: 1.1rem; }
.amount-row.paid strong { color: var(--green); }
.amount-status-pill {
  display: inline-block; padding: 3px 12px; border-radius: 30px;
  font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
}
.amount-status-pill.unpaid { background: rgba(163,59,46,0.1); color: var(--red); border: 1.5px solid rgba(163,59,46,0.3); }
.amount-status-pill.partial { background: rgba(192,138,62,0.12); color: var(--navy2); border: 1.5px solid rgba(192,138,62,0.35); }
.amount-status-pill.paid { background: rgba(31,110,140,0.1); color: var(--green); border: 1.5px solid rgba(31,110,140,0.3); }
.amount-note {
  margin-top: 14px; padding-top: 14px; border-top: 1.5px solid var(--grey);
}
.amount-note label {
  display: block; font-size: 0.72rem; font-weight: 700; color: var(--mid);
  text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;
}
.amount-note p {
  font-size: 0.86rem; color: var(--dark); line-height: 1.5;
  min-height: 2.4em;
}
.amount-note p.empty { color: var(--mid); font-style: italic; }

.sign-stamp-card {
  display: flex; flex-direction: column; justify-content: flex-start;
  gap: 18px; padding: 22px 20px; border: 1.5px solid var(--grey); border-radius: 6px;
}
.receiver-name-block { text-align: center; padding-bottom: 16px; border-bottom: 1.5px dashed var(--grey); }
.receiver-name-block label {
  display: block; font-size: 0.68rem; font-weight: 700; color: var(--mid);
  text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px;
}
.receiver-name {
  font-family: var(--font-head); font-weight: 800; font-size: 1.15rem;
  color: var(--navy); text-transform: uppercase; letter-spacing: 0.04em;
}
.agent-sign { text-align: center; padding-bottom: 16px; border-bottom: 1.5px dashed var(--grey); }
.agent-sign .sig-name {
  font-family: 'Brush Script MT', cursive; font-size: 1.7rem; color: var(--navy);
  line-height: 1.1;
}
.agent-sign .sig-rule { border-top: 1.5px solid var(--mid); margin: 6px auto 0; width: 80%; }
.agent-sign .sig-label {
  font-size: 0.68rem; color: var(--mid); text-transform: uppercase;
  letter-spacing: 0.08em; margin-top: 6px; font-weight: 600;
}

.goods-stamp-wrap { display: flex; justify-content: center; }
.goods-stamp {
  width: 108px; height: 108px; border-radius: 50%;
  border: 3px solid var(--green); color: var(--green);
  display: flex; align-items: center; justify-content: center;
  transform: rotate(-12deg); opacity: 0.9;
  position: relative;
}
.goods-stamp::before {
  content: ''; position: absolute; inset: 6px; border-radius: 50%;
  border: 1.5px solid var(--green);
}
.goods-stamp-text {
  font-family: var(--font-head); font-weight: 800; font-size: 0.88rem;
  letter-spacing: 0.03em; text-align: center; line-height: 1.25;
