// ═══════════════════════════════════════════════════
// INVOICE PDF — vector text/graphics + embedded fonts.
// Only stamps, the logo badge, and the QR code are raster
// (rendered at 300 DPI, PNG, no re-compression).
// ═══════════════════════════════════════════════════

function arrayBufferToBase64(buffer) {
  let binary = '';
  const bytes = new Uint8Array(buffer);
  const chunk = 0x8000;
  for (let i = 0; i < bytes.length; i += chunk) {
    binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
  }
  return btoa(binary);
}

let _fontCache = null;
async function loadInvoiceFonts(doc) {
  if (_fontCache) return _fontCache;
  const want = [
    { url: 'https://cdn.jsdelivr.net/gh/google/fonts@main/ofl/inter/static/Inter-Regular.ttf', file: 'Inter-Regular.ttf', name: 'InterEmbed', style: 'normal' },
    { url: 'https://cdn.jsdelivr.net/gh/google/fonts@main/ofl/inter/static/Inter-Bold.ttf', file: 'Inter-Bold.ttf', name: 'InterEmbed', style: 'bold' },
    { url: 'https://cdn.jsdelivr.net/gh/google/fonts@main/ofl/inter/static/Inter-Italic.ttf', file: 'Inter-Italic.ttf', name: 'InterEmbed', style: 'italic' },
    { url: 'https://cdn.jsdelivr.net/gh/google/fonts@main/ofl/inter/static/Inter-BoldItalic.ttf', file: 'Inter-BoldItalic.ttf', name: 'InterEmbed', style: 'bolditalic' },
    { url: 'https://cdn.jsdelivr.net/gh/google/fonts@main/ofl/caveat/static/Caveat-Bold.ttf', file: 'Caveat-Bold.ttf', name: 'CaveatEmbed', style: 'bold' },
  ];
  const have = { normal: false, bold: false, italic: false, bolditalic: false, sig: false };
  await Promise.all(want.map(async f => {
    try {
      const res = await fetch(f.url);
      if (!res.ok) throw new Error('font fetch failed');
      const buf = await res.arrayBuffer();
      const b64 = arrayBufferToBase64(buf);
      doc.addFileToVFS(f.file, b64);
      doc.addFont(f.file, f.name, f.style);
      if (f.name === 'CaveatEmbed') have.sig = true;
      else have[f.style] = true;
    } catch (e) { /* fall back silently below */ }
  }));
  _fontCache = have;
  return have;
}

function setInvoiceFont(doc, fonts, weight, sizePt) {
  // weight: 'normal' | 'bold' | 'italic' | 'bolditalic'
  if (weight === 'bolditalic' && fonts.bolditalic) doc.setFont('InterEmbed', 'bolditalic');
  else if (weight === 'bold' && fonts.bold) doc.setFont('InterEmbed', 'bold');
  else if (weight === 'italic' && fonts.italic) doc.setFont('InterEmbed', 'italic');
  else if (fonts.normal) doc.setFont('InterEmbed', 'normal');
  else doc.setFont('helvetica', weight === 'italic' || weight === 'bolditalic' ? 'italic' : (weight === 'bold' ? 'bold' : 'normal'));
  doc.setFontSize(sizePt);
}

// Finds the largest font size (down to a floor) that keeps `text` within maxWidthMM.
function fitFontSize(doc, fonts, text, weight, maxWidthMM, maxSize, minSize) {
  let size = maxSize;
  minSize = minSize || 20;
  setInvoiceFont(doc, fonts, weight, size);
  while (size > minSize && doc.getTextWidth(text) > maxWidthMM) {
    size -= 2;
    setInvoiceFont(doc, fonts, weight, size);
  }
  return size;
}

function setSigFont(doc, fonts, sizePt) {
  if (fonts.sig) doc.setFont('CaveatEmbed', 'bold');
  else doc.setFont('times', 'italic');
  doc.setFontSize(sizePt);
}

// ── 300 DPI raster helpers (stamps + logo badge) ──────
function drawStarCanvas(ctx, cx, cy, r, color) {
  ctx.save();
  ctx.translate(cx, cy);
  ctx.beginPath();
  for (let i = 0; i < 10; i++) {
    const ang = (Math.PI / 5) * i - Math.PI / 2;
    const rad = i % 2 === 0 ? r : r * 0.42;
    const x = Math.cos(ang) * rad, y2 = Math.sin(ang) * rad;
    if (i === 0) ctx.moveTo(x, y2); else ctx.lineTo(x, y2);
  }
  ctx.closePath();
  ctx.fillStyle = color;
  ctx.fill();
  ctx.restore();
}

function renderStampPNG(sizeMM, mainText, subText, serial, color, angleDeg) {
  const DPI = 300, PXMM = DPI / 25.4;
  const pad = 1.08;
  const canvasPx = Math.round(sizeMM * 2 * pad * PXMM);
  const c = document.createElement('canvas');
  c.width = canvasPx; c.height = canvasPx;
  const ctx = c.getContext('2d');
  const r = (sizeMM * PXMM);
  const cx = canvasPx / 2, cy = canvasPx / 2;
  ctx.save();
  ctx.translate(cx, cy);
  ctx.rotate((angleDeg || 0) * Math.PI / 180);
  ctx.globalAlpha = 0.82;
  ctx.strokeStyle = color; ctx.fillStyle = color;
  ctx.lineWidth = r * 0.05;
  ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.stroke();
  ctx.lineWidth = r * 0.026;
  ctx.beginPath(); ctx.arc(0, 0, r * 0.83, 0, Math.PI * 2); ctx.stroke();
  drawStarCanvas(ctx, 0, -r * 0.46, r * 0.13, color);
  ctx.textAlign = 'center';
  ctx.font = `bold ${r * 0.165}px Helvetica, Arial, sans-serif`;
  const words = mainText.split(' ');
  if (words.length > 1 && mainText.length > 10) {
    const mid = Math.ceil(words.length / 2);
    ctx.fillText(words.slice(0, mid).join(' '), 0, -r * 0.02);
    ctx.fillText(words.slice(mid).join(' '), 0, r * 0.17);
  } else {
    ctx.fillText(mainText, 0, r * 0.06);
  }
  ctx.font = `${r * 0.1}px Helvetica, Arial, sans-serif`;
  ctx.fillText(subText, 0, r * 0.42);
  ctx.globalAlpha = 0.6;
  ctx.font = `${r * 0.085}px Helvetica, Arial, sans-serif`;
  ctx.fillText(serial, 0, r * 0.6);
  ctx.restore();
  return { dataUrl: c.toDataURL('image/png'), sizeMM: sizeMM * 2 * pad };
}

function renderLogoBadgePNG(sizeMM) {
  const DPI = 300, PXMM = DPI / 25.4;
  const px = Math.round(sizeMM * PXMM);
  const c = document.createElement('canvas');
  c.width = px; c.height = px;
  const ctx = c.getContext('2d');
  const r = px * 0.18;
  ctx.fillStyle = 'rgb(10,31,68)';
  ctx.beginPath();
  ctx.moveTo(r, 0); ctx.arcTo(px, 0, px, px, r); ctx.arcTo(px, px, 0, px, r);
  ctx.arcTo(0, px, 0, 0, r); ctx.arcTo(0, 0, px, 0, r);
  ctx.closePath(); ctx.fill();
  ctx.fillStyle = '#D4AF37';
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.font = `bold ${px * 0.34}px Helvetica, Arial, sans-serif`;
  ctx.fillText('VE', px / 2, px * 0.53);
  return c.toDataURL('image/png');
}

function renderQrPNG(img, sizeMM) {
  const DPI = 300, PXMM = DPI / 25.4;
  const px = Math.round(sizeMM * PXMM);
  const c = document.createElement('canvas');
  c.width = px; c.height = px;
  const ctx = c.getContext('2d');
  ctx.imageSmoothingEnabled = false;
  ctx.drawImage(img, 0, 0, px, px);
  return c.toDataURL('image/png');
}

