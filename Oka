  ];

  var btn      = document.getElementById('langWidgetBtn');
  var widget   = document.getElementById('langWidget');
  var dropdown = document.getElementById('langWidgetList');
  var flagEl   = document.getElementById('langWidgetFlag');
  var nameEl   = document.getElementById('langWidgetName');

  // Short abbreviation shown on the button itself, e.g. "ZH-CN" -> "ZH"
  function abbr(code) { return code.split('-')[0].toUpperCase(); }

  function setSelectedLabel(code, name, flag) {
    flagEl.textContent = flag;
    nameEl.textContent = abbr(code);
    dropdown.querySelectorAll('.lang-option').forEach(function (el) {
      el.classList.toggle('is-active', el.getAttribute('data-code') === code);
    });
  }

  LANGUAGES.forEach(function (lang) {
    var code = lang[0], name = lang[1], flag = lang[2];
    var opt = document.createElement('button');
    opt.type = 'button';
    opt.className = 'lang-option';
    opt.setAttribute('role', 'option');
    opt.setAttribute('data-code', code);
    if (code === 'en') opt.classList.add('is-active');
    opt.innerHTML = '<span class="lo-flag">' + flag + '</span><span>' + name + '</span>';
    opt.addEventListener('click', function () {
      widget.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
      setSelectedLabel(code, name, flag);
      localStorage.setItem('veloz_lang_choice_made', '1');
      setLanguage(code);
    });
    dropdown.appendChild(opt);
  });

  btn.addEventListener('click', function (e) {
    e.stopPropagation();
    var isOpen = widget.classList.toggle('open');
    btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
  document.addEventListener('click', function (e) {
    if (!widget.contains(e.target)) {
      widget.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    }
  });

  // Persist the choice for a full year so returning visitors keep their language
  function rememberLanguage(code) {
    if (code === 'en') {
      document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=' + location.hostname;
    } else {
      document.cookie = 'googtrans=/en/' + code + '; path=/; max-age=31536000';
      document.cookie = 'googtrans=/en/' + code + '; path=/; max-age=31536000; domain=' + location.hostname;
    }
  }

  // Apply instantly if the widget is ready; otherwise poll briefly, then fall back to a reload
  function applyLanguage(code, attemptsLeft) {
    var select = document.querySelector('.goog-te-combo');
    if (select) {
      rememberLanguage(code);
      select.value = code;
      select.dispatchEvent(new Event('change'));
      return;
    }
    if (attemptsLeft > 0) {
      setTimeout(function () { applyLanguage(code, attemptsLeft - 1); }, 250);
    } else {
      rememberLanguage(code);
      window.location.reload();
    }
  }

  function setLanguage(code) { applyLanguage(code, 20); }

  // Restore a previously chosen language label on load, if any
  var match = document.cookie.match(/googtrans=\/en\/([a-zA-Z-]+)/);
  if (match) {
    var found = LANGUAGES.find(function (l) { return l[0] === match[1]; });
    if (found) setSelectedLabel(found[0], found[1], found[2]);
  } else if (!localStorage.getItem('veloz_lang_choice_made')) {
    // First-time visitor with no saved preference: translate immediately
    // to their browser/device language, if we support it and it isn't English.
    var browserLang = (navigator.language || navigator.userLanguage || 'en').toLowerCase();
    var baseLang = browserLang.split('-')[0];
    var detected = LANGUAGES.find(function (l) { return l[0].toLowerCase() === browserLang; })
                || LANGUAGES.find(function (l) { return l[0].toLowerCase().split('-')[0] === baseLang; });
    if (detected && detected[0] !== 'en') {
      setSelectedLabel(detected[0], detected[1], detected[2]);
      setLanguage(detected[0]);
    }
  }
});
</script>

